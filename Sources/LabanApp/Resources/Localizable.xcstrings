    "Existing tabs stay on the current session backend until Laban restarts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有标签页将保持当前会话后端，直到 Laban 重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現有標籤頁將保持目前工作階段後端，直到 Laban 重新啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Laban を再起動するまで、既存のタブは現在のセッションバックエンドのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Laban을 다시 시작할 때까지 기존 탭은 현재 세션 백엔드를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets existants restent sur le backend de session actuel jusqu’au redémarrage de Laban."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas existentes permanecen en el backend de sesión actual hasta reiniciar Laban."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laban पुनः प्रारंभ होने तक मौजूदा टैब वर्तमान सत्र बैकएंड पर रहेंगे।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующие вкладки остаются на текущем бэкенде сеансов до перезапуска Laban."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestehende Tabs bleiben beim aktuellen Sitzungs-Backend, bis Laban neu startet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As abas existentes permanecem no backend de sessão atual até o Laban reiniciar."
