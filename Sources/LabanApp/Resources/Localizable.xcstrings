    "Focus Status access was authorized, but macOS did not provide a result for this build.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权专注模式状态访问，但 macOS 未为此构建提供结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已授權專注模式狀態存取，但 macOS 未為此版本提供結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中モード状況へのアクセスは許可されていましたが、macOS はこのビルドの結果を返しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 모드 상태 접근은 승인되었지만 macOS가 이 빌드에 대한 결과를 제공하지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’état de Concentration était autorisé, mais macOS n’a fourni aucun résultat pour cette version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al estado de Concentración estaba autorizado, pero macOS no proporcionó un resultado para esta compilación."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोकस स्थिति की पहुँच अधिकृत थी, लेकिन macOS ने इस बिल्ड के लिए परिणाम नहीं दिया।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к статусу фокусирования был разрешён, но macOS не предоставила результат для этой сборки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf den Fokusstatus war autorisiert, aber macOS lieferte für diesen Build kein Ergebnis."
          }
