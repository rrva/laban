    "This launch is using a command-line or environment override. Remove that override for the saved menu choice to apply on restart.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次启动使用了命令行或环境变量覆盖。请移除该覆盖，以便在重启时应用保存的菜单选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次啟動使用了命令列或環境變數覆蓋。請移除該覆蓋，以便在重啟時套用儲存的選單選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この起動では、コマンドラインまたは環境のオーバーライドが使用されています。再起動時に保存されたメニューの選択肢を適用するには、そのオーバーライドを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행은 명령줄 또는 환경 재정의를 사용하고 있습니다. 재시작 시 저장된 메뉴 선택을 적용하려면 해당 재정의를 제거하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lancement utilise une substitution de ligne de commande ou d’environnement. Supprimez cette substitution pour que le choix de menu enregistré s’applique au redémarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este inicio utiliza una sustitución de línea de comandos o de entorno. Elimina esa sustitución para que la opción de menú guardada se aplique al reiniciar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लॉन्च कमांड-лайн या पर्यावरण ओवरराइड का उपयोग कर रहा है। पुनरारंभ करने पर सहेजे गए मेनू विकल्प को लागू करने के लिए उस ओवरराइड को हटा दें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот запуск использует переопределение командной строки или окружения. Удалите это переопределение, чтобы сохраненный выбор меню применился при перезапуске."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Start verwendet ein Befehlszeilen- oder Umgebungs-Override. Entferne dieses Override, damit die gespeicherte Menüauswahl beim Neustart angewendet wird."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta inicialização está usando uma substituição de linha de comando ou ambiente. Remova essa substituição para que a opção salva no menu se aplique ao reiniciar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo avvio utilizza un'opzione da riga di comando o di ambiente. Rimuovi tale opzione per applicare al riavvio la scelta salvata nel menu."
          }
        }
      }
    },
