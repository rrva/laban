    "%@ does not provide a usable Han glyph at the terminal size. Pick a font that includes simplified Chinese, traditional Chinese, Japanese, or Korean characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在终端大小下未提供可用的汉字字形。请选择包含简体中文、繁体中文、日语或韩文字符的字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在終端機大小下未提供可用的漢字字形。請選擇包含簡體中文、繁體中文、日語或韓文字元的字型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はターミナルサイズで利用可能な漢字グリフを提供していません。簡体字中国語、繁体字中国語、日本語、または韓国語の文字を含むフォントを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 터미널 크기에서 사용할 수 있는 한자 글리프를 제공하지 않습니다. 간체 중국어, 번체 중국어, 일본어 또는 한국어 문자가 포함된 글꼴을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fournit pas de glyphe Han utilisable à la taille du terminal. Choisissez une police qui inclut des caractères chinois simplifiés, chinois traditionnels, japonais ou coréens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no proporciona un glifo Han utilizable al tamaño del terminal. Elige una fuente que incluya caracteres en chino simplificado, chino tradicional, japonés o coreano."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ टर्मिनल आकार पर एक उपयोगी हान ग्लिफ प्रदान नहीं करता है। ऐसा फ़ॉन्ट चुनें जिसमें सरलीकृत चीनी, पारंपरिक चीनी, जापानी या कोरियाई वर्ण शामिल हों।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не предоставляет пригодного для использования иероглифа Han для размера терминала. Выберите шрифт, содержащий символы упрощенного китайского, традиционного китайского, японского или корейского языков."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bietet keine nutzbare Han-Glyphe in der Terminalgröße. Wähle eine Schriftart, die vereinfachtes Chinesisch, traditionelles Chinesisch, Japanisch oder Koreanisch enthält."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não fornece um glifo Han utilizável no tamanho do terminal. Escolha uma fonte que inclua caracteres em chinês simplificado, chinês tradicional, japonês ou coreano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non fornisce un glifo Han utilizzabile alla dimensione del terminale. Scegli un font che includa caratteri cinesi semplificati, cinesi tradizionali, giapponesi o coreani."
          }
        }
      }
    },
