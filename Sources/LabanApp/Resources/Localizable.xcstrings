    "macOS returned an unknown Focus Status authorization state, so Laban could not diagnose Focus blocking.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 返回了未知的专注模式状态授权状态，因此 Laban 无法诊断专注模式阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 傳回未知的專注模式狀態授權狀態，因此 Laban 無法診斷專注模式阻擋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が不明な集中モード状況の許可状態を返したため、Laban は集中モードによるブロックを診断できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 알 수 없는 집중 모드 상태 권한 상태를 반환하여 Laban이 집중 모드 차단을 진단할 수 없었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a renvoyé un état d’autorisation de Concentration inconnu ; Laban n’a donc pas pu diagnostiquer le blocage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS devolvió un estado de autorización de Concentración desconocido, por lo que Laban no pudo diagnosticar el bloqueo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ने अज्ञात फ़ोकस स्थिति अनुमति लौटाई, इसलिए Laban फ़ोकस अवरोध का निदान नहीं कर सका।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS вернула неизвестное состояние разрешения на статус фокусирования, поэтому Laban не смог диагностировать блокировку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lieferte einen unbekannten Berechtigungsstatus. Daher konnte Laban die Fokus-Blockierung nicht diagnostizieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS retornou um estado de autorização desconhecido, então o Laban não pôde diagnosticar o bloqueio pelo Foco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha restituito uno stato di autorizzazione sconosciuto, quindi Laban non ha potuto diagnosticare il blocco."
          }
        }
      }
    },
