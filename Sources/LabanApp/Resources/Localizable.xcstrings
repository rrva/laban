    "Enable Laban in System Settings > Notifications, and choose Banners or Alerts, to receive tab attention notifications.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置 > 通知中启用 Laban，并选择横幅或提醒，以接收标签页提醒通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定 > 通知中啟用 Laban，並選擇橫幅或提醒，以接收標籤頁提醒通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 > 通知で Laban を有効にし、バナーまたはアラートを選択してタブ注意通知を受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 > 알림에서 Laban을 켜고 배너 또는 알림을 선택해 탭 주의 알림을 받으세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Laban dans Réglages système > Notifications et choisissez Bannières ou Alertes pour recevoir les notifications d’onglet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Laban en Ajustes del sistema > Notificaciones y elige Banners o Alertas para recibir notificaciones de pestaña."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स > सूचनाएँ में Laban सक्षम करें और टैब ध्यान सूचनाएँ पाने के लिए बैनर या अलर्ट चुनें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Laban в Системных настройках > Уведомления и выберите Баннеры или Оповещения для уведомлений о вкладках."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Laban unter Systemeinstellungen > Mitteilungen und wähle Banner oder Hinweise, um Tab-Aufmerksamkeitsbenachrichtigungen zu erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Laban em Ajustes do Sistema > Notificações e escolha Banners ou Alertas para receber notificações de atenção da aba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita Laban in Impostazioni di Sistema > Notifiche e scegli Banner o Avvisi per ricevere notifiche di attenzione della scheda."
          }
        }
      }
    },
