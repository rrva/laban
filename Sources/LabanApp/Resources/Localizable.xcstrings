    "Open Privacy & Security > Focus to grant Laban Focus Status access.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“隐私与安全性”>“专注模式”，向 Laban 授予专注模式状态访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「隱私權與安全性」>「專注模式」，授予 Laban 專注模式狀態存取權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プライバシーとセキュリティ」>「集中モード」を開き、Laban に集中モード状況へのアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안 > 집중 모드를 열어 Laban에 집중 모드 상태 접근을 허용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Confidentialité et sécurité > Concentration pour accorder à Laban l’accès à l’état de Concentration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Privacidad y seguridad > Concentración para conceder a Laban acceso al estado de Concentración."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laban को फ़ोकस स्थिति की पहुँच देने के लिए गोपनीयता और सुरक्षा > फ़ोकस खोलें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Конфиденциальность и безопасность» > «Фокусирование», чтобы предоставить Laban доступ к статусу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Datenschutz & Sicherheit > Fokus, um Laban Zugriff auf den Fokusstatus zu gewähren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Privacidade e Segurança > Foco para conceder ao Laban acesso ao Estado de Foco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Privacy e sicurezza > Full immersion per consentire a Laban di accedere allo stato."
          }
        }
      }
    },
