{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/shell-integration-state.schema.json",
  "title": "Debug Shell Integration State",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "phase"],
  "properties": {
    "sessionId": {"type": "string"},
    "phase": {
      "type": "string",
      "enum": ["idle", "atPrompt", "running", "finished"]
    },
    "lastExitCode": {"type": ["integer", "null"]}
  }
}
