{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/action.schema.json",
  "title": "Debug Action",
  "oneOf": [
    {"$ref": "#/$defs/newTab"},
    {"$ref": "#/$defs/closeTab"},
    {"$ref": "#/$defs/selectTab"},
    {"$ref": "#/$defs/setTabTitle"},
    {"$ref": "#/$defs/freezeTabTitle"},
    {"$ref": "#/$defs/clearTabTitle"},
    {"$ref": "#/$defs/setTabMetadata"},
    {"$ref": "#/$defs/resizeWindow"},
    {"$ref": "#/$defs/setFontSize"},
    {"$ref": "#/$defs/setRenderer"},
    {"$ref": "#/$defs/setVectorSubpixelLayout"},
    {"$ref": "#/$defs/typeText"},
    {"$ref": "#/$defs/feedOutput"},
    {"$ref": "#/$defs/key"},
    {"$ref": "#/$defs/mouseWheel"},
    {"$ref": "#/$defs/click"},
    {"$ref": "#/$defs/advanceFrames"},
    {"$ref": "#/$defs/copy"},
    {"$ref": "#/$defs/paste"},
    {"$ref": "#/$defs/dropFiles"},
    {"$ref": "#/$defs/setClipboardText"},
    {"$ref": "#/$defs/scrollViewport"},
    {"$ref": "#/$defs/propose"},
    {"$ref": "#/$defs/setSelection"},
    {"$ref": "#/$defs/setPreedit"},
    {"$ref": "#/$defs/findStart"},
    {"$ref": "#/$defs/findStep"},
    {"$ref": "#/$defs/findStop"},
    {"$ref": "#/$defs/setBackgroundTransparency"},
    {"$ref": "#/$defs/resetTransparencyDiagnostics"},
    {"$ref": "#/$defs/setReduceTransparencyOverride"},
    {"$ref": "#/$defs/setNativeFullScreen"}
  ],
  "$defs": {
    "newTab": {
      "type": "object",
      "required": ["action"],
      "properties": {"action": {"const": "newTab"}},
      "additionalProperties": false
    },
    "closeTab": {
      "type": "object",
      "required": ["action", "tabId"],
      "properties": {
        "action": {"const": "closeTab"},
        "tabId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "selectTab": {
      "type": "object",
      "required": ["action", "tabId"],
      "properties": {
        "action": {"const": "selectTab"},
        "tabId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "setTabTitle": {
      "type": "object",
      "required": ["action", "title"],
      "properties": {
        "action": {"const": "setTabTitle"},
        "tabId": {"type": "string"},
        "title": {"type": "string"}
      },
      "additionalProperties": false
    },
    "freezeTabTitle": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "freezeTabTitle"},
        "tabId": {"type": "string"},
        "frozen": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "clearTabTitle": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "clearTabTitle"},
        "tabId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "setTabMetadata": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "setTabMetadata"},
        "tabId": {"type": "string"},
        "cwd": {"type": "string"},
        "repoName": {"type": "string"},
        "repoRoot": {"type": "string"},
        "worktreeName": {"type": "string"},
        "branch": {"type": "string"},
        "isDirty": {"type": "boolean"},
        "foregroundProcess": {"type": "string"},
        "foregroundCommand": {"type": "string"},
        "pid": {"type": "integer"},
        "agentName": {"type": "string"},
        "sessionName": {"type": "string"},
        "agentSessionId": {"type": "string"},
        "taskLabel": {"type": "string"},
        "model": {"type": "string"},
        "contextPercent": {"type": "integer", "minimum": 0, "maximum": 100},
        "awaitingInput": {"type": "boolean"},
        "activityState": {
          "enum": ["active", "background", "running", "idle", "unseenOutput", "waiting", "exited"]
        },
        "unseenOutput": {"type": "boolean"},
        "bellAttention": {"type": "boolean"},
        "exitStatus": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "resizeWindow": {
      "type": "object",
      "required": ["action", "width", "height"],
      "properties": {
        "action": {"const": "resizeWindow"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "setFontSize": {
      "type": "object",
      "required": ["action", "pointSize"],
      "properties": {
        "action": {"const": "setFontSize"},
        "pointSize": {"type": "number", "minimum": 1}
      },
      "additionalProperties": false
    },
    "setRenderer": {
      "type": "object",
      "required": ["action", "renderer"],
      "properties": {
        "action": {"const": "setRenderer"},
        "renderer": {"enum": ["software", "classic", "gpuDriven", "vectorGlyph"]}
      },
      "additionalProperties": false
    },
    "setVectorSubpixelLayout": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "setVectorSubpixelLayout"},
        "layout": {"type": "string"},
        "offsets": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 3,
          "maxItems": 3
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 4,
            "maxItems": 4
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "additionalProperties": false
    },
    "typeText": {
      "type": "object",
      "required": ["action", "text"],
      "properties": {
        "action": {"const": "typeText"},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "feedOutput": {
      "type": "object",
      "required": ["action", "text"],
      "properties": {
        "action": {"const": "feedOutput"},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "required": ["action", "key"],
      "properties": {
        "action": {"const": "key"},
        "key": {"type": "string"},
        "type": {"enum": ["press", "repeat", "release"]},
        "modifiers": {
          "type": "array",
          "items": {"enum": ["shift", "control", "alt", "option", "command", "super"]},
          "uniqueItems": true
        },
        "consumedModifiers": {
          "type": "array",
          "items": {"enum": ["shift", "alt", "option"]},
          "uniqueItems": true
        },
        "text": {"type": "string"},
        "unshifted": {"type": "string"}
      },
      "additionalProperties": false
    },
    "mouseWheel": {
      "type": "object",
      "required": ["action", "x", "y", "deltaY"],
      "properties": {
        "action": {"const": "mouseWheel"},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "deltaY": {"type": "number"}
      },
      "additionalProperties": false
    },
    "click": {
      "type": "object",
      "required": ["action", "x", "y", "button"],
      "properties": {
        "action": {"const": "click"},
        "x": {"type": "integer"},
        "y": {"type": "integer"},
        "button": {"enum": ["left", "middle", "right"]}
      },
      "additionalProperties": false
    },
    "advanceFrames": {
      "type": "object",
      "required": ["action", "count"],
      "properties": {
        "action": {"const": "advanceFrames"},
        "count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "copy": {
      "type": "object",
      "required": ["action"],
      "properties": {"action": {"const": "copy"}},
      "additionalProperties": false
    },
    "paste": {
      "type": "object",
      "required": ["action"],
      "properties": {"action": {"const": "paste"}},
      "additionalProperties": false
    },
    "dropFiles": {
      "type": "object",
      "required": ["action", "paths"],
      "properties": {
        "action": {"const": "dropFiles"},
        "paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "setClipboardText": {
      "type": "object",
      "required": ["action", "text"],
      "properties": {
        "action": {"const": "setClipboardText"},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scrollViewport": {
      "type": "object",
      "required": ["action", "deltaRows"],
      "properties": {
        "action": {"const": "scrollViewport"},
        "sessionId": {"type": "string"},
        "deltaRows": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "propose": {
      "type": "object",
      "required": ["action", "command"],
      "properties": {
        "action": {"const": "propose"},
        "command": {"type": "string", "minLength": 1},
        "purpose": {"type": "string"},
        "targetSessionID": {"type": "string"},
        "targetSessionId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "setSelection": {
      "type": "object",
      "required": ["action", "anchor", "focus"],
      "properties": {
        "action": {"const": "setSelection"},
        "sessionId": {"type": "string"},
        "anchor": {"$ref": "#/$defs/cell"},
        "focus": {"$ref": "#/$defs/cell"}
      },
      "additionalProperties": false
    },
    "setPreedit": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "setPreedit"},
        "sessionId": {"type": "string"},
        "text": {"type": "string"},
        "caretCells": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "findStart": {
      "type": "object",
      "required": ["action", "needle"],
      "properties": {
        "action": {"const": "find.start"},
        "sessionID": {"type": "string"},
        "sessionId": {"type": "string"},
        "needle": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "findStep": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "find.step"},
        "sessionID": {"type": "string"},
        "sessionId": {"type": "string"},
        "direction": {"enum": ["next", "previous"]}
      },
      "additionalProperties": false
    },
    "findStop": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "find.stop"},
        "sessionID": {"type": "string"},
        "sessionId": {"type": "string"}
      },
      "additionalProperties": false
    },
    "setBackgroundTransparency": {
      "type": "object",
      "required": ["action", "opacity", "applyToExplicitCellBackgrounds"],
      "properties": {
        "action": {"const": "setBackgroundTransparency"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "applyToExplicitCellBackgrounds": {"type": "boolean"},
        "backdropStyle": {"enum": ["none", "systemBlur", "image"]}
      },
      "additionalProperties": false
    },
    "resetTransparencyDiagnostics": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "resetTransparencyDiagnostics"}
      },
      "additionalProperties": false
    },
    "setReduceTransparencyOverride": {
      "type": "object",
      "required": ["action", "enabled"],
      "properties": {
        "action": {"const": "setReduceTransparencyOverride"},
        "enabled": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "setNativeFullScreen": {
      "type": "object",
      "required": ["action", "enabled"],
      "properties": {
        "action": {"const": "setNativeFullScreen"},
        "enabled": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "required": ["row", "col"],
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "col": {"type": "integer", "minimum": 0}
      }
    }
  }
}
