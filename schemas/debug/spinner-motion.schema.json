{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/spinner-motion.schema.json",
  "title": "Spinner Motion State",
  "type": "object",
  "required": [
    "configured",
    "effectiveRenderer",
    "rendererEligible",
    "reduceMotion",
    "effectiveEnabled",
    "activeTransitions",
    "analyticMotionInstances",
    "fallbackSnaps",
    "effectKind",
    "remainingSeconds",
    "liveEffectFrames"
  ],
  "additionalProperties": true,
  "properties": {
    "configured": {"type": "boolean"},
    "effectiveRenderer": {"type": "string"},
    "rendererEligible": {"type": "boolean"},
    "reduceMotion": {"type": "boolean"},
    "effectiveEnabled": {"type": "boolean"},
    "activeTransitions": {"type": "integer", "minimum": 0},
    "analyticMotionInstances": {"type": "integer", "minimum": 0},
    "fallbackSnaps": {"type": "integer", "minimum": 0},
    "effectKind": {"type": "integer", "minimum": 0},
    "remainingSeconds": {"type": "number", "minimum": 0},
    "liveEffectFrames": {"type": "integer", "minimum": 0}
  }
}
