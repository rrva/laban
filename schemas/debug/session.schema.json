{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/session.schema.json",
  "title": "Debug Session",
  "type": "object",
  "required": [
    "id",
    "tabId",
    "transportMode",
    "status",
    "exitStatus",
    "rows",
    "cols",
    "cellWidth",
    "cellHeight",
    "scrollbackLines",
    "viewportOffset",
    "title",
    "displayTitle",
    "titleSource",
    "titleFrozen",
    "activityState",
    "unseenOutput",
    "bellAttention",
    "mouseTracking",
    "focusReporting",
    "dirty"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string"},
    "tabId": {"type": "string"},
    "pid": {"type": ["integer", "null"]},
    "status": {
      "type": "string",
      "enum": ["starting", "running", "exited", "failed", "terminated", "dead"]
    },
    "foregroundPid": {"type": ["integer", "null"]},
    "daemonProcessPid": {"type": ["integer", "null"]},
    "logicalSessionId": {"type": ["string", "null"]},
    "incarnationId": {"type": ["string", "null"]},
    "attachedClientCount": {"type": ["integer", "null"], "minimum": 0},
    "leaseHolder": {"type": ["string", "null"]},
    "transportMode": {"type": "string"},
    "exitStatus": {"type": ["integer", "null"]},
    "rows": {"type": "integer", "minimum": 1},
    "cols": {"type": "integer", "minimum": 1},
    "cellWidth": {"type": "integer", "minimum": 1},
    "cellHeight": {"type": "integer", "minimum": 1},
    "scrollbackLines": {"type": "integer", "minimum": 0},
    "viewportOffset": {"type": "integer", "minimum": 0},
    "title": {"type": "string"},
    "displayTitle": {"type": "string"},
    "titleSource": {
      "type": "string",
      "enum": ["user", "agent", "repo", "cwd", "process", "terminal", "fallback"]
    },
    "terminalTitle": {"type": ["string", "null"]},
    "userTitle": {"type": ["string", "null"]},
    "titleFrozen": {"type": "boolean"},
    "activityState": {
      "type": "string",
      "enum": ["active", "background", "running", "idle", "unseenOutput", "waiting", "exited"]
    },
    "lastActivityAt": {"type": ["string", "null"], "format": "date-time"},
    "lastOutputAt": {"type": ["string", "null"], "format": "date-time"},
    "unseenOutput": {"type": "boolean"},
    "bellAttention": {"type": "boolean"},
    "workspace": {"type": "object", "additionalProperties": true},
    "process": {"type": "object", "additionalProperties": true},
    "agent": {"type": "object", "additionalProperties": true},
    "mouseTracking": {"type": "boolean"},
    "focusReporting": {"type": "boolean"},
    "dirty": {"type": "boolean"},
    "grid": {
      "type": "object",
      "required": ["rows", "cols", "cells", "truncated"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1},
        "truncated": {"type": "boolean"},
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "row",
              "col",
              "text",
              "foreground",
              "background",
              "attributes",
              "wide"
            ],
            "additionalProperties": true,
            "properties": {
              "row": {"type": "integer", "minimum": 0},
              "col": {"type": "integer", "minimum": 0},
              "text": {"type": "string"},
              "foreground": {
                "type": "array",
                "prefixItems": [
                  {"type": "integer", "minimum": 0, "maximum": 255},
                  {"type": "integer", "minimum": 0, "maximum": 255},
                  {"type": "integer", "minimum": 0, "maximum": 255},
                  {"type": "integer", "minimum": 0, "maximum": 255}
                ],
                "minItems": 4,
                "maxItems": 4
              },
              "background": {
                "type": "array",
                "prefixItems": [
                  {"type": "integer", "minimum": 0, "maximum": 255},
                  {"type": "integer", "minimum": 0, "maximum": 255},
                  {"type": "integer", "minimum": 0, "maximum": 255},
                  {"type": "integer", "minimum": 0, "maximum": 255}
                ],
                "minItems": 4,
                "maxItems": 4
              },
              "attributes": {
                "type": "array",
                "items": {"type": "string"}
              },
              "wide": {
                "type": "string",
                "enum": ["narrow", "wide", "spacerHead", "spacerTail"]
              },
              "hyperlink": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
