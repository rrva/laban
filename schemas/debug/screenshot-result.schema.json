{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/screenshot-result.schema.json",
  "title": "Debug Screenshot Result",
  "type": "object",
  "required": ["path", "width", "height", "frame", "target"],
  "additionalProperties": true,
  "properties": {
    "path": {"type": "string"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "frame": {"type": "integer", "minimum": 0},
    "target": {"type": "string"}
  }
}
