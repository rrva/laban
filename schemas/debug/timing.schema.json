{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/timing.schema.json",
  "title": "Debug Timing",
  "type": "object",
  "required": ["frame"],
  "additionalProperties": {
    "type": "number",
    "minimum": 0
  },
  "properties": {
    "frame": {"type": "integer", "minimum": 0},
    "lastFrameMs": {"type": "number", "minimum": 0},
    "terminalPollMs": {"type": "number", "minimum": 0},
    "snapshotMs": {"type": "number", "minimum": 0},
    "commandExtractionMs": {"type": "number", "minimum": 0},
    "renderMs": {"type": "number", "minimum": 0},
    "screenshotMs": {"type": "number", "minimum": 0}
  }
}
