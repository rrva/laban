{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/terminal-log.schema.json",
  "title": "Debug Terminal Log",
  "type": "object",
  "required": ["sessionId", "events", "next", "truncated"],
  "additionalProperties": true,
  "properties": {
    "sessionId": {"type": "string"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "direction", "escaped"],
        "additionalProperties": true,
        "properties": {
          "seq": {"type": "integer", "minimum": 0},
          "direction": {"enum": ["input", "output", "terminalResponse"]},
          "escaped": {"type": "string"}
        }
      }
    },
    "next": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"}
  }
}
