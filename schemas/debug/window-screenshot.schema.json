{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/window-screenshot.schema.json",
  "title": "Laban Window Screenshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "pngBase64", "width", "height", "byteCount", "includesDialogs"],
  "properties": {
    "ok": {"type": "boolean"},
    "pngBase64": {"type": "string", "contentEncoding": "base64"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "byteCount": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "includesDialogs": {"type": "boolean"}
  }
}
