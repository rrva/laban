{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/state.schema.json",
  "title": "Debug State",
  "type": "object",
  "required": [
    "mode",
    "frame",
    "window",
    "tabs",
    "activeTabId",
    "activeSessionId",
    "findStateBySession"
  ],
  "additionalProperties": true,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["interactive", "headless", "fixture"]
    },
    "frame": {
      "type": "integer",
      "minimum": 0
    },
    "window": {
      "type": "object",
      "required": ["width", "height", "focused"],
      "additionalProperties": true,
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "focused": {"type": "boolean"}
      }
    },
    "tabs": {
      "type": "array",
      "items": {"$ref": "#/$defs/tab"}
    },
    "activeTabId": {
      "type": ["string", "null"]
    },
    "activeSessionId": {
      "type": ["string", "null"]
    },
    "findStateBySession": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/findState"}
    }
  },
  "$defs": {
    "tab": {
      "type": "object",
      "required": [
        "id",
        "index",
        "title",
        "displayTitle",
        "titleSource",
        "titleFrozen",
        "activityState",
        "unseenOutput",
        "bellAttention",
        "active",
        "status",
        "sessionId"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string"},
        "index": {"type": "integer", "minimum": 0},
        "title": {"type": "string"},
        "displayTitle": {"type": "string"},
        "titleSource": {
          "type": "string",
          "enum": ["user", "agent", "repo", "cwd", "process", "terminal", "fallback"]
        },
        "terminalTitle": {"type": ["string", "null"]},
        "userTitle": {"type": ["string", "null"]},
        "titleFrozen": {"type": "boolean"},
        "activityState": {
          "type": "string",
          "enum": ["active", "background", "running", "idle", "unseenOutput", "waiting", "exited"]
        },
        "lastActivityAt": {"type": ["string", "null"], "format": "date-time"},
        "lastOutputAt": {"type": ["string", "null"], "format": "date-time"},
        "unseenOutput": {"type": "boolean"},
        "bellAttention": {"type": "boolean"},
        "exitStatus": {"type": ["integer", "null"]},
        "shellPhase": {
          "type": "string",
          "enum": ["idle", "atPrompt", "running", "finished"]
        },
        "lastCommandExitCode": {"type": ["integer", "null"]},
        "workspace": {"type": "object", "additionalProperties": true},
        "process": {"type": "object", "additionalProperties": true},
        "agent": {"type": "object", "additionalProperties": true},
        "active": {"type": "boolean"},
        "status": {
          "type": "string",
          "enum": ["starting", "running", "exited", "failed"]
        },
        "sessionId": {"type": "string"}
      }
    },
    "findMatch": {
      "type": "object",
      "required": ["row", "startColumn", "endColumn"],
      "additionalProperties": false,
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "startColumn": {"type": "integer", "minimum": 0},
        "endColumn": {"type": "integer", "minimum": 0}
      }
    },
    "findState": {
      "type": "object",
      "required": ["isActive", "needle", "total", "selectedIndex", "matches"],
      "additionalProperties": true,
      "properties": {
        "isActive": {"type": "boolean"},
        "needle": {"type": "string"},
        "total": {"type": "integer", "minimum": 0},
        "selectedIndex": {"type": ["integer", "null"], "minimum": 0},
        "matches": {
          "type": "array",
          "items": {"$ref": "#/$defs/findMatch"}
        },
        "viewportScrollOffsetAtStart": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
