{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/debug/transparency.schema.json",
  "title": "Terminal Transparency Diagnostics",
  "type": "object",
  "required": [
    "requestedOpacity",
    "effectiveOpacity",
    "requestedBackdropStyle",
    "effectiveBackdropStyle",
    "backgroundImageScaling",
    "backgroundImageState",
    "backgroundImageIdentifier",
    "backgroundImagePixelWidth",
    "backgroundImagePixelHeight",
    "backgroundImageContentDigest",
    "backgroundImageImportCount",
    "backgroundImageDecodeCount",
    "backgroundImageFileReadCount",
    "backgroundImageApplyCount",
    "backgroundImageRedrawCount",
    "applyToExplicitCellBackgrounds",
    "surfaceOpaque",
    "effectiveGlyphAntialiasing",
    "snapshotExplicitBackgroundCapability",
    "configuredRenderer",
    "effectiveRenderer",
    "backdropSubviewCount",
    "backdropSubviewKind",
    "systemReduceTransparency",
    "effectiveReduceTransparency",
    "nativeFullscreen",
    "accessibilityRefreshCount",
    "effectiveTransparencyApplyCount",
    "transparencyRenderWakeCount",
    "rendererPresentCount",
    "presentIntervalDeadlineMisses"
  ],
  "properties": {
    "requestedOpacity": {"type": "number", "minimum": 0, "maximum": 1},
    "effectiveOpacity": {"type": "number", "minimum": 0, "maximum": 1},
    "requestedBackdropStyle": {"enum": ["none", "systemBlur", "image"]},
    "effectiveBackdropStyle": {"enum": ["none", "systemBlur", "image"]},
    "backgroundImageScaling": {"enum": ["fill", "fit", "stretch"]},
    "backgroundImageState": {
      "enum": ["none", "available", "missing", "corrupt", "headlessUnsupported"]
    },
    "backgroundImageIdentifier": {"type": ["string", "null"]},
    "backgroundImagePixelWidth": {"type": ["integer", "null"], "minimum": 1},
    "backgroundImagePixelHeight": {"type": ["integer", "null"], "minimum": 1},
    "backgroundImageContentDigest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "backgroundImageImportCount": {"type": "integer", "minimum": 0},
    "backgroundImageDecodeCount": {"type": "integer", "minimum": 0},
    "backgroundImageFileReadCount": {"type": "integer", "minimum": 0},
    "backgroundImageApplyCount": {"type": "integer", "minimum": 0},
    "backgroundImageRedrawCount": {"type": "integer", "minimum": 0},
    "applyToExplicitCellBackgrounds": {"type": "boolean"},
    "forceOpaqueReason": {
      "type": ["string", "null"],
      "enum": [
        "reduceTransparency",
        "nativeFullscreen",
        "legacySnapshotWriter",
        "backgroundImageUnavailable",
        null
      ]
    },
    "surfaceOpaque": {"type": "boolean"},
    "effectiveGlyphAntialiasing": {"type": "string"},
    "effectiveGlyphAntialiasingReason": {"type": ["string", "null"]},
    "snapshotExplicitBackgroundCapability": {"enum": ["inProcess", "supported", "legacy"]},
    "configuredRenderer": {"type": "string"},
    "effectiveRenderer": {"type": "string"},
    "backdropSubviewCount": {"type": "integer", "minimum": 0, "maximum": 1},
    "backdropSubviewKind": {"type": "string", "enum": ["none", "systemBlur", "image"]},
    "systemReduceTransparency": {"type": "boolean"},
    "reduceTransparencyOverride": {"type": ["boolean", "null"]},
    "effectiveReduceTransparency": {"type": "boolean"},
    "nativeFullscreen": {"type": "boolean"},
    "accessibilityRefreshCount": {"type": "integer", "minimum": 0},
    "effectiveTransparencyApplyCount": {"type": "integer", "minimum": 0},
    "transparencyRenderWakeCount": {"type": "integer", "minimum": 0},
    "rendererPresentCount": {"type": "integer", "minimum": 0},
    "presentIntervalDeadlineMisses": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
