{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laban.local/schemas/capture/event.schema.json",
  "title": "Laban capture timeline event",
  "type": "object",
  "additionalProperties": true,
  "required": ["seq", "timeNs", "kind"],
  "properties": {
    "seq": {"type": "integer", "minimum": 0},
    "timeNs": {"type": "integer", "minimum": 0},
    "kind": {
      "type": "string",
      "enum": [
        "capture.started",
        "capture.finished",
        "app.state",
        "tab.created",
        "tab.selected",
        "tab.closed",
        "session.created",
        "session.resized",
        "session.exited",
        "input.event",
        "pty.input",
        "pty.output",
        "terminal.response",
        "frame.begin",
        "terminal.snapshot",
        "frame.commands",
        "frame.rendered",
        "screenshot.captured",
        "capture.snapshot",
        "capture.error"
      ]
    },
    "frame": {"type": ["integer", "null"], "minimum": 0},
    "tabId": {"type": ["string", "null"]},
    "sessionId": {"type": ["string", "null"]},
    "pane": {
      "description": "Optional split-pane presentation for terminal.snapshot; content remains sourced from per-session PTY streams.",
      "type": ["object", "null"],
      "required": ["rect", "originX", "originY", "cellWidth", "cellHeight", "cursorStyle", "cursorBlinking", "cursorBlinkVisible", "contentYOffset", "preeditCaretCells", "accessibility", "background", "dividerColor"],
      "properties": {
        "rect": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "number"}, "y": {"type": "number"},
            "width": {"type": "number"}, "height": {"type": "number"}
          }
        },
        "originX": {"type": "number"}, "originY": {"type": "number"},
        "cellWidth": {"type": "integer", "minimum": 1},
        "cellHeight": {"type": "integer", "minimum": 1},
        "cursorStyle": {"type": "integer"},
        "cursorBlinking": {"type": "boolean"}, "cursorBlinkVisible": {"type": "boolean"},
        "contentYOffset": {"type": "number"},
        "preedit": {"type": ["string", "null"]}, "preeditCaretCells": {"type": "integer"},
        "accessibility": {
          "type": "object", "required": ["increaseContrast", "differentiateWithoutColor", "reduceTransparency"],
          "properties": {
            "increaseContrast": {"type": "boolean"}, "differentiateWithoutColor": {"type": "boolean"},
            "reduceTransparency": {"type": "boolean"}
          }
        },
        "background": {
          "type": "object", "required": ["opacity", "applyToExplicitCellBackgrounds"],
          "properties": {
            "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
            "applyToExplicitCellBackgrounds": {"type": "boolean"}
          }
        },
        "dividerColor": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "stream": {"type": ["string", "null"]},
    "offset": {"type": ["integer", "null"], "minimum": 0},
    "length": {"type": ["integer", "null"], "minimum": 0},
    "sha256": {"type": ["string", "null"]},
    "path": {"type": ["string", "null"]},
    "inputId": {"type": ["string", "null"]},
    "route": {"type": ["string", "null"]},
    "encodedHex": {"type": ["string", "null"]},
    "commandCount": {"type": ["integer", "null"], "minimum": 0}
  }
}
