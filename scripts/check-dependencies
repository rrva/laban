#!/usr/bin/env python3
import re
import subprocess
import sys
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
PACKAGE = ROOT / "Package.swift"
PACKAGE_RESOLVED = ROOT / "Package.resolved"
FETCH = ROOT / "scripts/fetch-libghostty-vt"
WORKFLOW = ROOT / ".github/workflows/check.yml"
ADR = ROOT / "docs/adr/0001-libghostty-vt-owns-vt-parsing.md"
PROFILE_DOC = ROOT / "docs/process/profiling-hiccups.md"
ALLOWED_SWIFTPM_DEPENDENCIES = {
    "swift-profile-recorder": {
        "url": "https://github.com/apple/swift-profile-recorder.git",
        "version": "0.3.18",
        "revision": "e110ba85da7d43a47b0e964726e84fddcf720192",
        "doc": PROFILE_DOC,
    }
}


def fail(errors: list[str], message: str) -> None:
    errors.append(message)


def shell(command: list[str], cwd: Path | None = None) -> str | None:
    try:
        return subprocess.check_output(command, cwd=cwd, text=True, stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError:
        return None


def shell_script_value(text: str, name: str) -> str | None:
    match = re.search(rf'^{re.escape(name)}="([^"]+)"$', text, re.M)
    return match.group(1) if match else None


def package_dependencies(package: str) -> list[tuple[str, str]]:
    matches = re.findall(
        r'\.package\(\s*url:\s*"([^"]+)"\s*,\s*\.upToNextMinor\(from:\s*"([^"]+)"\)\s*\)',
        package,
        re.S,
    )
    return matches


def resolved_pins() -> dict[str, dict]:
    if not PACKAGE_RESOLVED.is_file():
        return {}
    data = json.loads(PACKAGE_RESOLVED.read_text(encoding="utf-8"))
    return {pin.get("identity", ""): pin for pin in data.get("pins", [])}


def main() -> int:
    errors: list[str] = []
    package = PACKAGE.read_text(encoding="utf-8")
    fetch = FETCH.read_text(encoding="utf-8")
    workflow = WORKFLOW.read_text(encoding="utf-8")
    adr = ADR.read_text(encoding="utf-8")

    dependencies = package_dependencies(package)
    if ".package(" in package and not dependencies:
        fail(errors, "Package.swift contains an unsupported SwiftPM dependency declaration")

    pins = resolved_pins()
    for dep_url, dep_version in dependencies:
        identity = dep_url.removesuffix(".git").rstrip("/").split("/")[-1]
        allowed = ALLOWED_SWIFTPM_DEPENDENCIES.get(identity)
        if not allowed:
            fail(errors, f"Package.swift declares unapproved SwiftPM dependency: {dep_url}")
            continue
        if dep_url != allowed["url"] or dep_version != allowed["version"]:
            fail(errors, f"{identity} must stay pinned in Package.swift to {allowed['url']} {allowed['version']}")
        pin = pins.get(identity)
        state = pin.get("state", {}) if pin else {}
        if not pin:
            fail(errors, f"Package.resolved is missing pin for {identity}")
        elif (
            pin.get("location") != allowed["url"]
            or state.get("version") != allowed["version"]
            or state.get("revision") != allowed["revision"]
        ):
            fail(errors, f"Package.resolved must pin {identity} to {allowed['version']} {allowed['revision']}")
        doc = Path(allowed["doc"]).read_text(encoding="utf-8")
        if allowed["url"] not in doc or allowed["version"] not in doc or allowed["revision"] not in doc:
            fail(errors, f"{allowed['doc'].relative_to(ROOT)} must document the {identity} URL, version, and revision")

    commit = shell_script_value(fetch, "GHOSTTY_COMMIT")
    url = shell_script_value(fetch, "GHOSTTY_URL")
    dest = shell_script_value(fetch, "DEST")

    if not commit or not re.fullmatch(r"[0-9a-f]{40}", commit):
        fail(errors, "scripts/fetch-libghostty-vt must define a 40-character GHOSTTY_COMMIT")
    if url != "https://github.com/ghostty-org/ghostty":
        fail(errors, "scripts/fetch-libghostty-vt must fetch the official Ghostty repository")
    if dest != ".external/libghostty-vt":
        fail(errors, "scripts/fetch-libghostty-vt must keep libghostty-vt under .external/libghostty-vt")
    if "-Demit-lib-vt" not in fetch:
        fail(errors, "scripts/fetch-libghostty-vt must build the libghostty-vt archive")
    if "-Doptimize=ReleaseFast" not in fetch:
        fail(errors, "scripts/fetch-libghostty-vt must build the vendored library with ReleaseFast")
    if commit and commit not in adr:
        fail(errors, "ADR 0001 must name the same libghostty-vt commit as scripts/fetch-libghostty-vt")

    patch_paths = sorted(ROOT.glob("patches/libghostty-vt-*.patch"))
    declared_patches = [
        ROOT / path
        for path in re.findall(r'^PATCH_[0-9]{4}="([^"]+)"$', fetch, re.M)
    ]
    if declared_patches != [
        ROOT / "patches/libghostty-vt-0002-stream-log-scope-and-mode-debug.patch",
        ROOT / "patches/libghostty-vt-0001-alt-screen-clear-uses-primary-pen.patch",
        ROOT / "patches/libghostty-vt-0003-decxcpr-cursor-position-report.patch",
    ]:
        fail(errors, "scripts/fetch-libghostty-vt must declare the reviewed 0002/0001/0003 patch order")
    if set(declared_patches) != set(patch_paths):
        fail(errors, "every patches/libghostty-vt-*.patch file must be declared exactly once by the fetch script")
    if 'PATCH_ORDER="$PATCH_0002 $PATCH_0001 $PATCH_0003"' not in fetch:
        fail(errors, "scripts/fetch-libghostty-vt must apply patches in 0002/0001/0003 order")

    fetch_guards = {
        "content-addressed patch fingerprint": "git hash-object",
        "applied-source validation": "apply --reverse --check",
        "partial-patch recovery": 'reset --hard "$GHOSTTY_COMMIT"',
        "pinned Zig toolchain check": 'if [ "$zig_version" != "0.15.2" ]',
        "post-build patch stamp": 'mv "$stamp_tmp" "$PATCH_STAMP"',
        "SwiftPM relink trigger": 'touch "$repo_root/$RELINK_INPUT"',
    }
    for label, snippet in fetch_guards.items():
        if snippet not in fetch:
            fail(errors, f"scripts/fetch-libghostty-vt is missing {label}")

    vendored_hash = "${{ hashFiles('scripts/fetch-libghostty-vt', 'patches/libghostty-vt-*.patch') }}"
    cache_lines = [line.strip() for line in workflow.splitlines() if vendored_hash in line]
    if len(cache_lines) < 3:
        fail(errors, "CI vendored, SwiftPM exact, and SwiftPM restore cache keys must include the patch-set hash")
    if not any(line.startswith("key: libghostty-vt-zigout-") for line in cache_lines):
        fail(errors, "CI libghostty-vt zig-out cache key must include the patch-set hash")
    if not any(
        line.startswith("key: swiftpm-") and "hashFiles('Package.swift', 'Sources/**')" in line
        for line in cache_lines
    ):
        fail(errors, "CI SwiftPM cache key must put the patch-set hash before the source hash")
    if not any(line.startswith("swiftpm-") for line in cache_lines):
        fail(errors, "CI SwiftPM restore prefix must retain the patch-set hash")

    external = ROOT / ".external/libghostty-vt"
    if external.exists():
        git_dir = external / ".git"
        if git_dir.exists():
            head = shell(["git", "-C", str(external), "rev-parse", "HEAD"])
            if commit and head != commit:
                fail(errors, f".external/libghostty-vt is at {head or 'unknown'}, expected {commit}")

            origin = shell(["git", "-C", str(external), "remote", "get-url", "origin"])
            if origin and origin.rstrip("/") != "https://github.com/ghostty-org/ghostty":
                fail(errors, f".external/libghostty-vt origin is {origin}, expected official Ghostty")

            lib = external / "zig-out/lib/libghostty-vt.a"
            header = external / "zig-out/include/ghostty/vt.h"
            stamp = external / "zig-out/.laban-patchset"
            if not lib.is_file():
                fail(errors, f"missing vendored libghostty-vt archive: {lib.relative_to(ROOT)}")
            if not header.is_file():
                fail(errors, f"missing vendored libghostty-vt header: {header.relative_to(ROOT)}")
            patch_hashes = [shell(["git", "hash-object", str(path)], cwd=ROOT) for path in declared_patches]
            if any(value is None for value in patch_hashes):
                fail(errors, "failed to fingerprint the declared libghostty-vt patches")
            else:
                expected_stamp = "\n".join(value for value in patch_hashes if value is not None)
                actual_stamp = stamp.read_text(encoding="utf-8").strip() if stamp.is_file() else None
                if actual_stamp != expected_stamp:
                    fail(errors, ".external/libghostty-vt patch-set stamp is missing or stale")
            for patch in declared_patches:
                applied = shell(
                    ["git", "-C", str(external), "apply", "--reverse", "--check", str(patch)]
                )
                if applied is None:
                    fail(errors, f"vendored patch is not applied: {patch.relative_to(ROOT)}")
        else:
            fail(errors, ".external/libghostty-vt exists but is not a git checkout")

    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    print("check-dependencies passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
