#!/bin/sh
# laban-watchdog — rolling external sampler for Laban.
#
# Run as a LaunchAgent or in any persistent shell. Every INTERVAL seconds it
# samples Laban, writing the result to OUT_DIR. Keeps only the most recent KEEP
# files per pid so disk usage stays bounded.
#
# Use this when the system itself becomes too unresponsive to launch
# `sample` interactively — by the time you can type a command, the evidence
# is already on disk under ~/laban-watchdog/.
#
# Env knobs (all optional):
#   LABAN_WATCHDOG_INTERVAL  seconds between sample sweeps   (default 5)
#   LABAN_WATCHDOG_DURATION  seconds per sample              (default 1)
#   LABAN_WATCHDOG_KEEP      max samples to retain per pid   (default 30)
#   LABAN_WATCHDOG_OUT       output directory                (default ~/laban-watchdog)
#   LABAN_WATCHDOG_DESCENDANTS sample shell/agent descendants (default 0)
#   LABAN_WATCHDOG_MAX_PIDS   max pids per sweep             (default 4)
#   LABAN_WATCHDOG_MAX_JOBS   max concurrent sample jobs     (default 1)

set -u

INTERVAL=${LABAN_WATCHDOG_INTERVAL:-5}
DURATION=${LABAN_WATCHDOG_DURATION:-1}
KEEP=${LABAN_WATCHDOG_KEEP:-30}
OUT_DIR=${LABAN_WATCHDOG_OUT:-"$HOME/laban-watchdog"}
INCLUDE_DESCENDANTS=${LABAN_WATCHDOG_DESCENDANTS:-0}
MAX_PIDS=${LABAN_WATCHDOG_MAX_PIDS:-4}
MAX_JOBS=${LABAN_WATCHDOG_MAX_JOBS:-1}

mkdir -p "$OUT_DIR"

# Sample a single pid in the background. -mayDie lets sample tolerate the
# target exiting mid-sample; -file writes directly without buffering on
# stderr where launchd would intercept it.
sample_one() {
    pid=$1
    name=$2
    ts=$3
    out="$OUT_DIR/${pid}-${name}-${ts}.txt"
    /usr/bin/sample "$pid" "$DURATION" -mayDie -file "$out" >/dev/null 2>&1
}

# Trim oldest samples for a single pid prefix.
trim_pid() {
    prefix=$1
    # sort newest first, skip the first $KEEP, delete the rest
    old=$(/bin/ls -t "$OUT_DIR"/"${prefix}"-*.txt 2>/dev/null \
        | /usr/bin/awk -v keep="$KEEP" 'NR > keep { print }')
    [ -n "$old" ] || return 0
    printf '%s\n' "$old" | /usr/bin/xargs rm -f 2>/dev/null
}

while :; do
    ts=$(/bin/date +%Y%m%d-%H%M%S)

    # Find the Laban app process. Empty if Laban isn't running — quiet skip.
    laban_pids=$(/usr/bin/pgrep -f "Laban.app/Contents/MacOS/Laban" 2>/dev/null || true)
    if [ -z "$laban_pids" ]; then
        sleep "$INTERVAL"
        continue
    fi

    # By default sample only Laban. Descendant sampling is useful for targeted
    # session diagnostics, but it can become expensive when tabs contain agent
    # sessions with many child processes.
    walk_descendants() {
        for pid in $(/usr/bin/pgrep -P "$1" 2>/dev/null || true); do
            echo "$pid"
            walk_descendants "$pid"
        done
    }
    pids=""
    for parent in $laban_pids; do
        pids="$pids $parent"
        case "$INCLUDE_DESCENDANTS" in
            1|true|TRUE|yes|YES)
                pids="$pids $(walk_descendants "$parent")"
                ;;
        esac
    done

    seen=""
    pid_count=0
    active_jobs=0
    for pid in $pids; do
        [ -n "$pid" ] || continue
        case " $seen " in
            *" $pid "*) continue ;;
        esac
        seen="$seen $pid"
        pid_count=$((pid_count + 1))
        [ "$pid_count" -le "$MAX_PIDS" ] || break
        name=$(/bin/ps -p "$pid" -o comm= 2>/dev/null | /usr/bin/sed 's|.*/||' | /usr/bin/tr -c 'A-Za-z0-9_-' '_')
        [ -n "$name" ] || continue
        sample_one "$pid" "$name" "$ts" &
        active_jobs=$((active_jobs + 1))
        if [ "$active_jobs" -ge "$MAX_JOBS" ]; then
            wait
            active_jobs=0
        fi
    done
    wait

    # Trim per pid. A pid's prefix never collides with another's because
    # the leading number is unique per process for the OS lifetime of that
    # process; once a pid is reused later the new run gets its own samples.
    for prefix in $(/bin/ls "$OUT_DIR" 2>/dev/null | /usr/bin/awk -F- '{print $1}' | /usr/bin/sort -u); do
        trim_pid "$prefix"
    done

    sleep "$INTERVAL"
done
