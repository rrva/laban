#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

fail() {
  printf 'check-boundaries failed: %s\n' "$1" >&2
  exit 1
}

matches() {
  pattern=$1
  shift
  find "$@" -type f \( -name '*.swift' -o -name '*.c' -o -name '*.h' \) -print0 \
    | xargs -0 grep -nE "$pattern" 2>/dev/null || true
}

assert_no_matches() {
  description=$1
  pattern=$2
  shift 2
  found=$(matches "$pattern" "$@")
  if [ -n "$found" ]; then
    printf '%s\n%s\n' "$description" "$found" >&2
    fail "$description"
  fi
}

assert_no_matches \
  "terminal core must stay behind the C/libghostty boundary" \
  '(^import (AppKit|CoreGraphics|Foundation|Laban(App|Core|Debug|Renderer))$|#include <(AppKit|CoreGraphics|Foundation|Metal|QuartzCore)/|Laban(App|Core|Debug|Renderer))' \
  Sources/LabanTerminalCore

assert_no_matches \
  "renderer must not depend on app, debug, core, or terminal-core modules" \
  '^import (AppKit|LabanApp|LabanCore|LabanDebug|LabanTerminalCore)$' \
  Sources/LabanRenderer

assert_no_matches \
  "core must not depend on AppKit, app, or debug modules" \
  '^import (AppKit|LabanApp|LabanDebug)$' \
  Sources/LabanCore

assert_no_matches \
  "debug runtime must not depend on AppKit or the app module" \
  '^import (AppKit|LabanApp)$' \
  Sources/LabanDebug

assert_no_matches \
  "headless agent must stay AppKit-free" \
  '^import AppKit$' \
  Sources/LabanAgent

printf 'check-boundaries passed\n'
