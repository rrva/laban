#!/usr/bin/env bash
set -euo pipefail

app=${LABAN_APP_PATH:-"$HOME/Laban.app"}
log=${LABAN_RESTART_LOG:-/tmp/laban-restart-open.log}

usage() {
  cat >&2 <<'EOF'
Usage: scripts/restart-app [APP_ARG ...]

Restarts the installed Laban.app using the same ordering as the app menu:
submit a launchd helper first, terminate the current app, then have the helper
wait for the old pid to exit before running open.

Examples:
  scripts/restart-app --scroll-debug
  scripts/restart-app --scroll-debug=8788

Environment:
  LABAN_APP_PATH      app bundle path (default: ~/Laban.app)
  LABAN_RESTART_LOG  helper stdout/stderr (default: /tmp/laban-restart-open.log)
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ ! -d "$app" ]]; then
  printf 'restart-app: app bundle not found: %s\n' "$app" >&2
  exit 1
fi

# Bash 3.2 (the system bash this runs under) treats "${arr[@]}" on an empty
# array as an unbound variable under `set -u`, so every expansion below uses
# the ${arr[@]+...} guard to expand to nothing when no app args were passed.
open_args=()
if [[ $# -gt 0 ]]; then
  open_args=(--args "$@")
fi

binary="$app/Contents/MacOS/LabanApp"
old_pid=$(pgrep -f "$binary" | head -n 1 || true)
if [[ -z "$old_pid" ]]; then
  exec /usr/bin/open "$app" ${open_args[@]+"${open_args[@]}"}
fi

while IFS= read -r stale_label; do
  [[ -n "$stale_label" ]] || continue
  /bin/launchctl remove "$stale_label" 2>/dev/null || true
done < <(/bin/launchctl list | /usr/bin/awk '/com\.rrva\.laban\.restart\./ {print $3}')

label="com.rrva.laban.restart.${old_pid}.$$"
helper_script='
label=$1
old_pid=$2
app_path=$3
shift 3
n=0
while /bin/kill -0 "$old_pid" 2>/dev/null && [ "$n" -lt 100 ]; do
  /bin/sleep 0.1
  n=$((n+1))
done
/usr/bin/open "$app_path" "$@"
status=$?
/bin/launchctl remove "$label" >/dev/null 2>&1 || true
exit "$status"
'

/bin/launchctl submit -l "$label" -o "$log" -e "$log" -- \
  /bin/sh -c "$helper_script" sh "$label" "$old_pid" "$app" ${open_args[@]+"${open_args[@]}"}

/bin/kill "$old_pid" 2>/dev/null || true
printf 'restart helper_label=%s old_pid=%s log=%s\n' "$label" "$old_pid" "$log"
