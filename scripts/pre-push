#!/usr/bin/env sh
# Fast local pre-push gate. Runs the cheap, high-signal subset of
# scripts/check so pushes stay honest without burning CI minutes (laban is a
# private repo on the free GitHub tier). The heavy formal-method gates
# (TLA+/CBMC/fuzz/coverage/e2e) are intentionally NOT here — run the full
# `scripts/check` manually before a release.
#
# Install:    scripts/install-git-hooks
# Skip once:  PRE_PUSH_SKIP=1 git push ...
# With tests: PRE_PUSH_TEST=1 git push ...   (off by default to stay fast)
set -eu

if [ "${PRE_PUSH_SKIP:-0}" = "1" ]; then
  printf 'pre-push: skipped (PRE_PUSH_SKIP=1)\n'
  exit 0
fi

# Say hi the instant the hook starts. The lint+build below can run for several
# seconds with no output, which makes a push look hung — so greet immediately
# and let the developer know Laban has the wheel.
if [ -t 2 ]; then
  printf '\033[1;35m✨ pre-push\033[0m  \033[2mLaban is preflighting your push — lint, build, the works…\033[0m\n' >&2
else
  printf 'pre-push: preflighting your push (lint, build)…\n' >&2
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

fail() {
  printf 'pre-push failed: %s\n' "$1" >&2
  printf 'pre-push: bypass once with `PRE_PUSH_SKIP=1 git push`\n' >&2
  exit 1
}

# 1. Working tree must match the commit being pushed. The gates below lint and
#    build the *working tree*, but CI runs against the *pushed commit* — so
#    uncommitted edits to tracked files can turn this hook green while CI fails
#    remotely (or vice versa). Refuse to vouch for a tree we aren't pushing.
#    Untracked files are ignored (they aren't "part of the repo" yet); staged
#    and unstaged edits to tracked files both count.
if git rev-parse --verify --quiet HEAD >/dev/null 2>&1 && ! git diff --quiet HEAD; then
  printf 'pre-push: uncommitted changes to tracked files:\n' >&2
  git diff --name-only HEAD | sed 's/^/  /' >&2
  printf 'pre-push: these are not in the commit you are pushing, so a green preflight here would not match CI.\n' >&2
  printf 'pre-push: commit or stash them, then push again.\n' >&2
  fail "working tree differs from the pushed commit"
fi

# 2. Whitespace / leftover conflict-marker errors.
git diff --check || fail "whitespace or merge-marker errors (git diff --check)"

# 3. AGENTS.md stays map-sized — the scripts/check gate, caught locally.
if [ -f AGENTS.md ]; then
  agents_lines=$(wc -l < AGENTS.md | tr -d ' ')
  if [ "$agents_lines" -gt 150 ]; then
    fail "AGENTS.md should stay map-sized; found ${agents_lines} lines"
  fi
fi

if [ -f Package.swift ]; then
  # 4. swift-format lint (fast). On failure, hand over the one-liner that fixes
  #    it in place so the developer isn't left guessing.
  if ! ./scripts/lint; then
    printf 'pre-push: lint failures are auto-fixable — run:\n' >&2
    printf '    ./scripts/format        # swift format --in-place over Sources Tests\n' >&2
    printf 'pre-push: then review, commit, and push again.\n' >&2
    fail "swift-format lint"
  fi

  # 5. Build. Ensure the vendored VT header is present first (no-op once built).
  if [ ! -f .external/libghostty-vt/zig-out/include/ghostty/vt.h ]; then
    ./scripts/fetch-libghostty-vt || fail "fetch-libghostty-vt"
  fi
  swift build || fail "swift build"

  # 6. Tests are opt-in: the stress/fuzz suites are slow, so keep the default
  #    push fast and run them on request.
  if [ "${PRE_PUSH_TEST:-0}" = "1" ]; then
    swift test || fail "swift test"
  fi
fi

printf 'pre-push: fast gates passed\n'
