#!/usr/bin/env python3
"""Mutation-test the labpty CBMC proofs (byte-ring + frame/control-channel wire).

check-cbmc proves the byte-ring write arithmetic and the frame decoders
memory-safe, and that each *_negctl harness (one removed guard) FAILS. That
shows the proofs pass and catch the hand-picked regressions — but not that they
catch ARBITRARY faults in the same code. This script answers that, the DO-178C
way: it injects a fault into the real byte-ring / frame source, reruns the CBMC
proof against the mutated source, and asserts CBMC now finds a counter-example
(VERIFICATION FAILED). A surviving mutant — a fault CBMC still proves safe — is
a gap: the proof's harness or property does not constrain that code.

This is a deep/adversarial check (a CBMC run per mutant), not part of the fast
`scripts/check`; run it manually or in deep CI. It self-skips when cbmc is
absent (the same degradation as scripts/check-cbmc).

    scripts/check-cbmc-mutants
"""
import os
import shutil
import subprocess
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(REPO)

PROOFS = os.path.join(REPO, "proofs/labpty")
# Memory-safety + UB checks, matching scripts/check-cbmc.
CHECKS = ["--bounds-check", "--pointer-check", "--pointer-primitive-check",
          "--signed-overflow-check", "--pointer-overflow-check",
          "--undefined-shift-check", "--div-by-zero-check"]

# Each mutant injects a fault into the byte-ring or frame code; the named CBMC
# proof must then FAIL. The faults are distinct from the *_negctl harnesses
# (which remove the byte-ring clamp / a decode guard) so they probe other
# aspects of the same proofs.
#
# Targeting note: the byte-ring proof verifies MEMORY SAFETY + the offset
# contract, not byte placement (placement is LabptyByteRing.tla's NoTornRead),
# so byte-ring mutations must be memory-safety faults. The frame bounds funnel
# (require_read / read_bytes) is redundant defense-in-depth inside decode_header
# (end = bytes+24, guarded by len >= 24) and decode_write_input (its own length
# check, no read_bytes); it is LOAD-BEARING only where end = bytes+len, i.e.
# read_string — so frame-funnel mutations are tested against proof_read_string.
MUTANTS = [
    dict(file="Sources/Labpty/labpty_byte_ring.c", harness="ring_proof.c",
         fn="proof_byte_ring_write", unwind="4",
         label="byte-ring: wrap split length underflows (huge memcpy)",
         old="first = (size_t)(writer->output_capacity - pos)",
         new="first = (size_t)(pos - writer->output_capacity)"),
    dict(file="Sources/Labpty/labpty_byte_ring.c", harness="ring_proof.c",
         fn="proof_byte_ring_write", unwind="4",
         label="byte-ring: wrap split boundary off by one",
         old="pos + retained > writer->output_capacity) first",
         new="pos + retained > writer->output_capacity + 1) first"),
    dict(file="Sources/Labpty/labpty_frame.c", harness="frame_proof.c",
         fn="proof_read_string", unwind="16",
         label="frame: require_read bound off by one (reads one byte past end)",
         old="(reader->end - reader->cur) < n) return",
         new="(reader->end - reader->cur) < n - 1) return"),
    dict(file="Sources/Labpty/labpty_frame.c", harness="frame_proof.c",
         fn="proof_read_string", unwind="16",
         label="frame: read_bytes skips its bounds check",
         old="require_read(reader, n)",
         new="require_read(reader, 0)"),
]


def cbmc_ok():
    return shutil.which("cbmc") is not None


def run_mutant(m, work):
    mdir = tempfile.mkdtemp(dir=work)
    base = os.path.basename(m["file"])
    src = open(m["file"]).read()
    if m["old"] not in src:
        return ("ERROR", "mutation target string not found")
    mutated = src.replace(m["old"], m["new"])
    if mutated == src:
        return ("ERROR", "mutation did not change the source")
    open(os.path.join(mdir, base), "w").write(mutated)

    cmd = ["cbmc", os.path.join(PROOFS, m["harness"]), "-DLABPTY_CBMC",
           "-I", mdir, "-I", os.path.join(REPO, "Sources/Labpty"),
           "-I", os.path.join(PROOFS, "stubs"),
           "--function", m["fn"], "--unwind", m["unwind"],
           "--unwinding-assertions"] + CHECKS + ["--drop-unused-functions"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    except subprocess.TimeoutExpired:
        return ("ERROR", "cbmc timed out")
    out = r.stdout + r.stderr
    if "VERIFICATION FAILED" in out:
        return ("CAUGHT", "")
    if "VERIFICATION SUCCESSFUL" in out:
        return ("SURVIVED", "")
    return ("ERROR", "no CBMC verdict:\n" + out[-600:])


def main():
    if not cbmc_ok():
        print("check-cbmc-mutants: cbmc not found; skipping "
              "(mutation testing needs cbmc — brew install cbmc)")
        return 0
    work = tempfile.mkdtemp(prefix="cbmc-mutants-")
    print(f"check-cbmc-mutants: injecting {len(MUTANTS)} faults; each must be "
          f"caught by the CBMC proof")
    survivors = 0
    try:
        for m in MUTANTS:
            verdict, detail = run_mutant(m, work)
            mark = {"CAUGHT": "OK", "SURVIVED": "SURVIVED", "ERROR": "ERROR"}[verdict]
            print(f"  {m['label']:58} {mark}")
            if verdict != "CAUGHT":
                survivors += 1
                if detail:
                    print("    " + detail.replace("\n", "\n    "))
    finally:
        shutil.rmtree(work, ignore_errors=True)

    if survivors:
        print(f"check-cbmc-mutants: {survivors} mutant(s) SURVIVED — a CBMC proof "
              f"does not constrain that code", file=sys.stderr)
        return 1
    print(f"check-cbmc-mutants: all {len(MUTANTS)} injected faults caught — the "
          f"byte-ring and frame proofs discriminate")
    return 0


if __name__ == "__main__":
    sys.exit(main())
