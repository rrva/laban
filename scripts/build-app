#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

# Stamp the app bundle with the current git revision and date so every log
# line and bug report can be traced to a known commit.
sha=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
dirty=$(
  git diff --quiet 2>/dev/null && echo "" || echo "+dirty"
)
date=$(date -u +%Y-%m-%dT%H:%M:%SZ)
app_version=${LABAN_APP_VERSION:-0.0.0}
build_number=${LABAN_BUILD_NUMBER:-0}
update_manifest_url=${LABAN_UPDATE_MANIFEST_URL:-}
build_config=${LABAN_BUILD_CONFIG:-debug}

# --profile produces an Instruments-friendly .app: release config with
# unstripped N_OSO debug-map entries kept intact and a .dSYM emitted next
# to the bundle. The output retains absolute /Users/... paths in the
# binary, so it must not be distributed.
profile_build=0
for arg in "$@"; do
  case "$arg" in
    --profile)
      profile_build=1
      build_config=release
      ;;
    *)
      printf 'build-app: unknown argument: %s\n' "$arg" >&2
      exit 2
      ;;
  esac
done

xml_escape() {
  printf '%s' "$1" |
    sed \
      -e 's/&/\&amp;/g' \
      -e 's/</\&lt;/g' \
      -e 's/>/\&gt;/g' \
      -e 's/"/\&quot;/g' \
      -e "s/'/\\&apos;/g"
}

update_manifest_plist=""
if [ -n "$update_manifest_url" ]; then
  update_manifest_plist="    <key>LABANUpdateManifestURL</key>
    <string>$(xml_escape "$update_manifest_url")</string>"
fi

# Scrub absolute build-host paths from anything compiled into the binary:
#   - DWARF source paths and N_OSO debug-map entries get rewritten via
#     -debug-prefix-map / -file-prefix-map so distributed builds do not
#     embed `/Users/<name>/...` references to the build machine.
#   - Without these, even a release .app exposes the developer's home
#     directory layout to anyone running `strings` on the binary.
prefix_map_flags=" \
  -Xswiftc -debug-prefix-map -Xswiftc ${repo_root}=. \
  -Xswiftc -file-prefix-map -Xswiftc ${repo_root}=. \
  -Xcc -fdebug-prefix-map=${repo_root}=. \
  -Xcc -ffile-prefix-map=${repo_root}=."

# SwiftPM's `--product` option is last-wins on a single command line
# (Swift 6.3.3), so it cannot select the five app-bundle executables at
# once. An unqualified build does select every package product in one
# planner invocation. That avoids reparsing and replanning the package
# five times on every local install; the required-product check below
# remains the guard against a future manifest/toolchain change silently
# omitting an app helper.
# Building an installable bundle never needs editor index data. Explicitly
# disable the index store so an IDE/indexing process cannot make this packaging
# path compile index-only dependency work or contend for `.build`.
# shellcheck disable=SC2086
swift build -c "$build_config" --disable-index-store $prefix_map_flags

app_bundle=".build/laban/Laban.app"
bundle_dir="${app_bundle}/Contents"
mkdir -p "${bundle_dir}/MacOS" "${bundle_dir}/Resources"

# shellcheck disable=SC2086
bin=$(swift build -c "$build_config" --disable-index-store --product LabanApp --show-bin-path $prefix_map_flags)

# Assert every bundled product actually built. `swift build` has at times exited
# 0 while leaving one product unlinked (partial cache hits, planner races,
# stale incremental state inheriting an older module signature). Without
# this guard the next `cp` would print a one-line "No such file or
# directory" error and any tooling that swallows stderr (or any operator
# who skims the tail) could mistake a partial build for a successful one.
# A real example shipped: a release build silently dead-stripped
# `terminalBackendMenu` because the cache held a pre-refactor signature
# and `swift build` linked from cache without recompiling MenuCommands.
missing=""
for product in LabanApp laban-agent laband labpty laban; do
  if [ ! -x "$bin/$product" ]; then
    missing="${missing} $bin/$product"
  fi
done
if [ -n "$missing" ]; then
  printf 'build-app failed: swift build exited 0 but produced no binary for:%s\n' \
    "$missing" >&2
  printf 'build-app failed: rerun with --verbose, or `rm -rf .build` to recover\n' >&2
  exit 1
fi

cp -f "$bin/LabanApp" "${bundle_dir}/MacOS/LabanApp"
cp -f "$bin/laban-agent" "${bundle_dir}/MacOS/laban-agent"
cp -f "$bin/laband" "${bundle_dir}/MacOS/laband"
cp -f "$bin/labpty" "${bundle_dir}/MacOS/labpty"
cp -f "$bin/laban" "${bundle_dir}/MacOS/laban"

# Post-cp sanity: the destinations must be present, non-empty, and
# executable. Catches a stale or zero-byte source the existence check
# above couldn't, and any cp that silently no-ops.
for product in LabanApp laban-agent laband labpty laban; do
  dest="${bundle_dir}/MacOS/${product}"
  if [ ! -s "$dest" ] || [ ! -x "$dest" ]; then
    printf 'build-app failed: %s missing, empty, or non-executable\n' \
      "$dest" >&2
    exit 1
  fi
done

# Copy app icon into bundle
icon="Sources/LabanApp/Resources/AppIcon.icns"
if [ -f "$icon" ]; then
  cp -f "$icon" "${bundle_dir}/Resources/AppIcon.icns"
fi

# Copy SwiftPM-emitted resource bundles next to the binary into the
# .app's Contents/Resources/. LabanRenderer locates them via
# LabanRendererResources (Bundle.main.resourceURL is checked first), so
# the standard macOS layout is what makes a distributed .app stand on
# its own.
for b in "$bin"/*.bundle; do
  [ -d "$b" ] || continue
  rm -rf "${bundle_dir}/Resources/$(basename "$b")"
  cp -R "$b" "${bundle_dir}/Resources/"
done

cat > "${bundle_dir}/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.laban.LabanApp</string>
    <key>CFBundleExecutable</key>
    <string>LabanApp</string>
    <key>CFBundleName</key>
    <string>Laban</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
        <string>ja</string>
        <string>ko</string>
        <string>fr</string>
        <string>es</string>
        <string>hi</string>
        <string>ru</string>
        <string>de</string>
        <string>pt-BR</string>
        <string>it</string>
    </array>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(xml_escape "$app_version")</string>
    <key>CFBundleVersion</key>
    <string>$(xml_escape "$build_number")</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>LABANBuildCommit</key>
    <string>${sha}${dirty}</string>
    <key>LABANBuildDate</key>
    <string>${date}</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Ragnar Rova</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.laban.LabanApp.remote-shell</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>ssh</string>
                <string>telnet</string>
            </array>
        </dict>
    </array>
${update_manifest_plist}
</dict>
</plist>
EOF

if [ "$profile_build" = 1 ]; then
  # Emit a dSYM from the per-object .o files referenced by N_OSO entries
  # so Instruments can resolve line numbers and inline frames. The dSYM
  # lives next to the .app; Spotlight indexes it and Instruments finds it
  # by UUID. Must run before any post-link byte mutation.
  dsymutil -o "${app_bundle}.dSYM" "${bundle_dir}/MacOS/LabanApp"
else
  # Strip DWARF debug sections and STAB symbols (N_OSO entries that point
  # at the per-object .o files under /Users/<name>/.../.build/...). Function
  # symbols stay so crash reports still symbolicate.
  strip -S "${bundle_dir}/MacOS/LabanApp"
  strip -S "${bundle_dir}/MacOS/laban-agent"
  strip -S "${bundle_dir}/MacOS/laband"
  strip -S "${bundle_dir}/MacOS/labpty"
  strip -S "${bundle_dir}/MacOS/laban"
fi

# SwiftPM's auto-generated `Bundle.module` accessors and native dependencies can
# compile absolute build-host paths as string literals. Prefix-map flags do not
# rewrite string literals, so replace forbidden local path bytes in-place with
# NULs before signing. Skipped for --profile builds because the same scrub
# zeroes N_OSO debug-map paths that Instruments needs.
if [ "$profile_build" = 0 ]; then
python3 - "${bundle_dir}/MacOS/LabanApp" "${bundle_dir}/MacOS/laban-agent" "${bundle_dir}/MacOS/laband" "${bundle_dir}/MacOS/labpty" "${bundle_dir}/MacOS/laban" <<'PY'
import re, sys
patterns = [
    re.compile(rb"/Users/[^\x00]*"),
    re.compile(rb"/private/var/folders/[^\x00]*"),
]
for path in sys.argv[1:]:
    with open(path, "rb") as f:
        data = f.read()
    new = data
    for pattern in patterns:
        new = pattern.sub(lambda m: b"\x00" * len(m.group(0)), new)
    if new != data:
        with open(path, "wb") as f:
            f.write(new)
PY

# Final guard: refuse to produce a .app that still mentions a home
# directory or a hard-coded developer identity. New regressions get
# caught here before the bundle is signed or zipped.
verify_clean() {
  for bin_path in "${bundle_dir}/MacOS/LabanApp" "${bundle_dir}/MacOS/laban-agent" "${bundle_dir}/MacOS/laband" "${bundle_dir}/MacOS/labpty" "${bundle_dir}/MacOS/laban"; do
    matches=$(LC_ALL=C strings -a "$bin_path" |
      grep -E '/Users/|Ragnar Rova|U34QC433V8|/private/var/folders/' || true)
    if [ -n "$matches" ]; then
      printf 'build-app failed: identifying strings remain in %s:\n' "$bin_path" >&2
      printf '%s\n' "$matches" | head -20 >&2
      exit 1
    fi
  done
}
verify_clean
fi

verify_signature() {
  if ! codesign --verify --verbose=4 "$app_bundle" >/dev/null 2>&1; then
    printf 'build-app failed: codesign verification failed for %s\n' "$app_bundle" >&2
    exit 1
  fi
}

# Sign after every post-link binary mutation. SwiftPM emits an ad-hoc signed
# executable on Apple Silicon; strip and the absolute-path scrubber change the
# bytes covered by that signature, so the bundle must be signed again before
# dyld can load it.
if [ "${LABAN_SKIP_CODESIGN:-0}" = "1" ]; then
  printf 'build-app: codesign skipped (LABAN_SKIP_CODESIGN=1; output may not launch)\n'
elif [ -n "${LABAN_CODESIGN_IDENTITY:-}" ]; then
  codesign --force --sign "$LABAN_CODESIGN_IDENTITY" "${bundle_dir}/MacOS/laban-agent"
  codesign --force --sign "$LABAN_CODESIGN_IDENTITY" "${bundle_dir}/MacOS/laband"
  codesign --force --sign "$LABAN_CODESIGN_IDENTITY" "${bundle_dir}/MacOS/labpty"
  codesign --force --sign "$LABAN_CODESIGN_IDENTITY" "${bundle_dir}/MacOS/laban"
  codesign --force --sign "$LABAN_CODESIGN_IDENTITY" "${bundle_dir}/MacOS/LabanApp"
  codesign --force --sign "$LABAN_CODESIGN_IDENTITY" "$app_bundle"
  verify_signature
  printf 'build-app: codesigned with %s\n' "$LABAN_CODESIGN_IDENTITY"
else
  codesign --force --sign - "${bundle_dir}/MacOS/laban-agent"
  codesign --force --sign - "${bundle_dir}/MacOS/laband"
  codesign --force --sign - "${bundle_dir}/MacOS/labpty"
  codesign --force --sign - "${bundle_dir}/MacOS/laban"
  codesign --force --sign - "${bundle_dir}/MacOS/LabanApp"
  codesign --force --sign - "$app_bundle"
  verify_signature
  printf 'build-app: codesigned ad-hoc\n'
fi

if [ "$profile_build" = 1 ]; then
  printf 'build-app: %s (profile build, do not distribute)\n' "${bundle_dir}/MacOS/LabanApp"
  printf 'build-app: dSYM at %s.dSYM\n' "$app_bundle"
else
  printf 'build-app: %s\n' "${bundle_dir}/MacOS/LabanApp"
fi
