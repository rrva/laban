#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

# Stamp the build with the current git revision and date so every log
# line and bug report can be traced to a known commit.
sha=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
# Exclude the auto-generated stamp itself from the dirty check —
# otherwise the previous build's stamp makes every subsequent build
# look "+dirty" forever, even on an otherwise-clean tree.
dirty=$(
  git diff --quiet -- ':!Sources/LabanApp/BuildInfo.generated.swift' 2>/dev/null \
    && echo "" || echo "+dirty"
)
date=$(date -u +%Y-%m-%dT%H:%M:%SZ)
gen="Sources/LabanApp/BuildInfo.generated.swift"
cat > "$gen" <<EOF
// Generated by scripts/build-app — do not edit by hand.
enum BuildInfo {
  static let commit = "${sha}${dirty}"
  static let date = "${date}"
  static var summary: String { "laban \(commit) (\(date))" }
}
EOF

swift build --product LabanApp

bundle_dir=".build/laban/Laban.app/Contents"
mkdir -p "${bundle_dir}/MacOS" "${bundle_dir}/Resources"

exe=$(swift build --product LabanApp --show-bin-path)/LabanApp
cp -f "$exe" "${bundle_dir}/MacOS/LabanApp"

# Copy app icon into bundle
icon="Sources/LabanApp/Resources/AppIcon.icns"
if [ -f "$icon" ]; then
  cp -f "$icon" "${bundle_dir}/Resources/AppIcon.icns"
fi

cat > "${bundle_dir}/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.laban.LabanApp</string>
    <key>CFBundleExecutable</key>
    <string>LabanApp</string>
    <key>CFBundleName</key>
    <string>Laban</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
</dict>
</plist>
EOF

# Sign with personal Apple Development certificate so TCC grants survive rebuilds.
# Smoke checks can opt out because they execute the binary directly and must not
# hang on keychain UI in a non-interactive agent run.
if [ "${LABAN_SKIP_CODESIGN:-0}" = "1" ]; then
  printf 'build-app: codesign skipped\n'
else
  codesign --force --sign "Apple Development: Ragnar Rova (U34QC433V8)" ".build/laban/Laban.app"
fi

printf 'build-app: %s\n' "${bundle_dir}/MacOS/LabanApp"
