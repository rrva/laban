#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

# Stamp the app bundle with the current git revision and date so every log
# line and bug report can be traced to a known commit.
sha=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
dirty=$(
  git diff --quiet 2>/dev/null && echo "" || echo "+dirty"
)
date=$(date -u +%Y-%m-%dT%H:%M:%SZ)
app_version=${LABAN_APP_VERSION:-0.0.0}
build_number=${LABAN_BUILD_NUMBER:-0}
update_manifest_url=${LABAN_UPDATE_MANIFEST_URL:-}

xml_escape() {
  printf '%s' "$1" |
    sed \
      -e 's/&/\&amp;/g' \
      -e 's/</\&lt;/g' \
      -e 's/>/\&gt;/g' \
      -e 's/"/\&quot;/g' \
      -e "s/'/\\&apos;/g"
}

update_manifest_plist=""
if [ -n "$update_manifest_url" ]; then
  update_manifest_plist="    <key>LABANUpdateManifestURL</key>
    <string>$(xml_escape "$update_manifest_url")</string>"
fi

swift build --product LabanApp

bundle_dir=".build/laban/Laban.app/Contents"
mkdir -p "${bundle_dir}/MacOS" "${bundle_dir}/Resources"

bin=$(swift build --product LabanApp --show-bin-path)
cp -f "$bin/LabanApp" "${bundle_dir}/MacOS/LabanApp"

# Copy app icon into bundle
icon="Sources/LabanApp/Resources/AppIcon.icns"
if [ -f "$icon" ]; then
  cp -f "$icon" "${bundle_dir}/Resources/AppIcon.icns"
fi

# Copy SwiftPM-emitted resource bundles next to the binary into the
# .app's Resources/. Without this, `Bundle.module` (used by FontAtlas
# for JetBrainsMono and by MetalRenderer for Shaders.metal) calls
# `_assertionFailure` at first reference because Bundle.main can't find
# the .bundle resource directory at the .app's resource path. On the dev
# machine it happens to work because Bundle's fallback search rooted at
# the build directory still hits the bundles; copy them properly so the
# .app stands on its own when distributed.
for b in "$bin"/*.bundle; do
  [ -d "$b" ] || continue
  rm -rf "${bundle_dir}/Resources/$(basename "$b")"
  cp -R "$b" "${bundle_dir}/Resources/"
done

cat > "${bundle_dir}/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.laban.LabanApp</string>
    <key>CFBundleExecutable</key>
    <string>LabanApp</string>
    <key>CFBundleName</key>
    <string>Laban</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(xml_escape "$app_version")</string>
    <key>CFBundleVersion</key>
    <string>$(xml_escape "$build_number")</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LABANBuildCommit</key>
    <string>${sha}${dirty}</string>
    <key>LABANBuildDate</key>
    <string>${date}</string>
${update_manifest_plist}
</dict>
</plist>
EOF

# Sign with personal Apple Development certificate so TCC grants survive rebuilds.
# Smoke checks can opt out because they execute the binary directly and must not
# hang on keychain UI in a non-interactive agent run.
if [ "${LABAN_SKIP_CODESIGN:-0}" = "1" ]; then
  printf 'build-app: codesign skipped\n'
else
  codesign --force --sign "Apple Development: Ragnar Rova (U34QC433V8)" ".build/laban/Laban.app"
fi

printf 'build-app: %s\n' "${bundle_dir}/MacOS/LabanApp"
