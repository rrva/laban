#!/usr/bin/env bash
# Profile Laban smooth-scroll JANK across renderer / smooth-scroll configs by
# driving sub-cell scroll bursts over HTTP and reading the app's own display-link
# frame-interval statistics (mean/p50/p95/p99/stddev + long-frame count). This is
# the renderer-independent jank metric the SOTA guidance calls for (frame-interval
# VARIANCE, not average FPS) and needs no Instruments/xctrace/HUD capture — those
# all proved flaky for custom signposts and cross-architecture comparison.
#
# PREREQUISITE: launch Laban yourself with the scroll-debug server enabled:
#   open ~/Laban.app --args --scroll-debug
# This script never launches the app (single-instance ghost risk).
#
# IMPORTANT: pass --tab pointing at a NORMAL-BUFFER shell tab (with scrollback),
# not a fullscreen alt-screen TUI (Claude Code / vim) — alt-screen has no
# scrollback so the burst is a no-op and measures nothing useful.
#
# Usage:
#   scripts/profile-scroll-renderers --tab N [--port 8787] [--burst-seconds 6]
#       [--voice Samantha] [--quiet]
# Speaks progress ("1 of 4, gpu-driven", ... "Profiling complete") via `say` so
# you know when to keep hands off the window; --quiet disables it.
set -euo pipefail

port=8787
burst_seconds=6
tab=""
process="Laban"
voice="Samantha"   # natural, clear English; empty string disables spoken cues

while [ $# -gt 0 ]; do
  case "$1" in
    --port) port="$2"; shift 2 ;;
    --burst-seconds) burst_seconds="$2"; shift 2 ;;
    --voice) voice="$2"; shift 2 ;;
    --quiet) voice=""; shift ;;
    --tab) tab="$2"; shift 2 ;;
    --process) process="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

base="http://127.0.0.1:${port}"

post() {
  curl -fsS -X POST "${base}$1" >/dev/null \
    || { echo "POST $1 failed — is Laban running with --scroll-debug on ${port}?" >&2; exit 1; }
}
getj() { curl -fsS "${base}$1"; }
# Spoken cue (non-blocking, never fails the run). Announces start/progress/stop so
# you know when it's safe to touch the window again.
speak() { [ -n "${voice}" ] && say -v "${voice}" "$1" >/dev/null 2>&1 & }

if ! curl -fsS "${base}/scroll/state" >/dev/null 2>&1; then
  echo "scroll-debug server not reachable at ${base}." >&2
  echo "Launch Laban with: open ~/Laban.app --args --scroll-debug" >&2
  exit 1
fi

if [ -n "${tab}" ]; then
  echo "selecting tab ${tab}" >&2
  post "/config/tab?index=${tab}"
  sleep 0.5
else
  echo "WARNING: no --tab given; measuring whatever tab is focused (alt-screen TUIs" >&2
  echo "         have no scrollback and will measure nothing). Pass --tab N." >&2
fi

# Continuous smooth-scroll burst: alternating fling so the PD controller animates
# through sub-cell offsets for the whole window (not row snaps).
burst() {
  local ticks=$(( burst_seconds * 10 ))
  for _ in $(seq 1 "$ticks"); do
    post "/scroll/smooth?rows=-3&velocity=-40"
    sleep 0.05
    post "/scroll/smooth?rows=3&velocity=40"
    sleep 0.05
  done
}

total=4
measure_config() {
  local step="$1"; local label="$2"; shift 2
  echo "  [${step}/${total}] ${label}" >&2
  speak "${step} of ${total}. ${label}."
  "$@"                  # apply config (renderer/mode switch)
  sleep 0.4             # let the switch settle + first frames render
  getj "/scroll/frame-stats?reset=1" >/dev/null   # clear the ring
  burst                 # scroll for burst_seconds, filling the ring
  sleep 0.2
  # Compact the (pretty-printed) JSON to one line so it survives the tab-delimited
  # results capture and the line-oriented reader below.
  local stats
  stats=$(getj "/scroll/frame-stats" | python3 -c 'import sys,json; print(json.dumps(json.load(sys.stdin)))')
  printf '%s\t%s\n' "${label}" "${stats}"
}

set_renderer() { post "/config/renderer?name=$1"; }
set_vector_mode() { post "/config/renderer?name=vectorGlyph"; post "/config/smooth-scroll?mode=$1"; }

echo "measuring (tab ${tab:-focused}, ${burst_seconds}s burst per config)..." >&2
speak "Profiling start. Hands off the Laban window."

results=$(
  measure_config 1 "gpu-driven"   set_renderer gpuDriven
  measure_config 2 "vector-fluid" set_vector_mode fluid
  measure_config 3 "vector-crisp" set_vector_mode perPhase
  measure_config 4 "classic"      set_renderer classic
)
speak "Profiling complete. You can use the window now."

echo >&2
echo "=== smooth-scroll jank (frame-interval ms; lower stddev/jank = smoother) ===" >&2
printf "%-14s %6s %7s %7s %7s %7s %7s %6s\n" \
  config fps meanMs p50 p95 p99 stddev jank% >&2
while IFS=$'\t' read -r label json; do
  [ -n "${label}" ] || continue
  echo "${json}" | python3 -c "
import sys, json
d = json.load(sys.stdin)
def g(k):
    v = d.get(k, 0)
    return f'{v:.2f}' if isinstance(v, (int, float)) else str(v)
print('%-14s %6s %7s %7s %7s %7s %7s %6s' % (
    '${label}', g('fps'), g('meanMs'), g('p50Ms'), g('p95Ms'),
    g('p99Ms'), g('stddevMs'), g('jankPercent')))
" >&2
done <<< "${results}"
