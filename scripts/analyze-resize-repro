#!/usr/bin/env python3
"""Analyze AppKit resize probe screenshots for obvious paint gaps."""

from __future__ import annotations

import argparse
import json
import shutil
import struct
import subprocess
import sys
import zlib
from pathlib import Path
from typing import Any


def pixel_metrics(width: int, height: int, channels: int, pixels: bytes | bytearray) -> dict[str, int | float]:
    stride = width * channels
    top_limit = min(3, height)
    top_white = 0
    near_black_pixels = 0
    for row_index in range(height):
        row_start = row_index * stride
        row_end = row_start + stride
        for offset in range(row_start, row_end, channels):
            r = pixels[offset]
            g = pixels[offset + 1]
            b = pixels[offset + 2]
            if r <= 35 and g <= 35 and b <= 35:
                near_black_pixels += 1
            if (
                row_index < top_limit
                and r >= 250
                and g >= 250
                and b >= 250
                and abs(r - g) <= 5
                and abs(r - b) <= 5
                and abs(g - b) <= 5
            ):
                top_white += 1

    top_pixels = width * top_limit
    total_pixels = width * height
    return {
        "width": width,
        "height": height,
        "topWhitePixels": top_white,
        "topWhiteRatio": top_white / max(1, top_pixels),
        "nearBlackPixels": near_black_pixels,
        "nearBlackRatio": near_black_pixels / max(1, total_pixels),
    }


def analyze_png_with_magick(path: Path, width: int, height: int) -> dict[str, int | float] | None:
    magick = shutil.which("magick")
    if magick is None:
        return None
    try:
        proc = subprocess.run(
            [magick, str(path), "-alpha", "off", "-depth", "8", "rgb:-"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    expected = width * height * 3
    if len(proc.stdout) != expected:
        return None
    return pixel_metrics(width, height, 3, proc.stdout)


def analyze_png(path: Path) -> dict[str, int | float]:
    raw = path.read_bytes()
    if raw[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError(f"{path} is not a PNG")
    pos = 8
    width = height = color_type = None
    idat: list[bytes] = []
    while pos < len(raw):
        size = struct.unpack(">I", raw[pos : pos + 4])[0]
        pos += 4
        kind = raw[pos : pos + 4]
        pos += 4
        data = raw[pos : pos + size]
        pos += size + 4
        if kind == b"IHDR":
            width, height, bit_depth, color_type, comp, filt, interlace = struct.unpack(
                ">IIBBBBB", data
            )
            if bit_depth != 8 or comp != 0 or filt != 0 or interlace != 0:
                raise ValueError(f"unsupported PNG format in {path}")
        elif kind == b"IDAT":
            idat.append(data)
        elif kind == b"IEND":
            break
    if width is None or height is None or color_type is None:
        raise ValueError(f"{path} has no IHDR")
    channels = {2: 3, 6: 4}.get(color_type)
    if channels is None:
        raise ValueError(f"unsupported PNG color type {color_type} in {path}")
    if magick_result := analyze_png_with_magick(path, width, height):
        return magick_result

    stride = width * channels
    inflated = zlib.decompress(b"".join(idat))
    prev = bytearray(stride)
    pos = 0
    pixels = bytearray(width * height * channels)
    for row_index in range(height):
        filter_type = inflated[pos]
        pos += 1
        cur = bytearray(inflated[pos : pos + stride])
        pos += stride
        if filter_type == 1:
            for i in range(channels, stride):
                cur[i] = (cur[i] + cur[i - channels]) & 255
        elif filter_type == 2:
            for i in range(stride):
                cur[i] = (cur[i] + prev[i]) & 255
        elif filter_type == 3:
            for i in range(stride):
                left = cur[i - channels] if i >= channels else 0
                cur[i] = (cur[i] + ((left + prev[i]) // 2)) & 255
        elif filter_type == 4:
            def paeth(a: int, b: int, c: int) -> int:
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                if pa <= pb and pa <= pc:
                    return a
                return b if pb <= pc else c

            for i in range(stride):
                left = cur[i - channels] if i >= channels else 0
                up = prev[i]
                up_left = prev[i - channels] if i >= channels else 0
                cur[i] = (cur[i] + paeth(left, up, up_left)) & 255
        elif filter_type != 0:
            raise ValueError(f"unsupported PNG row filter {filter_type} in {path}")

        row_start = row_index * stride
        pixels[row_start : row_start + stride] = cur
        prev = cur

    return pixel_metrics(width, height, channels, pixels)


def analyze_event(root: Path, event: dict[str, Any]) -> dict[str, Any]:
    rel = event.get("screenshotPath")
    result: dict[str, Any] = {
        "sequence": event.get("sequence"),
        "label": event.get("label"),
        "renderedFrame": event.get("renderedFrame"),
        "screenshotPath": rel,
    }
    if not rel:
        result["error"] = "missing screenshot"
        return result
    path = root / rel
    result.update(analyze_png(path))
    return result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("path", type=Path)
    parser.add_argument("--pretty", action="store_true")
    args = parser.parse_args()

    root = args.path
    probe = root / "resize-probe.ndjson"
    if args.path.is_file():
        probe = args.path
        root = args.path.parent
    events = [
        json.loads(line)
        for line in probe.read_text(encoding="utf-8").splitlines()
        if line.strip()
    ]
    frames = [analyze_event(root, event) for event in events]
    summary = {
        "path": str(args.path),
        "events": len(events),
        "screenshots": sum(1 for frame in frames if not frame.get("error")),
        "maxTopWhiteRatio": max(
            (frame.get("topWhiteRatio", 0.0) for frame in frames), default=0.0
        ),
        "maxNearBlackRatio": max(
            (frame.get("nearBlackRatio", 0.0) for frame in frames), default=0.0
        ),
        "frames": frames,
    }
    print(
        json.dumps(
            summary,
            indent=2 if args.pretty else None,
            sort_keys=True,
            ensure_ascii=False,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
