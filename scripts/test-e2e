# 31. Bare --debug-server shorthand — launches and answers health
"$AGENT_BIN" --headless --debug-server --deterministic >"$BARE_STDOUT" 2>"$BARE_STDERR" &
BARE_PID=$!
BARE_URL=""
BARE_TOKEN=""
for _i in $(seq 1 100); do
  if [ -s "$BARE_STDOUT" ]; then
    BARE_READY=$(head -1 "$BARE_STDOUT")
    BARE_URL=$(printf '%s' "$BARE_READY" | jq -r '.debugServer // empty' 2>/dev/null)
    BARE_TOKEN=$(printf '%s' "$BARE_READY" | jq -r '.debugToken // empty' 2>/dev/null)
    [ -n "$BARE_URL" ] && [ -n "$BARE_TOKEN" ] && break
  fi
  sleep 0.1
done
[ -n "$BARE_URL" ] || fail "bare --debug-server: did not receive readiness JSON"
[ -n "$BARE_TOKEN" ] || fail "bare --debug-server: readiness JSON missing debugToken"
BARE_HEALTH=$(curl_debug "$BARE_URL" "$BARE_TOKEN" /debug/health)
[ "$(printf '%s' "$BARE_HEALTH" | jq -r '.ok')" = "true" ] \
  || fail "bare --debug-server health: $BARE_HEALTH"
kill "$BARE_PID" 2>/dev/null || true
wait "$BARE_PID" 2>/dev/null || true
BARE_PID=""

