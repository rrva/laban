#!/usr/bin/env sh
# End-to-end test: launch the debug server, drive it, verify outputs, shut it down.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

fail() {
  printf 'test-e2e failed: %s\n' "$1" >&2
  if [ -n "${RUN_ARTIFACTS:-}" ]; then
    printf 'artifacts preserved at: %s\n' "$RUN_ARTIFACTS" >&2
  fi
  if [ -n "${SERVER_PID:-}" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
  fi
  if [ -n "${BARE_PID:-}" ] && kill -0 "$BARE_PID" 2>/dev/null; then
    kill "$BARE_PID" 2>/dev/null || true
  fi
  exit 1
}

require_json_field() {
  local json="$1" field="$2" label="$3"
  val=$(printf '%s' "$json" | jq -r ".$field // empty" 2>/dev/null)
  [ -n "$val" ] || fail "$label: missing field '$field' in: $json"
  printf '%s' "$val"
}

# 1. Build
swift build --product laban-agent 2>&1 | tail -5

AGENT_BIN=".build/debug/laban-agent"
[ -x "$AGENT_BIN" ] || fail "laban-agent binary not found"

HELP_OUTPUT=$("$AGENT_BIN" --help)
printf '%s' "$HELP_OUTPUT" | grep -q -- '--debug-server' \
  || fail "help output does not mention --debug-server"
printf '%s' "$HELP_OUTPUT" | grep -q 'GET  /debug/state' \
  || fail "help output does not mention GET /debug/state"
printf '%s' "$HELP_OUTPUT" | grep -q 'POST /debug/actions' \
  || fail "help output does not mention POST /debug/actions"
printf '%s' "$HELP_OUTPUT" | grep -q 'curl "$DEBUG_URL/debug"' \
  || fail "help output does not mention discovery curl"

# 2. Unique run ID and directories
RUN_ID="e2e-$(date +%s)-$$"
RUN_ARTIFACTS=".artifacts/runs/$RUN_ID"
RUN_TMP=".tmp/$RUN_ID"
SERVER_PID=""
BARE_PID=""

cleanup_success() {
  if [ -n "${SERVER_PID:-}" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  if [ -n "${BARE_PID:-}" ] && kill -0 "$BARE_PID" 2>/dev/null; then
    kill "$BARE_PID" 2>/dev/null || true
    wait "$BARE_PID" 2>/dev/null || true
  fi
  rm -rf "$RUN_ARTIFACTS" "$RUN_TMP"
}

cleanup_fail() {
  if [ -n "${SERVER_PID:-}" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  if [ -n "${BARE_PID:-}" ] && kill -0 "$BARE_PID" 2>/dev/null; then
    kill "$BARE_PID" 2>/dev/null || true
    wait "$BARE_PID" 2>/dev/null || true
  fi
  printf 'test-e2e: artifacts preserved at %s\n' "$RUN_ARTIFACTS" >&2
}

# Trap for unexpected exits — preserve artifacts
trap cleanup_fail EXIT

# 3. Launch agent
_tmp_stdout=$(mktemp)
"$AGENT_BIN" --headless \
  --fixture=fixtures/colored-boxes.fixture.json \
  --debug-server=127.0.0.1:0 \
  --artifacts="$RUN_ARTIFACTS" \
  --temp-dir="$RUN_TMP" \
  --capture=e2e-capture \
  --capture-screenshots=final \
  --deterministic \
  >"$_tmp_stdout" &
SERVER_PID=$!

# 4. Parse readiness line (wait up to 10s)
SERVER_URL=""
for _i in $(seq 1 100); do
  if [ -s "$_tmp_stdout" ]; then
    READINESS=$(head -1 "$_tmp_stdout")
    SERVER_URL=$(printf '%s' "$READINESS" | jq -r '.debugServer // empty' 2>/dev/null)
    [ -n "$SERVER_URL" ] && break
  fi
  sleep 0.1
done
rm -f "$_tmp_stdout"

[ -n "$SERVER_URL" ] || fail "did not receive readiness JSON from agent"
printf 'debug server: %s\n' "$SERVER_URL"

# Helper: curl endpoint, assert HTTP 200 and ok:true where applicable
get_json() {
  curl -sf "$SERVER_URL$1"
}

post_json() {
  curl -sf -X POST -H 'Content-Type: application/json' -d "$2" "$SERVER_URL$1"
}

# 5. /debug/health
HEALTH=$(get_json /debug/health)
[ "$(printf '%s' "$HEALTH" | jq -r '.ok')" = "true" ] || fail "health ok is not true: $HEALTH"

# 5b. /debug discovery index
DISCOVERY=$(get_json /debug)
[ "$(printf '%s' "$DISCOVERY" | jq -r '.name')" = "laban-debug" ] \
  || fail "discovery name mismatch: $DISCOVERY"
printf '%s' "$DISCOVERY" | jq -e '.entrypoints | index("/debug/capabilities")' >/dev/null 2>&1 \
  || fail "discovery missing /debug/capabilities entrypoint: $DISCOVERY"
printf '%s' "$DISCOVERY" | jq -e \
  '.endpoints[] | select(.method=="POST" and .path=="/debug/actions")' >/dev/null 2>&1 \
  || fail "discovery missing POST /debug/actions: $DISCOVERY"
printf '%s' "$DISCOVERY" | jq -e \
  '.endpoints[] | select(.method=="POST" and .path=="/debug/snapshot")' >/dev/null 2>&1 \
  || fail "discovery missing POST /debug/snapshot: $DISCOVERY"
printf '%s' "$DISCOVERY" | jq -e \
  '.endpoints[] | select(.method=="POST" and .path=="/debug/fixture")' >/dev/null 2>&1 \
  || fail "discovery missing POST /debug/fixture: $DISCOVERY"
printf '%s' "$DISCOVERY" | jq -e \
  '.actions[] | select(.name=="typeText")' >/dev/null 2>&1 \
  || fail "discovery missing typeText action: $DISCOVERY"
printf '%s' "$DISCOVERY" | jq -e \
  '.waitConditions[] | select(.name=="textVisible")' >/dev/null 2>&1 \
  || fail "discovery missing textVisible wait condition: $DISCOVERY"
printf '%s' "$DISCOVERY" | jq -e \
  '.fixtureActions[] | select(.name=="restart")' >/dev/null 2>&1 \
  || fail "discovery missing restart fixture action: $DISCOVERY"
printf '%s' "$DISCOVERY" | jq -e \
  '.examples[] | select(.command | contains("/debug/snapshot"))' >/dev/null 2>&1 \
  || fail "discovery missing snapshot example: $DISCOVERY"

CAPABILITIES=$(get_json /debug/capabilities)
[ "$(printf '%s' "$CAPABILITIES" | jq -r '.name')" = "laban-debug" ] \
  || fail "capabilities alias mismatch: $CAPABILITIES"

# 6. /debug/state — assert one active tab
STATE=$(get_json /debug/state)
TAB_COUNT=$(printf '%s' "$STATE" | jq '.tabs | length')
[ "$TAB_COUNT" -eq 1 ] || fail "expected 1 tab, got $TAB_COUNT"
FIRST_TAB_ID=$(printf '%s' "$STATE" | jq -r '.tabs[0].id')
ACTIVE_TAB_ID=$(printf '%s' "$STATE" | jq -r '.activeTabId')
[ -n "$FIRST_TAB_ID" ] || fail "first tab id is empty"
[ "$FIRST_TAB_ID" = "$ACTIVE_TAB_ID" ] || fail "first tab should be active"

# 7. /debug/wait textVisible "hello mvp"
WAIT_BODY='{"timeoutMs":5000,"condition":{"kind":"textVisible","text":"hello mvp"}}'
WAIT_RESULT=$(post_json /debug/wait "$WAIT_BODY")
[ "$(printf '%s' "$WAIT_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "wait for textVisible failed: $WAIT_RESULT"

# 8. GET /debug/screenshot — non-empty PNG
SCREENSHOT_SIZE=$(curl -sf "$SERVER_URL/debug/screenshot" | wc -c | tr -d ' ')
[ "$SCREENSHOT_SIZE" -gt 100 ] || fail "screenshot is empty (got $SCREENSHOT_SIZE bytes)"

# 9. POST /debug/screenshot — artifact PNG written
SS_RESULT=$(post_json /debug/screenshot "")
SS_PATH=$(printf '%s' "$SS_RESULT" | jq -r '.path // empty')
[ -n "$SS_PATH" ] || fail "POST screenshot missing path: $SS_RESULT"
[ -f "$SS_PATH" ] || fail "screenshot artifact not found at $SS_PATH"

# 10. /debug/frame-commands?source=terminal&limit=100 — at least one terminal command
FC=$(get_json "/debug/frame-commands?source=terminal&limit=100")
TERM_COUNT=$(printf '%s' "$FC" | jq '.commands | length')
[ "$TERM_COUNT" -gt 0 ] || fail "no terminal frame commands returned: $FC"

# 11. /debug/render
RENDER=$(get_json /debug/render)
[ "$(printf '%s' "$RENDER" | jq -r '.backend')" = "software" ] \
  || fail "render backend is not software: $RENDER"

# 12. POST /debug/render-trace — all required top-level fields present
RT=$(post_json /debug/render-trace '{}')
for _field in traceId frame backend surface sources layout packets commandRanges \
              commands resources passes pixelProbes invariants truncated; do
  printf '%s' "$RT" | jq -e "has(\"$_field\")" >/dev/null 2>&1 \
    || fail "render-trace missing field '$_field' in: $RT"
done

# 13. /debug/sessions
SESSIONS=$(get_json /debug/sessions)
SESSION_COUNT=$(printf '%s' "$SESSIONS" | jq '.sessions | length')
[ "$SESSION_COUNT" -eq 1 ] || fail "expected 1 session, got $SESSION_COUNT"
SESSION_ROWS=$(printf '%s' "$SESSIONS" | jq -r '.sessions[0].rows')
[ "$SESSION_ROWS" -ge 1 ] || fail "session rows < 1"

# 14. newTab — state should now have 2 tabs
NEW_TAB_RESULT=$(post_json /debug/actions '{"action":"newTab"}')
[ "$(printf '%s' "$NEW_TAB_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "newTab action failed: $NEW_TAB_RESULT"
STATE2=$(get_json /debug/state)
TAB_COUNT2=$(printf '%s' "$STATE2" | jq '.tabs | length')
[ "$TAB_COUNT2" -eq 2 ] || fail "expected 2 tabs after newTab, got $TAB_COUNT2"

# 15. Title metadata must bound hostile OSC titles and preserve manual titles.
LONG_TITLE_PAYLOAD=$(python3 - <<'PY'
import json
title = "A" * 600
print(json.dumps({"action": "feedOutput", "text": "\x1b]0;" + title + "\x07"}))
PY
)
LONG_TITLE_RESULT=$(post_json /debug/actions "$LONG_TITLE_PAYLOAD")
[ "$(printf '%s' "$LONG_TITLE_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "long title feedOutput failed: $LONG_TITLE_RESULT"
STATE_TITLE=$(get_json /debug/state)
ACTIVE_DISPLAY_LEN=$(printf '%s' "$STATE_TITLE" | jq '.tabs[] | select(.active == true).displayTitle | length')
ACTIVE_TERMINAL_LEN=$(printf '%s' "$STATE_TITLE" | jq '.tabs[] | select(.active == true).terminalTitle | length')
ACTIVE_TITLE_SOURCE=$(printf '%s' "$STATE_TITLE" | jq -r '.tabs[] | select(.active == true).titleSource')
[ "$ACTIVE_DISPLAY_LEN" -eq 256 ] \
  || fail "expected bounded displayTitle length 256, got $ACTIVE_DISPLAY_LEN: $STATE_TITLE"
[ "$ACTIVE_TERMINAL_LEN" -eq 256 ] \
  || fail "expected bounded terminalTitle length 256, got $ACTIVE_TERMINAL_LEN: $STATE_TITLE"
[ "$ACTIVE_TITLE_SOURCE" = "terminal" ] \
  || fail "expected terminal title source after OSC title, got $ACTIVE_TITLE_SOURCE"

MANUAL_TITLE_RESULT=$(post_json /debug/actions '{"action":"setTabTitle","title":"manual e2e task"}')
[ "$(printf '%s' "$MANUAL_TITLE_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "setTabTitle action failed: $MANUAL_TITLE_RESULT"
AFTER_MANUAL_PAYLOAD=$(python3 - <<'PY'
import json
print(json.dumps({"action": "feedOutput", "text": "\x1b]0;TerminalAfterManual\x07"}))
PY
)
AFTER_MANUAL_RESULT=$(post_json /debug/actions "$AFTER_MANUAL_PAYLOAD")
[ "$(printf '%s' "$AFTER_MANUAL_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "terminal title after manual failed: $AFTER_MANUAL_RESULT"
STATE_MANUAL=$(get_json /debug/state)
ACTIVE_DISPLAY=$(printf '%s' "$STATE_MANUAL" | jq -r '.tabs[] | select(.active == true).displayTitle')
ACTIVE_TERMINAL=$(printf '%s' "$STATE_MANUAL" | jq -r '.tabs[] | select(.active == true).terminalTitle')
ACTIVE_SOURCE=$(printf '%s' "$STATE_MANUAL" | jq -r '.tabs[] | select(.active == true).titleSource')
[ "$ACTIVE_DISPLAY" = "manual e2e task" ] \
  || fail "manual title was not preserved: $STATE_MANUAL"
[ "$ACTIVE_TERMINAL" = "TerminalAfterManual" ] \
  || fail "terminalTitle did not retain latest raw title: $STATE_MANUAL"
[ "$ACTIVE_SOURCE" = "user" ] \
  || fail "expected user title source after manual title, got $ACTIVE_SOURCE"

# 16. Coalesced long-line rendering must still land on fixed terminal cells.
LONG_LINE_PAYLOAD=$(python3 - <<'PY'
import json
print(json.dumps({"action": "typeText", "text": "\x1b[?25l" + "M" * 70}))
PY
)
LONG_LINE_RESULT=$(post_json /debug/actions "$LONG_LINE_PAYLOAD")
[ "$(printf '%s' "$LONG_LINE_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "long-line typeText failed: $LONG_LINE_RESULT"
LONG_LINE_RENDER="$RUN_ARTIFACTS/long-line-render.json"
LONG_LINE_SCREENSHOT="$RUN_ARTIFACTS/long-line.png"
get_json /debug/render >"$LONG_LINE_RENDER"
curl -sf "$SERVER_URL/debug/screenshot" >"$LONG_LINE_SCREENSHOT"
if ! python3 - "$LONG_LINE_RENDER" "$LONG_LINE_SCREENSHOT" <<'PY'
import json
import struct
import sys
import zlib

render_path, screenshot_path = sys.argv[1], sys.argv[2]
with open(render_path, "r", encoding="utf-8") as f:
    render = json.load(f)


def read_png(path):
    with open(path, "rb") as f:
        raw = f.read()
    if raw[:8] != b"\x89PNG\r\n\x1a\n":
        raise SystemExit("screenshot is not a PNG")
    pos = 8
    width = height = color_type = None
    idat = []
    while pos < len(raw):
        size = struct.unpack(">I", raw[pos : pos + 4])[0]
        pos += 4
        kind = raw[pos : pos + 4]
        pos += 4
        data = raw[pos : pos + size]
        pos += size + 4
        if kind == b"IHDR":
            width, height, bit_depth, color_type, comp, filt, interlace = struct.unpack(
                ">IIBBBBB", data
            )
            if bit_depth != 8 or comp != 0 or filt != 0 or interlace != 0:
                raise SystemExit("unsupported PNG format")
        elif kind == b"IDAT":
            idat.append(data)
        elif kind == b"IEND":
            break

    channels = {2: 3, 6: 4}.get(color_type)
    if channels is None:
        raise SystemExit("unsupported PNG color type")
    stride = width * channels
    bpp = channels
    inflated = zlib.decompress(b"".join(idat))
    rows = []
    prev = [0] * stride
    pos = 0
    for _ in range(height):
        filter_type = inflated[pos]
        pos += 1
        cur = list(inflated[pos : pos + stride])
        pos += stride
        if filter_type == 1:
            for i in range(stride):
                cur[i] = (cur[i] + (cur[i - bpp] if i >= bpp else 0)) & 255
        elif filter_type == 2:
            for i in range(stride):
                cur[i] = (cur[i] + prev[i]) & 255
        elif filter_type == 3:
            for i in range(stride):
                left = cur[i - bpp] if i >= bpp else 0
                cur[i] = (cur[i] + ((left + prev[i]) // 2)) & 255
        elif filter_type == 4:
            def paeth(a, b, c):
                p = a + b - c
                pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                if pa <= pb and pa <= pc:
                    return a
                return b if pb <= pc else c

            for i in range(stride):
                left = cur[i - bpp] if i >= bpp else 0
                up = prev[i]
                up_left = prev[i - bpp] if i >= bpp else 0
                cur[i] = (cur[i] + paeth(left, up, up_left)) & 255
        elif filter_type != 0:
            raise SystemExit("unsupported PNG row filter")
        prev = cur
        rows.append(cur)
    return width, height, channels, rows


width, height, channels, rows = read_png(screenshot_path)
viewport = render["terminalViewport"]
cell_width = int(render["cell"]["width"])
target_start = int(viewport["x"]) + 69 * cell_width
target_end = min(target_start + cell_width, width)
if target_start >= target_end:
    raise SystemExit("long-line target cell falls outside screenshot")

sample_x = min(width - 1, int(viewport["x"]) + int(viewport["width"]) - 2)
background = tuple(rows[height - 2][sample_x * channels : sample_x * channels + channels])
for row in rows:
    for x in range(target_start, target_end):
        pixel = tuple(row[x * channels : x * channels + channels])
        if pixel != background:
            raise SystemExit(0)

raise SystemExit("long-line final cell has no drawn glyph pixels")
PY
then
  fail "long-line rendering did not reach the final fixed-width terminal cell"
fi

# 16. selectTab first tab — session ID unchanged
SEL_RESULT=$(post_json /debug/actions "{\"action\":\"selectTab\",\"tabId\":\"$FIRST_TAB_ID\"}")
[ "$(printf '%s' "$SEL_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "selectTab failed: $SEL_RESULT"
STATE3=$(get_json /debug/state)
ACTIVE_NOW=$(printf '%s' "$STATE3" | jq -r '.activeTabId')
[ "$ACTIVE_NOW" = "$FIRST_TAB_ID" ] || fail "expected active tab $FIRST_TAB_ID, got $ACTIVE_NOW"

# 17. resizeWindow — sessions rows/cols still >= 1
RESIZE_RESULT=$(post_json /debug/actions '{"action":"resizeWindow","width":1000,"height":600}')
[ "$(printf '%s' "$RESIZE_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "resizeWindow failed: $RESIZE_RESULT"
SESSIONS2=$(get_json /debug/sessions)
ROWS_AFTER=$(printf '%s' "$SESSIONS2" | jq '.sessions[0].rows')
[ "$ROWS_AFTER" -ge 1 ] || fail "rows after resize < 1"

# 18. setClipboardText + paste
SET_CLIP=$(post_json /debug/actions '{"action":"setClipboardText","text":"agent text\n"}')
[ "$(printf '%s' "$SET_CLIP" | jq -r '.ok')" = "true" ] \
  || fail "setClipboardText failed: $SET_CLIP"
PASTE_RESULT=$(post_json /debug/actions '{"action":"paste"}')
[ "$(printf '%s' "$PASTE_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "paste failed: $PASTE_RESULT"

# 19. advanceFrames count:3 — frame advances by exactly 3
FRAME_BEFORE=$(get_json /debug/health | jq '.frame')
ADV_RESULT=$(post_json /debug/actions '{"action":"advanceFrames","count":3}')
[ "$(printf '%s' "$ADV_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "advanceFrames failed: $ADV_RESULT"
FRAME_AFTER=$(printf '%s' "$ADV_RESULT" | jq '.frame')
FRAME_EXPECTED=$((FRAME_BEFORE + 3))
[ "$FRAME_AFTER" -eq "$FRAME_EXPECTED" ] \
  || fail "advanceFrames: expected frame $FRAME_EXPECTED, got $FRAME_AFTER"

# 20. scrollViewport action — scroll up then reset
SCROLL1=$(post_json /debug/actions '{"action":"scrollViewport","deltaRows":-4}')
[ "$(printf '%s' "$SCROLL1" | jq -r '.ok')" = "true" ] \
  || fail "scrollViewport (up) failed: $SCROLL1"
SCROLL2=$(post_json /debug/actions '{"action":"scrollViewport","deltaRows":4}')
[ "$(printf '%s' "$SCROLL2" | jq -r '.ok')" = "true" ] \
  || fail "scrollViewport (down) failed: $SCROLL2"

# 21. mouseWheel in terminal region (normal mode) — should succeed
MWHEEL=$(post_json /debug/actions '{"action":"mouseWheel","x":300,"y":200,"deltaY":3}')
[ "$(printf '%s' "$MWHEEL" | jq -r '.ok')" = "true" ] \
  || fail "mouseWheel in terminal failed: $MWHEEL"

# 22. mouseWheel in sidebar — consumed locally, still ok:true
MWHEEL_SIDE=$(post_json /debug/actions '{"action":"mouseWheel","x":10,"y":100,"deltaY":3}')
[ "$(printf '%s' "$MWHEEL_SIDE" | jq -r '.ok')" = "true" ] \
  || fail "mouseWheel in sidebar failed: $MWHEEL_SIDE"

# 23. click without mouse tracking — sets local selection (ok:true)
CLICK_NO=$(post_json /debug/actions '{"action":"click","x":300,"y":200,"button":"left"}')
[ "$(printf '%s' "$CLICK_NO" | jq -r '.ok')" = "true" ] \
  || fail "click without mouse tracking: expected ok:true, got: $CLICK_NO"
SEL_AFTER=$(get_json /debug/selection)
[ "$(printf '%s' "$SEL_AFTER" | jq -r '.active')" = "true" ] \
  || fail "click without mouse tracking: expected selection active:true, got: $SEL_AFTER"

# 24. sidebar click — create tab then select existing
CLICK_SIDE=$(post_json /debug/actions '{"action":"click","x":10,"y":390,"button":"left"}')
[ "$(printf '%s' "$CLICK_SIDE" | jq -r '.ok')" = "true" ] \
  || fail "sidebar click failed: $CLICK_SIDE"

# 24b. setSelection + /debug/selection + copy + /debug/clipboard
# The colored-boxes fixture has "hello mvp" at row=1, col=2..col=10.
# Select first tab which has the fixture content.
SEL_TAB=$(post_json /debug/actions "{\"action\":\"selectTab\",\"tabId\":\"$FIRST_TAB_ID\"}")
[ "$(printf '%s' "$SEL_TAB" | jq -r '.ok')" = "true" ] \
  || fail "selectTab for selection test failed: $SEL_TAB"

SET_SEL=$(post_json /debug/actions \
  '{"action":"setSelection","anchor":{"row":1,"col":2},"focus":{"row":1,"col":10}}')
[ "$(printf '%s' "$SET_SEL" | jq -r '.ok')" = "true" ] \
  || fail "setSelection failed: $SET_SEL"

SEL_STATE=$(get_json /debug/selection)
[ "$(printf '%s' "$SEL_STATE" | jq -r '.active')" = "true" ] \
  || fail "selection should be active after setSelection: $SEL_STATE"
SEL_TEXT=$(printf '%s' "$SEL_STATE" | jq -r '.text')
[ "$SEL_TEXT" = "hello mvp" ] \
  || fail "selection text: expected 'hello mvp', got '$SEL_TEXT'"

COPY_RESULT=$(post_json /debug/actions '{"action":"copy"}')
[ "$(printf '%s' "$COPY_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "copy action failed: $COPY_RESULT"

CLIP=$(get_json /debug/clipboard)
CLIP_TEXT=$(printf '%s' "$CLIP" | jq -r '.lastCopyText')
[ "$CLIP_TEXT" = "hello mvp" ] \
  || fail "clipboard after copy: expected 'hello mvp', got '$CLIP_TEXT'"

# 25. /debug/events — includes server.ready and frame.rendered
# (events check already confirmed; events emitted includes server.ready from emitServerReady()
# and frame.rendered from each renderFrameUnlocked() call)
EVENTS=$(get_json /debug/events)
KINDS=$(printf '%s' "$EVENTS" | jq -r '[.events[].kind] | join(",")')
printf '%s' "$KINDS" | grep -q "server.ready" || fail "server.ready not in events: $KINDS"
printf '%s' "$KINDS" | grep -q "frame.rendered" || fail "frame.rendered not in events: $KINDS"

# 26. Keyboard input log — route assertions
KEY_ENTER=$(post_json /debug/actions '{"action":"key","key":"enter"}')
[ "$(printf '%s' "$KEY_ENTER" | jq -r '.ok')" = "true" ] \
  || fail "key enter action failed: $KEY_ENTER"

KEY_CMD_T=$(post_json /debug/actions '{"action":"key","key":"t","modifiers":["command"]}')
[ "$(printf '%s' "$KEY_CMD_T" | jq -r '.ok')" = "true" ] \
  || fail "key cmd-t action failed: $KEY_CMD_T"

INPUT_LOG=$(get_json /debug/input-log?since=0)
printf '%s' "$INPUT_LOG" | jq -e 'has("events") and has("next")' >/dev/null 2>&1 \
  || fail "input-log missing events or next: $INPUT_LOG"

# At least one key event must route to terminal
TERMINAL_KEY=$(printf '%s' "$INPUT_LOG" \
  | jq -r '[.events[] | select(.kind=="key" and .route=="terminal")] | length')
[ "$TERMINAL_KEY" -ge 1 ] \
  || fail "input-log: no key event with route=terminal: $INPUT_LOG"

# Cmd-T must log appCommand/newTab
APP_CMD_NEW_TAB=$(printf '%s' "$INPUT_LOG" \
  | jq -r '[.events[] | select(.route=="appCommand" and .command=="newTab")] | length')
[ "$APP_CMD_NEW_TAB" -ge 1 ] \
  || fail "input-log: no appCommand/newTab event: $INPUT_LOG"

# No Command key must route to terminal
CMD_TO_TERMINAL=$(printf '%s' "$INPUT_LOG" \
  | jq -r '[.events[] | select(.modifiers != null and (.modifiers | index("command") != null) and .route=="terminal")] | length')
[ "$CMD_TO_TERMINAL" -eq 0 ] \
  || fail "input-log: Command key routed to terminal: $INPUT_LOG"

# 27. Exploratory diagnostics: pixel probe, terminal log, timing, errors, snapshot
PIXEL_PROBE=$(post_json /debug/pixel-probe \
  '{"points":[{"x":1,"y":1}],"regions":[{"name":"window","x":0,"y":0,"width":32,"height":32}]}')
printf '%s' "$PIXEL_PROBE" | jq -e \
  '(.points | length) == 1 and (.regions | length) == 1 and (.regions[0].sampledPixels > 0)' >/dev/null 2>&1 \
  || fail "pixel-probe response invalid: $PIXEL_PROBE"

TERMINAL_LOG=$(get_json '/debug/terminal-log?sessionId=&since=0&limit=200')
printf '%s' "$TERMINAL_LOG" | jq -e 'has("events") and has("next") and has("truncated")' >/dev/null 2>&1 \
  || fail "terminal-log missing fields: $TERMINAL_LOG"
TERMINAL_LOG_INPUT=$(printf '%s' "$TERMINAL_LOG" \
  | jq -r '[.events[] | select(.direction=="input")] | length')
[ "$TERMINAL_LOG_INPUT" -ge 1 ] \
  || fail "terminal-log: expected at least one input event: $TERMINAL_LOG"

TIMING=$(get_json /debug/timing)
printf '%s' "$TIMING" | jq -e \
  '.frame >= 1 and .lastFrameMs >= 0 and .renderMs >= 0 and .screenshotMs >= 0' >/dev/null 2>&1 \
  || fail "timing response invalid: $TIMING"

UNSUPPORTED=$(post_json /debug/actions '{"action":"definitelyUnsupported"}')
[ "$(printf '%s' "$UNSUPPORTED" | jq -r '.ok')" = "false" ] \
  || fail "unsupported action should return ok:false: $UNSUPPORTED"
ERRORS=$(get_json /debug/errors?since=0)
printf '%s' "$ERRORS" | jq -e \
  '[.errors[] | select(.kind=="action.unsupported")] | length >= 1' >/dev/null 2>&1 \
  || fail "errors response missing unsupported action: $ERRORS"

SNAPSHOT=$(post_json /debug/snapshot '{}')
SNAPSHOT_MANIFEST=$(printf '%s' "$SNAPSHOT" | jq -r '.path // empty')
[ -n "$SNAPSHOT_MANIFEST" ] || fail "snapshot missing manifest path: $SNAPSHOT"
[ -f "$SNAPSHOT_MANIFEST" ] || fail "snapshot manifest not found: $SNAPSHOT_MANIFEST"
SNAPSHOT_DIR=$(dirname "$SNAPSHOT_MANIFEST")
for _snapshot_file in state.json sessions.json render.json frame-commands.json \
                      render-trace.json events.json input-log.json terminal-log.json \
                      errors.json timing.json screenshot.png; do
  [ -f "$SNAPSHOT_DIR/$_snapshot_file" ] \
    || fail "snapshot missing $_snapshot_file in $SNAPSHOT_DIR"
done

# 28. Stop capture, validate artifact shape, and replay it
CAP_STATUS=$(get_json /debug/capture/status)
[ "$(printf '%s' "$CAP_STATUS" | jq -r '.active')" = "true" ] \
  || fail "capture should be active before stop: $CAP_STATUS"
CAP_STOP=$(post_json /debug/capture/stop '{}')
CAP_DIR=$(printf '%s' "$CAP_STOP" | jq -r '.directory // empty')
CAP_MANIFEST=$(printf '%s' "$CAP_STOP" | jq -r '.manifestPath // empty')
[ -n "$CAP_DIR" ] || fail "capture stop missing directory: $CAP_STOP"
[ -f "$CAP_MANIFEST" ] || fail "capture manifest not found: $CAP_MANIFEST"
[ -f "$CAP_DIR/timeline.ndjson" ] || fail "capture timeline missing at $CAP_DIR"
[ -f "$CAP_DIR/streams/pty-output.bin" ] || fail "capture pty output stream missing"
find "$CAP_DIR/frames" -name 'frame-*.commands.json' | grep -q . \
  || fail "capture frame command sidecars missing"
if ! REPLAY_OUTPUT=$(./scripts/replay-capture "$CAP_DIR" 2>&1); then
  fail "capture replay failed: $REPLAY_OUTPUT"
fi
printf '%s' "$REPLAY_OUTPUT" | jq -e \
  '.terminalReplay == "passed" and .rendererReplay == "passed"' >/dev/null 2>&1 \
  || fail "capture replay failed: $REPLAY_OUTPUT"

# 29. Fixture control: restart and step the current fixture without relaunching
FIXTURE_RESTART=$(post_json /debug/fixture '{"action":"restart"}')
[ "$(printf '%s' "$FIXTURE_RESTART" | jq -r '.ok')" = "true" ] \
  || fail "fixture restart failed: $FIXTURE_RESTART"
[ "$(printf '%s' "$FIXTURE_RESTART" | jq -r '.stepIndex')" -eq 0 ] \
  || fail "fixture restart did not reset step index: $FIXTURE_RESTART"
FIXTURE_STEP=$(post_json /debug/fixture '{"action":"step","count":2}')
[ "$(printf '%s' "$FIXTURE_STEP" | jq -r '.ok')" = "true" ] \
  || fail "fixture step failed: $FIXTURE_STEP"
[ "$(printf '%s' "$FIXTURE_STEP" | jq -r '.stepIndex')" -eq 2 ] \
  || fail "fixture step did not advance to index 2: $FIXTURE_STEP"
FIXTURE_WAIT=$(post_json /debug/wait '{"timeoutMs":2000,"condition":{"kind":"textVisible","text":"hello mvp"}}')
[ "$(printf '%s' "$FIXTURE_WAIT" | jq -r '.ok')" = "true" ] \
  || fail "fixture stepped text was not visible: $FIXTURE_WAIT"

# 30. Terminate server
kill "$SERVER_PID" 2>/dev/null || true
wait "$SERVER_PID" 2>/dev/null || true
SERVER_PID=""

# 31. Bare --debug-server shorthand — launches and answers health
_bare_stdout=$(mktemp)
"$AGENT_BIN" --headless --debug-server --deterministic >"$_bare_stdout" &
BARE_PID=$!
BARE_URL=""
for _i in $(seq 1 100); do
  if [ -s "$_bare_stdout" ]; then
    BARE_READY=$(head -1 "$_bare_stdout")
    BARE_URL=$(printf '%s' "$BARE_READY" | jq -r '.debugServer // empty' 2>/dev/null)
    [ -n "$BARE_URL" ] && break
  fi
  sleep 0.1
done
rm -f "$_bare_stdout"
[ -n "$BARE_URL" ] || fail "bare --debug-server: did not receive readiness JSON"
BARE_HEALTH=$(curl -sf "$BARE_URL/debug/health")
[ "$(printf '%s' "$BARE_HEALTH" | jq -r '.ok')" = "true" ] \
  || fail "bare --debug-server health: $BARE_HEALTH"
kill "$BARE_PID" 2>/dev/null || true
wait "$BARE_PID" 2>/dev/null || true
BARE_PID=""

# 32. Debug script runner — runs a repeatable exploratory scenario.
SCRIPT_ARTIFACTS="$RUN_ARTIFACTS/debug-script"
SCRIPT_TMP="$RUN_TMP/debug-script"
if ! SCRIPT_OUTPUT=$(LABAN_AGENT_BIN="$AGENT_BIN" ./scripts/run-debug-script \
  --no-build \
  --artifacts "$SCRIPT_ARTIFACTS" \
  --temp-dir "$SCRIPT_TMP" \
  fixtures/debug-script-basic.scenario.json 2>&1); then
  fail "debug script runner failed: $SCRIPT_OUTPUT"
fi
printf '%s' "$SCRIPT_OUTPUT" | grep -q "debug script passed" \
  || fail "debug script runner did not report success: $SCRIPT_OUTPUT"
SCRIPT_REPORT="$SCRIPT_ARTIFACTS/debug-script-report.json"
[ -f "$SCRIPT_REPORT" ] || fail "debug script report missing: $SCRIPT_REPORT"
jq -e '.ok == true and (.steps | length) == 6' "$SCRIPT_REPORT" >/dev/null 2>&1 \
  || fail "debug script report invalid: $(cat "$SCRIPT_REPORT")"
SCRIPT_SNAPSHOT=$(jq -r '.steps[] | select(.op=="snapshot") | .path // empty' "$SCRIPT_REPORT")
SCRIPT_SCREENSHOT=$(jq -r '.steps[] | select(.op=="screenshot") | .path // empty' "$SCRIPT_REPORT")
[ -f "$SCRIPT_SNAPSHOT" ] || fail "debug script snapshot missing: $SCRIPT_SNAPSHOT"
[ -f "$SCRIPT_SCREENSHOT" ] || fail "debug script screenshot missing: $SCRIPT_SCREENSHOT"

# Success — clean up and remove trap
trap - EXIT
cleanup_success

printf 'test-e2e passed\n'
