#!/usr/bin/env sh
# End-to-end test: launch the debug server, drive it, verify outputs, shut it down.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

fail() {
  printf 'test-e2e failed: %s\n' "$1" >&2
  if [ -n "${RUN_ARTIFACTS:-}" ]; then
    printf 'artifacts preserved at: %s\n' "$RUN_ARTIFACTS" >&2
  fi
  if [ -n "${SERVER_PID:-}" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
  fi
  exit 1
}

require_json_field() {
  local json="$1" field="$2" label="$3"
  val=$(printf '%s' "$json" | jq -r ".$field // empty" 2>/dev/null)
  [ -n "$val" ] || fail "$label: missing field '$field' in: $json"
  printf '%s' "$val"
}

# 1. Build
swift build --product laban-agent 2>&1 | tail -5

AGENT_BIN=".build/debug/laban-agent"
[ -x "$AGENT_BIN" ] || fail "laban-agent binary not found"

# 2. Unique run ID and directories
RUN_ID="e2e-$(date +%s)-$$"
RUN_ARTIFACTS=".artifacts/runs/$RUN_ID"
RUN_TMP=".tmp/$RUN_ID"
SERVER_PID=""

cleanup_success() {
  if [ -n "${SERVER_PID:-}" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  rm -rf "$RUN_ARTIFACTS" "$RUN_TMP"
}

cleanup_fail() {
  if [ -n "${SERVER_PID:-}" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  printf 'test-e2e: artifacts preserved at %s\n' "$RUN_ARTIFACTS" >&2
}

# Trap for unexpected exits — preserve artifacts
trap cleanup_fail EXIT

# 3. Launch agent
_tmp_stdout=$(mktemp)
"$AGENT_BIN" --headless \
  --fixture=fixtures/colored-boxes.fixture.json \
  --debug-server=127.0.0.1:0 \
  --artifacts="$RUN_ARTIFACTS" \
  --temp-dir="$RUN_TMP" \
  --deterministic \
  >"$_tmp_stdout" &
SERVER_PID=$!

# 4. Parse readiness line (wait up to 10s)
SERVER_URL=""
for _i in $(seq 1 100); do
  if [ -s "$_tmp_stdout" ]; then
    READINESS=$(head -1 "$_tmp_stdout")
    SERVER_URL=$(printf '%s' "$READINESS" | jq -r '.debugServer // empty' 2>/dev/null)
    [ -n "$SERVER_URL" ] && break
  fi
  sleep 0.1
done
rm -f "$_tmp_stdout"

[ -n "$SERVER_URL" ] || fail "did not receive readiness JSON from agent"
printf 'debug server: %s\n' "$SERVER_URL"

# Helper: curl endpoint, assert HTTP 200 and ok:true where applicable
get_json() {
  curl -sf "$SERVER_URL$1"
}

post_json() {
  curl -sf -X POST -H 'Content-Type: application/json' -d "$2" "$SERVER_URL$1"
}

# 5. /debug/health
HEALTH=$(get_json /debug/health)
[ "$(printf '%s' "$HEALTH" | jq -r '.ok')" = "true" ] || fail "health ok is not true: $HEALTH"

# 6. /debug/state — assert one active tab
STATE=$(get_json /debug/state)
TAB_COUNT=$(printf '%s' "$STATE" | jq '.tabs | length')
[ "$TAB_COUNT" -eq 1 ] || fail "expected 1 tab, got $TAB_COUNT"
FIRST_TAB_ID=$(printf '%s' "$STATE" | jq -r '.tabs[0].id')
ACTIVE_TAB_ID=$(printf '%s' "$STATE" | jq -r '.activeTabId')
[ -n "$FIRST_TAB_ID" ] || fail "first tab id is empty"
[ "$FIRST_TAB_ID" = "$ACTIVE_TAB_ID" ] || fail "first tab should be active"

# 7. /debug/wait textVisible "hello mvp"
WAIT_BODY='{"timeoutMs":5000,"condition":{"kind":"textVisible","text":"hello mvp"}}'
WAIT_RESULT=$(post_json /debug/wait "$WAIT_BODY")
[ "$(printf '%s' "$WAIT_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "wait for textVisible failed: $WAIT_RESULT"

# 8. GET /debug/screenshot — non-empty PNG
SCREENSHOT_SIZE=$(curl -sf "$SERVER_URL/debug/screenshot" | wc -c | tr -d ' ')
[ "$SCREENSHOT_SIZE" -gt 100 ] || fail "screenshot is empty (got $SCREENSHOT_SIZE bytes)"

# 9. POST /debug/screenshot — artifact PNG written
SS_RESULT=$(post_json /debug/screenshot "")
SS_PATH=$(printf '%s' "$SS_RESULT" | jq -r '.path // empty')
[ -n "$SS_PATH" ] || fail "POST screenshot missing path: $SS_RESULT"
[ -f "$SS_PATH" ] || fail "screenshot artifact not found at $SS_PATH"

# 10. /debug/frame-commands?source=terminal&limit=100 — at least one terminal command
FC=$(get_json "/debug/frame-commands?source=terminal&limit=100")
TERM_COUNT=$(printf '%s' "$FC" | jq '.commands | length')
[ "$TERM_COUNT" -gt 0 ] || fail "no terminal frame commands returned: $FC"

# 11. /debug/render
RENDER=$(get_json /debug/render)
[ "$(printf '%s' "$RENDER" | jq -r '.backend')" = "software" ] \
  || fail "render backend is not software: $RENDER"

# 12. /debug/sessions
SESSIONS=$(get_json /debug/sessions)
SESSION_COUNT=$(printf '%s' "$SESSIONS" | jq '.sessions | length')
[ "$SESSION_COUNT" -eq 1 ] || fail "expected 1 session, got $SESSION_COUNT"
SESSION_ROWS=$(printf '%s' "$SESSIONS" | jq -r '.sessions[0].rows')
[ "$SESSION_ROWS" -ge 1 ] || fail "session rows < 1"

# 13. newTab — state should now have 2 tabs
NEW_TAB_RESULT=$(post_json /debug/actions '{"action":"newTab"}')
[ "$(printf '%s' "$NEW_TAB_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "newTab action failed: $NEW_TAB_RESULT"
STATE2=$(get_json /debug/state)
TAB_COUNT2=$(printf '%s' "$STATE2" | jq '.tabs | length')
[ "$TAB_COUNT2" -eq 2 ] || fail "expected 2 tabs after newTab, got $TAB_COUNT2"

# 14. selectTab first tab — session ID unchanged
SEL_RESULT=$(post_json /debug/actions "{\"action\":\"selectTab\",\"tabId\":\"$FIRST_TAB_ID\"}")
[ "$(printf '%s' "$SEL_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "selectTab failed: $SEL_RESULT"
STATE3=$(get_json /debug/state)
ACTIVE_NOW=$(printf '%s' "$STATE3" | jq -r '.activeTabId')
[ "$ACTIVE_NOW" = "$FIRST_TAB_ID" ] || fail "expected active tab $FIRST_TAB_ID, got $ACTIVE_NOW"

# 15. resizeWindow — sessions rows/cols still >= 1
RESIZE_RESULT=$(post_json /debug/actions '{"action":"resizeWindow","width":1000,"height":600}')
[ "$(printf '%s' "$RESIZE_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "resizeWindow failed: $RESIZE_RESULT"
SESSIONS2=$(get_json /debug/sessions)
ROWS_AFTER=$(printf '%s' "$SESSIONS2" | jq '.sessions[0].rows')
[ "$ROWS_AFTER" -ge 1 ] || fail "rows after resize < 1"

# 16. setClipboardText + paste
SET_CLIP=$(post_json /debug/actions '{"action":"setClipboardText","text":"agent text\n"}')
[ "$(printf '%s' "$SET_CLIP" | jq -r '.ok')" = "true" ] \
  || fail "setClipboardText failed: $SET_CLIP"
PASTE_RESULT=$(post_json /debug/actions '{"action":"paste"}')
[ "$(printf '%s' "$PASTE_RESULT" | jq -r '.ok')" = "true" ] \
  || fail "paste failed: $PASTE_RESULT"

# 17. /debug/events — includes server.ready and frame.rendered
EVENTS=$(get_json /debug/events)
KINDS=$(printf '%s' "$EVENTS" | jq -r '[.events[].kind] | join(",")')
printf '%s' "$KINDS" | grep -q "server.ready" || fail "server.ready not in events: $KINDS"
printf '%s' "$KINDS" | grep -q "frame.rendered" || fail "frame.rendered not in events: $KINDS"

# 18. Terminate server
kill "$SERVER_PID" 2>/dev/null || true
wait "$SERVER_PID" 2>/dev/null || true
SERVER_PID=""

# Success — clean up and remove trap
trap - EXIT
cleanup_success

printf 'test-e2e passed\n'
