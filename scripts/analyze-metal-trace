#!/usr/bin/env python3
"""Analyze a macOS Instruments Metal trace for Laban renderer work.

The input .trace bundle can contain process metadata, launch arguments, logs, and
environment variables. This script intentionally exports only selected timing
tables, deletes raw XML exports by default, and redacts text before writing any
report.

Agent-iteration features (v3):
  * brief stdout report (token-cheap, deterministic, stable ordering)
  * export cache keyed by trace fingerprint -> near-instant re-analysis
    (writes are atomic; interrupted exports can no longer poison the cache)
  * --baseline compare with IMPROVED/REGRESSED/UNRELIABLE verdict;
    --fail-on-regression makes regressed *and* unreliable exit 3 so
    agents/CI can gate on it (unreliable = symbolication lost, wildly
    different recording length, or schema-version mismatch)
  * --record N --attach/--launch closes the loop: record -> analyze -> verdict
  * --config externalizes focus symbols/labels (edit trace-focus.json to
    refocus analysis on the code you just changed; topFrames now follows it)
  * --self-test validates parse/analyze/compare without a trace or xcrun
  * --print-agent-docs emits a CLAUDE.md/AGENTS.md-ready usage block

Exit codes: 0 ok / no regression; 2 usage or trace error; 3 regression or
unreliable comparison (only with --fail-on-regression); 1 unexpected failure.
"""

from __future__ import annotations

