@dataclass
class Column:
    mnemonic: str
    name: str
    engineering_type: str


@dataclass(frozen=True)
class TableDescriptor:
    schema: str
    run_number: str
    xpath: str


@dataclass(frozen=True)
class StackInfo:
    frames: list[str]
    address_count: int = 0


@dataclass
class NumericStats:
    count: int = 0
    total: float = 0.0
    values: list[float] = field(default_factory=list)

    def add(self, value: float) -> None:
        if math.isfinite(value):
            self.count += 1
            self.total += value
            self.values.append(value)

    def percentile(self, percentile: float) -> float:
        return _percentile_sorted(sorted(self.values), percentile)

    def as_dict(self) -> dict[str, Any]:
        ordered = sorted(self.values)
        return {
            "count": self.count,
            "totalMs": round(self.total, 6),
            "meanMs": round(self.total / self.count, 6) if self.count else 0.0,
            "p50Ms": round(_percentile_sorted(ordered, 0.50), 6),
            "p95Ms": round(_percentile_sorted(ordered, 0.95), 6),
            "p99Ms": round(_percentile_sorted(ordered, 0.99), 6),
            "maxMs": round(ordered[-1], 6) if ordered else 0.0,
        }


@dataclass
class WeightedCounter:
    samples: int = 0
    weight_ms: float = 0.0

    def add(self, weight_ms: float) -> None:
        self.samples += 1
        self.weight_ms += weight_ms


def _percentile_sorted(ordered: list[float], percentile: float) -> float:
    """Linear-interpolated percentile over an already-sorted list."""
    if not ordered:
        return 0.0
    rank = (len(ordered) - 1) * percentile
    low = int(math.floor(rank))
    high = int(math.ceil(rank))
    if low == high:
        return ordered[low]
    return ordered[low] + (ordered[high] - ordered[low]) * (rank - low)


def redact(text: Any, *, max_len: int = 240) -> str:
    raw = "" if text is None else str(text)
    home = str(Path.home())
    raw = raw.replace(home, "~")
    raw = re.sub(r"/private/var/folders/[^ \t\n\r\"']+", "/private/var/folders/<redacted>", raw)
    raw = re.sub(r"/var/folders/[^ \t\n\r\"']+", "/var/folders/<redacted>", raw)
    raw = re.sub(r"(?i)\b(bearer)\s+[a-z0-9._~+/=-]+", r"\1 <redacted>", raw)
    raw = re.sub(
        r"(?i)\b([a-z_][a-z0-9_.-]*(?:secret|token|key|password|passwd|pwd|auth|cookie|credential)[a-z0-9_.-]*)"
        r"\s*[:=]\s*[^ \t\n\r,;\"']+",
        r"\1=<redacted>",
        raw,
    )
    raw = re.sub(
        r"\b[A-Z_][A-Z0-9_]*(?:SECRET|TOKEN|KEY|PASSWORD|PASSWD|PWD|AUTH|COOKIE|CREDENTIAL)[A-Z0-9_]*"
        r"=[^ \t\n\r,;\"']+",
        lambda m: m.group(0).split("=", 1)[0] + "=<redacted>",
        raw,
    )
    raw = re.sub(r"(?i)[a-z0-9_.+-]+@[a-z0-9-]+(?:\.[a-z0-9-]+)+", "<email>", raw)
    raw = re.sub(r"\b[0-9a-f]{32,}\b", lambda m: m.group(0)[:8] + "...", raw)
    raw = re.sub(r"\s+", " ", raw).strip()
    if len(raw) > max_len:
        return raw[: max_len - 1] + "..."
    return raw


def run_xctrace_export(trace: Path, mode_args: list[str], output: Path) -> None:
    xcrun = shutil.which("xcrun")
    if xcrun is None:
        raise SystemExit("xcrun is required to export Instruments .trace bundles")
    cmd = [xcrun, "xctrace", "export", "--quiet", "--input", str(trace), *mode_args, "--output", str(output)]
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        stderr = redact(proc.stderr, max_len=1200)
        raise RuntimeError(f"xctrace export failed for {' '.join(mode_args)}: {stderr}")


def table_schemas_from_toc(path: Path) -> list[str]:
    root = ET.parse(path).getroot()
    schemas: list[str] = []
    for table in root.iter():
        if local_name(table.tag) != "table":
            continue
        schema = table.attrib.get("schema")
        if schema:
            schemas.append(schema)
    return schemas


def xpath_literal(value: str) -> str:
    if '"' not in value:
        return f'"{value}"'
    if "'" not in value:
        return f"'{value}'"
    parts = value.split("'")
    return "concat(" + ", ".join(
        [f"'{parts[0]}'"]
        + [part for piece in parts[1:] for part in ('"\'"', f"'{piece}'")]
    ) + ")"


def xpath_segment(element: ET.Element) -> str:
    tag = local_name(element.tag)
    schema = element.attrib.get("schema")
    if schema:
        return f"{tag}[@schema={xpath_literal(schema)}]"
    name = element.attrib.get("name")
    if name:
        return f"{tag}[@name={xpath_literal(name)}]"
    return tag


def table_descriptors_from_toc(path: Path) -> dict[str, list[TableDescriptor]]:
    root = ET.parse(path).getroot()
    descriptors: dict[str, list[TableDescriptor]] = defaultdict(list)
    seen: set[tuple[str, str, str]] = set()

    def visit(element: ET.Element, run_number: str, path_parts: list[str]) -> None:
        tag = local_name(element.tag)
        current = path_parts + [xpath_segment(element)]
        if tag == "table":
            schema = element.attrib.get("schema")
            if schema:
                xpath = "/" + "/".join(current)
                key = (run_number, schema, xpath)
                if key not in seen:
                    seen.add(key)
                    descriptors[schema].append(TableDescriptor(schema, run_number, xpath))
        for child in list(element):
            visit(child, run_number, current)

    for index, run in enumerate(root):
        if local_name(run.tag) != "run":
            continue
        run_number = run.attrib.get("number") or str(index + 1)
        for child in list(run):
            visit(child, run_number, [local_name(root.tag), f"run[@number={xpath_literal(run_number)}]"])
    return descriptors


def local_name(tag: str) -> str:
    return tag.rsplit("}", 1)[-1]


def element_raw_text(element: ET.Element) -> str:
    pieces = [part.strip() for part in element.itertext() if part and part.strip()]
    if pieces:
        return " ".join(pieces)
    return ""


def child_text(element: ET.Element, key: str | None = None) -> str:
    if key in RAW_NUMERIC_KEYS or local_name(element.tag) in RAW_NUMERIC_KEYS:
        raw = element_raw_text(element)
        if raw:
            return raw
    if element.attrib.get("fmt"):
        return element.attrib["fmt"]
    raw = element_raw_text(element)
    if raw:
        return raw
    # No fmt, no text: this is a pure id/ref node. Returning the raw id/ref
    # string here would poison numeric parsing (e.g. ref="3" -> 3 ns), so an
    # unresolved reference deliberately reads as empty.
    return ""


def parse_col(element: ET.Element) -> Column:
    data = {local_name(child.tag): child_text(child) for child in list(element)}
    return Column(
        mnemonic=data.get("mnemonic", ""),
        name=data.get("name", ""),
        engineering_type=data.get("engineering-type", ""),
    )


def cached_child_text(
    element: ET.Element,
    key: str,
    value_cache: dict[str, str],
) -> str:
    ref = element.attrib.get("ref")
    if ref is not None and ref in value_cache:
        return value_cache[ref]
    value = child_text(element, key)
    element_id = element.attrib.get("id")
    if element_id is not None:
        value_cache[element_id] = value
    return value


def stack_info(
    element: ET.Element,
    frame_cache: dict[str, str],
    stack_cache: dict[str, StackInfo],
    value_cache: dict[str, str],
) -> StackInfo:
    stack_ref = element.attrib.get("ref")
    if stack_ref is not None and stack_ref in stack_cache:
        return stack_cache[stack_ref]

    frames: list[str] = []
    address_count = 0
    for child in element.iter():
        tag = local_name(child.tag)
        if tag == "frame":
            frame_ref = child.attrib.get("ref")
            if frame_ref is not None:
                name = frame_cache.get(frame_ref, "")
            else:
                name = child.attrib.get("name") or child_text(child)
                frame_id = child.attrib.get("id")
                if frame_id is not None:
                    frame_cache[frame_id] = name
            if name:
                frames.append(name)
        elif tag == "text-addresses":
            text = cached_child_text(child, tag, value_cache)
            for token in text.split():
                try:
                    int(token, 0)
                except ValueError:
                    continue
                address_count += 1

    info = StackInfo(frames=frames, address_count=address_count)
    stack_id = element.attrib.get("id")
    if stack_id is not None:
        stack_cache[stack_id] = info
    return info


def iter_table_rows(path: Path, max_rows: int = 0) -> Iterable[tuple[list[Column], dict[str, str]]]:
    columns: list[Column] = []
    value_cache: dict[str, str] = {}
    frame_cache: dict[str, str] = {}
    stack_cache: dict[str, StackInfo] = {}
    rows = 0
    # Ancestor stack so completed <row>/<col> elements can be detached from
    # their parent; element.clear() alone leaks O(rows) empty Elements because
    # iterparse keeps appending children to the still-open <table>.
    ancestors: list[ET.Element] = []

    def detach(element: ET.Element) -> None:
        if not ancestors:
            return
        # iterparse buffers events, so by the time <row N> ends the parser may
        # already have appended rows N+1..N+k to the parent; the ended element
        # is therefore the *first* still-attached child, not the last. remove()
        # compares by identity (Element defines no __eq__) and finds it at
        # index ~0, so this is O(1) per row in practice.
        try:
            ancestors[-1].remove(element)
        except ValueError:
            pass

    for event, element in ET.iterparse(path, events=("start", "end")):
        if event == "start":
            if local_name(element.tag) == "table":
                columns = []
                value_cache = {}
                frame_cache = {}
                stack_cache = {}
            ancestors.append(element)
            continue
        ancestors.pop()
        tag = local_name(element.tag)
        if tag == "col":
            columns.append(parse_col(element))
            element.clear()
            detach(element)
        elif tag == "row":
            row: dict[str, str] = {}
            children = list(element)
            for index, child in enumerate(children):
                column = columns[index] if index < len(columns) else None
                key = column.mnemonic if column and column.mnemonic else local_name(child.tag)
                row[key] = cached_child_text(child, key, value_cache)
                if key == "stack" or local_name(child.tag) in {"tagged-backtrace", "backtrace"}:
                    info = stack_info(child, frame_cache, stack_cache, value_cache)
                    if info.frames:
                        row["_stackFrames"] = "\n".join(info.frames)
                    if info.address_count:
                        row["_stackAddressCount"] = str(info.address_count)
            rows += 1
            yield columns, row
            element.clear()
            detach(element)
            if max_rows and rows >= max_rows:
                return


def parse_duration_ms(text: str) -> float | None:
    value = redact(text, max_len=80)
    if re.fullmatch(r"-?\d+", value):
        return float(value) / 1_000_000.0
    numeric_part = re.search(r"-?\d[\d,.]*", value)
    if numeric_part:
        token = numeric_part.group(0)
        if "," in token and "." not in token:
            # Instruments uses locale-formatted decimals on some systems, e.g. "27,573 ms".
            value = value.replace(token, token.replace(",", "."), 1)
        else:
            value = value.replace(token, token.replace(",", ""), 1)
    match = re.search(r"(-?\d+(?:\.\d+)?)\s*(ns|nanoseconds?|us|microseconds?|µs|ms|milliseconds?|s|sec|seconds?)?", value, re.I)
    if not match:
        return None
    number = float(match.group(1))
    unit = (match.group(2) or "ms").lower()
    if unit in {"ns", "nanosecond", "nanoseconds"}:
        return number / 1_000_000.0
    if unit in {"us", "µs", "microsecond", "microseconds"}:
        return number / 1000.0
    if unit in {"s", "sec", "second", "seconds"}:
        return number * 1000.0
    return number


def process_allowed(row: dict[str, str], process_re: re.Pattern[str] | None) -> bool:
    if process_re is None:
        return True
    haystack = " ".join(
        row.get(key, "")
        for key in (
            "process",
            "thread",
            "event-label",
            "track-label",
            "event-type",
            "gpu-driver-name",
        )
    )
    if not haystack.strip():
        return True
    return bool(process_re.search(haystack))


_FRAME_INTEREST_RE: re.Pattern[str] | None = None


def _frame_interest_pattern() -> re.Pattern[str]:
    """Regex over the *active* focus config (CPU symbols + category needles),
    so --config refocusing also changes which frames surface in topFrames."""
    global _FRAME_INTEREST_RE
    if _FRAME_INTEREST_RE is None:
        needles = list(dict.fromkeys(
            CPU_SYMBOLS + [n for ns in CPU_CATEGORIES.values() for n in ns]
        ))
        if needles:
            _FRAME_INTEREST_RE = re.compile("|".join(re.escape(n) for n in needles))
        else:
            _FRAME_INTEREST_RE = re.compile(r"(?!)")  # match nothing
    return _FRAME_INTEREST_RE


def _invalidate_frame_interest_pattern() -> None:
    global _FRAME_INTEREST_RE
    _FRAME_INTEREST_RE = None


def extract_frames(stack: str) -> list[str]:
    chunks = re.split(r"(?:\n|\\n| {2,}|\t+| > )", stack)
    frames: list[str] = []
    interesting = _frame_interest_pattern()
    for chunk in chunks:
        clean = redact(chunk, max_len=180)
        if clean and interesting.search(clean) and clean not in frames:
            frames.append(clean)
        if len(frames) >= 8:
            break
    return frames


def stack_text_for_row(row: dict[str, str]) -> str:
    frames = row.get("_stackFrames", "")
    summary = row.get("stack", "")
    if frames:
        return f"{frames}\n{summary}"
    return summary


def analyze_time_profile(
    rows: Iterable[dict[str, str]],
    process_re: re.Pattern[str] | None,
) -> dict[str, Any]:
    total_weight_ms = 0.0
    kept_rows = 0
    skipped_rows = 0
    symbol_hits: dict[str, WeightedCounter] = defaultdict(WeightedCounter)
    category_hits: dict[str, WeightedCounter] = defaultdict(WeightedCounter)
    top_frames: dict[str, WeightedCounter] = defaultdict(WeightedCounter)
    kept_processes: Counter[str] = Counter()
    candidate_processes: Counter[str] = Counter()
    stack_examples: dict[str, list[str]] = defaultdict(list)
    rows_with_nested_frames = 0
    rows_with_raw_backtrace_addresses = 0

    for row in rows:
        process_label = row.get("process") or ""
        if process_label.isdigit() or not process_label:
            process_label = row.get("thread") or process_label or "<unknown>"
        candidate_processes[redact(process_label, max_len=140)] += 1
        if not process_allowed(row, process_re):
            skipped_rows += 1
            continue
        kept_rows += 1
        kept_processes[redact(process_label, max_len=140)] += 1
        parsed_weight = parse_duration_ms(row.get("weight", ""))
        weight_ms = 1.0 if parsed_weight is None else parsed_weight
        total_weight_ms += weight_ms
        stack_text = stack_text_for_row(row)
        if row.get("_stackFrames"):
            rows_with_nested_frames += 1
        if row.get("_stackAddressCount"):
            rows_with_raw_backtrace_addresses += 1

        frames = extract_frames(stack_text)
        if frames:
            top_frames[frames[0]].add(weight_ms)

        for symbol in CPU_SYMBOLS:
            if symbol in stack_text:
                symbol_hits[symbol].add(weight_ms)
                if len(stack_examples[symbol]) < 3:
                    stack_examples[symbol].append(" | ".join(frames[:5]) if frames else symbol)

        for category, needles in CPU_CATEGORIES.items():
            if any(needle in stack_text for needle in needles):
                category_hits[category].add(weight_ms)

    def render_counter(counter: dict[str, WeightedCounter], limit: int) -> list[dict[str, Any]]:
        rows_out = []
        for name, stats in sorted(counter.items(), key=lambda item: item[1].weight_ms, reverse=True)[:limit]:
            percent = (stats.weight_ms / total_weight_ms * 100.0) if total_weight_ms else 0.0
            rows_out.append(
                {
                    "name": redact(name),
                    "samples": stats.samples,
                    "weightMs": round(stats.weight_ms, 6),
                    "percent": round(percent, 3),
                }
            )
        return rows_out

    return {
        "rows": kept_rows,
        "rowsWithNestedFrames": rows_with_nested_frames,
        "rowsWithRawBacktraceAddresses": rows_with_raw_backtrace_addresses,
        "skippedRowsByProcessFilter": skipped_rows,
        "totalWeightMs": round(total_weight_ms, 6),
        "symbolHits": render_counter(symbol_hits, 30),
        "categoryHits": render_counter(category_hits, 10),
        "topFrames": render_counter(top_frames, 20),
        "topProcesses": kept_processes.most_common(20),
        "candidateProcessLabels": candidate_processes.most_common(20),
        "stackExamples": {redact(k): v for k, v in stack_examples.items()},
    }


def row_duration_ms(row: dict[str, str]) -> float | None:
    for key in ("duration", "weight", "time", "elapsed-time"):
        if key in row:
            parsed = parse_duration_ms(row[key])
            if parsed is not None:
                return parsed
    return None


def row_label(row: dict[str, str]) -> str:
    parts = []
    for key in (
        "event-label",
        "event-type",
        "track-label",
        "label",
        "name",
        "lane",
        "channel-name",
        "channel-subtitle",
        "state",
        "gpu-driver-name",
        "gpu",
        "thread",
    ):
        value = row.get(key)
        if value:
            parts.append(redact(value, max_len=100))
    return " / ".join(part for part in parts if part) or "<unlabeled>"


def analyze_interval_rows(
    schema: str,
    rows: Iterable[dict[str, str]],
    process_re: re.Pattern[str] | None,
) -> dict[str, Any]:
    labels: dict[str, NumericStats] = defaultdict(NumericStats)
    interest: dict[str, NumericStats] = defaultdict(NumericStats)
    rows_seen = 0
    rows_with_duration = 0
    skipped_rows = 0
    command_buffers: Counter[str] = Counter()

    for row in rows:
        rows_seen += 1
        if not process_allowed(row, process_re):
            skipped_rows += 1
            continue
        duration = row_duration_ms(row)
        label = row_label(row)
        cmdbuf = row.get("cmdbuffer-id") or row.get("metal-command-buffer-id") or row.get("object-id")
        if cmdbuf:
            command_buffers[redact(cmdbuf, max_len=80)] += 1
        if duration is None:
            continue
        rows_with_duration += 1
        labels[label].add(duration)
        label_lc = label.lower()
        for needle in METAL_LABELS_OF_INTEREST:
            if needle.lower() in label_lc:
                interest[needle].add(duration)

    def render(stats_by_label: dict[str, NumericStats], limit: int) -> list[dict[str, Any]]:
        result = []
        for label, stats in sorted(stats_by_label.items(), key=lambda item: item[1].total, reverse=True)[:limit]:
            item = {"label": redact(label, max_len=180)}
            item.update(stats.as_dict())
            result.append(item)
        return result

    return {
        "schema": schema,
        "rows": rows_seen,
        "rowsWithDuration": rows_with_duration,
        "skippedRowsByProcessFilter": skipped_rows,
        "topLabels": render(labels, 20),
        "labelsOfInterest": render(interest, 20),
        "topCommandBufferIds": command_buffers.most_common(10),
    }


def analyze_schema(
    trace: Path,
    scratch: Path,
    schema: str,
    process_re: re.Pattern[str] | None,
    max_rows: int,
    descriptors: list[TableDescriptor],
) -> dict[str, Any]:
    if not descriptors:
        descriptors = [
            TableDescriptor(
                schema=schema,
                run_number="1",
                xpath=f"/trace-toc/run/data/table[@schema={xpath_literal(schema)}]",
            )
        ]
    output_paths: list[Path] = []
    for index, descriptor in enumerate(descriptors):
        cached = cache_lookup(schema, index)
        if cached is not None:
            print(f"analyze-metal-trace: cache hit {schema}-{index}", file=sys.stderr)
            output_paths.append(cached)
            continue
        target = cache_target(schema, index)
        if target is not None:
            # Export to a same-directory temp file and promote atomically so an
            # interrupted xctrace never leaves a truncated XML that
            # cache_lookup would accept (size > 0) and poison later runs.
            tmp = target.with_name(target.name + ".tmp")
            try:
                run_xctrace_export(trace, ["--xpath", descriptor.xpath], tmp)
                os.replace(tmp, target)
            finally:
                tmp.unlink(missing_ok=True)
            output = target
        else:
            output = scratch / f"{schema}-{index}.xml"
            run_xctrace_export(trace, ["--xpath", descriptor.xpath], output)
        output_paths.append(output)

    columns: list[Column] = []

    def rows() -> Iterable[dict[str, str]]:
        nonlocal columns
        remaining = max_rows
        for output in output_paths:
            row_limit = remaining if max_rows else 0
            for table_columns, row in iter_table_rows(output, max_rows=row_limit):
                if not columns:
                    columns = list(table_columns)
                yield row
                if max_rows:
                    remaining -= 1
                    if remaining <= 0:
                        return

    if schema == "time-profile":
        summary = analyze_time_profile(rows(), process_re)
    else:
        summary = analyze_interval_rows(schema, rows(), process_re)
    column_summary = [
        {
            "mnemonic": redact(col.mnemonic),
            "name": redact(col.name),
            "engineeringType": redact(col.engineering_type),
        }
        for col in columns
    ]
    summary["columns"] = column_summary
    summary["exportBytes"] = sum(path.stat().st_size for path in output_paths if path.exists())
    summary["tableExports"] = len(output_paths)
    return summary


def pct_for_symbol(cpu: dict[str, Any], symbol: str) -> float:
    for item in cpu.get("symbolHits", []):
        if item["name"] == symbol:
            return float(item["percent"])
    return 0.0


def total_for_interest(tables: list[dict[str, Any]], label: str) -> float:
    total = 0.0
    for table in tables:
        for item in table.get("labelsOfInterest", []):
            if item.get("label") == label:
                total += float(item.get("totalMs", 0.0))
    return total


def build_findings(summary: dict[str, Any]) -> list[dict[str, str]]:
    cpu = summary.get("cpu", {})
    metal_tables = summary.get("metalTables", [])
    findings: list[dict[str, str]] = []

    payload_pct = pct_for_symbol(cpu, "buildGPUCellPayloadInstanceListsOnce")
    if payload_pct:
        findings.append(
            {
                "area": "CPU payload builder",
                "evidence": f"buildGPUCellPayloadInstanceListsOnce accounts for {payload_pct:.2f}% of kept Time Profiler sample weight.",
                "action": (
                    "Split the function with os_signpost subspans for command rect prepass, dirty-row clears, "
                    "background runs, procedural cells, sidebar glyphs, payload glyph loop, preedit, and upload-range bookkeeping. "
                    "Then optimize the dominant subspan first."
                ),
                "verification": (
                    "Run LABAN_RUN_PERF_BENCH=1 swift test -c release --filter MetalFrameTimingBench and "
                    "TerminalCellPayloadAllocationBench after each isolated change."
                ),
            }
        )
        findings.append(
            {
                "area": "CPU payload builder",
                "evidence": "Source review shows the payload path scans commands multiple times and then walks every payload glyph.",
                "action": (
                    "Prepartition frame commands once per frame into terminal rects, overlays, sidebar glyphs, and preedit. "
                    "For the glyph loop, batch by dirty row and write CellGlyphs through an UnsafeMutableBufferPointer using precomputed row base, "
                    "cellY, scale, and inverse atlas size."
                ),
                "verification": (
                    "Keep GPUCellParityTests green; compare one dirty row, contiguous 5-row, sparse rows, and heavy scroll rows in MetalFrameTimingBench."
                ),
            }
        )
    else:
        findings.append(
            {
                "area": "CPU payload builder",
                "evidence": "buildGPUCellPayloadInstanceListsOnce was not visible in kept Time Profiler samples.",
                "action": (
                    "If this trace was captured from an optimized or symbol-stripped build, rerun with dSYM loaded or add os_signpost spans "
                    "inside buildGPUCellPayloadInstanceListsOnce before judging CPU work."
                ),
                "verification": "Confirm the Time Profiler table shows LabanRenderer symbols before making source changes.",
            }
        )

    upload_pct = pct_for_symbol(cpu, "prepareCellGlyphBuffer") + pct_for_symbol(cpu, "memcpy")
    if upload_pct:
        findings.append(
            {
                "area": "CPU upload path",
                "evidence": f"prepareCellGlyphBuffer/memcpy account for {upload_pct:.2f}% of kept Time Profiler sample weight.",
                "action": (
                    "Treat upload range count and total bytes as first-class metrics. Sort and coalesce dirty row ranges, avoid per-cell upload ranges "
                    "from preedit when possible, and keep full-row contiguous writes for heavy scroll."
                ),
                "verification": "Use the payload+upload path in MetalFrameTimingBench and assert GPUCellParityTests upload-range cases still pass.",
            }
        )

    gpu_cell_ms = total_for_interest(metal_tables, "terminal-content-gpu-cell")
    if gpu_cell_ms:
        findings.append(
            {
                "area": "GPU cell draw",
                "evidence": f"Metal interval labels include terminal-content-gpu-cell with {gpu_cell_ms:.3f} ms total duration.",
                "action": (
                    "The current partial path redraws instanceCount=cellGlyphs.count once for every dirty Y range. Prototype drawing only the contiguous "
                    "cell range for each dirty row band with drawPrimitives(... instanceCount: rangeCellCount, baseInstance: rowStart). "
                    "The shader indexes cells by instance_id, so this should cut vertex work for sparse damage if Metal's instance_id includes baseInstance."
                ),
                "verification": (
                    "Add a parity test for sparse dirty ranges plus a release MetalFrameTimingBench row that reports cell-glyph draw count, "
                    "dirty ranges, and GPU content-pass timing."
                ),
            }
        )

    present_ms = total_for_interest(metal_tables, "present-blit") + total_for_interest(metal_tables, "drawable")
    if present_ms:
        findings.append(
            {
                "area": "Present/drawable pacing",
                "evidence": f"Present/drawable-related Metal labels account for {present_ms:.3f} ms total duration.",
                "action": (
                    "If this dominates p95/p99, the renderer is compositor/drawable limited rather than payload limited. Preserve late drawable acquisition, "
                    "watch ca-client-buffer-wait-interval, and avoid holding CAMetalDrawable while doing CPU payload work."
                ),
                "verification": "Compare dropped frames, drawableUnavailable, and display-vsync intervals in the same trace window.",
            }
        )

    atlas_pct = (
        pct_for_symbol(cpu, "MetalGlyphAtlas.entry")
        + pct_for_symbol(cpu, "glyphAtlas.entry")
        + pct_for_symbol(cpu, "CTFontGetSymbolicTraits")
        + pct_for_symbol(cpu, "styledFont")
    )
    if atlas_pct:
        findings.append(
            {
                "area": "Glyph atlas/font lookup",
                "evidence": f"Atlas/font lookup symbols account for {atlas_pct:.2f}% of kept Time Profiler sample weight.",
                "action": (
                    "Keep the scalar entry cache hot and add counters for scalar fast-path hit rate versus UTF-8 range decoding. "
                    "If CTFont trait checks still show up, memoize terminal/sidebar font info per TextAttributes across the whole frame."
                ),
                "verification": "Use TerminalCellPayloadAllocationBench for scalar/cluster payload cases and GPUCellParityTests for fallback glyphs.",
            }
        )

    findings.append(
        {
            "area": "State-of-the-art target",
            "evidence": "ADR 0017 says Laban is CPU-render-bound and GPU-driven remains opt-in until release p50/p99, full redraw, parity, and energy gates are met.",
            "action": (
                "Optimize one candidate at a time: first instrument, then change CPU payload construction, then upload coalescing, then sparse GPU draw. "
                "Do not batch changes, because the existing perf history depends on attributable measurements."
            ),
            "verification": (
                "Use release-only benches plus a fresh Instruments trace of heavy scroll/sidebar activity. Keep GPUCellParityTests at zero pixel diff."
            ),
        }
    )
    return findings


def markdown_table(headers: list[str], rows: list[list[Any]]) -> str:
    out = ["| " + " | ".join(headers) + " |", "| " + " | ".join("---" for _ in headers) + " |"]
    for row in rows:
        out.append("| " + " | ".join(redact(value, max_len=140) for value in row) + " |")
    return "\n".join(out)


def write_markdown(summary: dict[str, Any]) -> str:
    lines: list[str] = []
    lines.append("# Laban Metal Trace Analysis")
    lines.append("")
    lines.append(f"- trace: `{redact(summary['tracePath'])}`")
    lines.append(f"- process filter: `{summary['processFilter'] or '<all processes>'}`")
    lines.append(f"- parsed schemas: {', '.join(summary['parsedSchemas']) or '<none>'}")
    if summary.get("skippedSchemas"):
        lines.append(f"- skipped schemas: {', '.join(summary['skippedSchemas'])}")
    lines.append(f"- raw xctrace XML exports: {summary.get('rawExports', 'deleted')} after analysis")
    lines.append("")

    cpu = summary.get("cpu", {})
    lines.append("## CPU Time Profiler")
    lines.append("")
    lines.append(
        f"Kept rows: {cpu.get('rows', 0)}; total sample weight: {cpu.get('totalWeightMs', 0.0)} ms; "
        f"nested-frame rows: {cpu.get('rowsWithNestedFrames', 0)}; "
        f"raw-address backtrace rows: {cpu.get('rowsWithRawBacktraceAddresses', 0)}; "
        f"process-filter skipped rows: {cpu.get('skippedRowsByProcessFilter', 0)}."
    )
    rows = [
        [item["name"], item["samples"], item["weightMs"], f"{item['percent']}%"]
        for item in cpu.get("symbolHits", [])[:15]
    ]
    if rows:
        lines.append("")
        lines.append(markdown_table(["Symbol", "Samples", "Weight ms", "Percent"], rows))
    rows = [
        [item["name"], item["samples"], item["weightMs"], f"{item['percent']}%"]
        for item in cpu.get("categoryHits", [])[:10]
    ]
    if rows:
        lines.append("")
        lines.append(markdown_table(["Category", "Samples", "Weight ms", "Percent"], rows))
    rows = [
        [item["name"], item["samples"], item["weightMs"], f"{item['percent']}%"]
        for item in cpu.get("topFrames", [])[:10]
    ]
    if rows:
        lines.append("")
        lines.append(markdown_table(["Top visible frame", "Samples", "Weight ms", "Percent"], rows))
    if cpu.get("topProcesses"):
        lines.append("")
        lines.append(
            markdown_table(
                ["Kept process/thread labels", "Rows"],
                [[name, count] for name, count in cpu.get("topProcesses", [])[:8]],
            )
        )
    elif cpu.get("candidateProcessLabels"):
        lines.append("")
        lines.append(
            markdown_table(
                ["Candidate process/thread labels before filtering", "Rows"],
                [[name, count] for name, count in cpu.get("candidateProcessLabels", [])[:8]],
            )
        )

    lines.append("")
    lines.append("## Metal Intervals")
    for table in summary.get("metalTables", []):
        top = table.get("topLabels", [])[:8]
        interest = table.get("labelsOfInterest", [])[:8]
        if not top and not interest:
            continue
        lines.append("")
        lines.append(f"### {table['schema']}")
        lines.append(
            f"Rows: {table.get('rows', 0)}; with duration: {table.get('rowsWithDuration', 0)}; "
            f"process-filter skipped rows: {table.get('skippedRowsByProcessFilter', 0)}."
        )
        if interest:
            lines.append("")
            lines.append(
                markdown_table(
                    ["Interesting label", "Count", "Total ms", "P50", "P95", "P99", "Max"],
                    [
                        [
                            item["label"],
                            item["count"],
                            item["totalMs"],
                            item["p50Ms"],
                            item["p95Ms"],
                            item["p99Ms"],
                            item["maxMs"],
                        ]
                        for item in interest
                    ],
                )
            )
        elif top:
            lines.append("")
            lines.append(
                markdown_table(
                    ["Top label", "Count", "Total ms", "P50", "P95", "P99", "Max"],
                    [
                        [
                            item["label"],
                            item["count"],
                            item["totalMs"],
                            item["p50Ms"],
                            item["p95Ms"],
                            item["p99Ms"],
                            item["maxMs"],
                        ]
                        for item in top
                    ],
                )
            )

    lines.append("")
    lines.append("## Optimization Findings")
    for index, finding in enumerate(summary.get("findings", []), start=1):
        lines.append("")
        lines.append(f"{index}. **{redact(finding['area'])}**")
        lines.append(f"   - Evidence: {redact(finding['evidence'], max_len=500)}")
        lines.append(f"   - Action: {redact(finding['action'], max_len=700)}")
        lines.append(f"   - Verification: {redact(finding['verification'], max_len=500)}")

    lines.append("")
    lines.append("## Next Experiments")
    lines.append("")
    lines.append("1. Add os_signpost subspans inside `buildGPUCellPayloadInstanceListsOnce` and rerun this script.")
    lines.append("2. Prototype sparse cell-glyph draws with per-dirty-row `baseInstance` and instance counts.")
    lines.append("3. Batch the payload glyph loop by row with precomputed row bases and cell coordinates.")
    lines.append("4. Keep each candidate isolated and gate it with release `MetalFrameTimingBench`, `TerminalCellPayloadAllocationBench`, and `GPUCellParityTests`.")
    lines.append("")
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# Export cache - xctrace export dominates wall time (often 10-100x the parse
# cost); .trace bundles are immutable once recorded, so a fingerprint of the
# bundle contents safely keys cached XML. Sensitive schemas are never cached.
# --------------------------------------------------------------------------- #

_CACHE: dict[str, Any] = {"dir": None, "fingerprint": None}


def trace_fingerprint(trace: Path) -> str:
    digest = hashlib.sha256(str(trace.resolve()).encode())
    count = 0
    total = 0
    newest = 0
    for root, _dirs, files in os.walk(trace):
        for name in files:
            try:
                st = os.stat(os.path.join(root, name))
            except OSError:
                continue
            count += 1
            total += st.st_size
            newest = max(newest, st.st_mtime_ns)
    digest.update(f"{count}:{total}:{newest}".encode())
    return digest.hexdigest()[:16]


def configure_cache(trace: Path, cache_dir: Path | None, enabled: bool) -> None:
    if not enabled:
        _CACHE["dir"] = None
        return
    base = cache_dir or Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "analyze-metal-trace"
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    _CACHE["dir"] = base
    _CACHE["fingerprint"] = trace_fingerprint(trace)


def _cache_path(schema: str, index: int) -> Path | None:
    if _CACHE["dir"] is None or schema in DANGEROUS_SCHEMAS:
        return None
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", schema)
    return _CACHE["dir"] / f"{_CACHE['fingerprint']}-{safe}-{index}.xml"


def cache_lookup(schema: str, index: int) -> Path | None:
    path = _cache_path(schema, index)
    if path is not None and path.exists() and path.stat().st_size > 0:
        return path
    return None


def cache_target(schema: str, index: int) -> Path | None:
    return _cache_path(schema, index)


def clear_cache(cache_dir: Path | None) -> int:
    base = cache_dir or Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "analyze-metal-trace"
    removed = 0
    if base.exists():
        for path in list(base.glob("*.xml")) + list(base.glob("*.xml.tmp")):
            path.unlink(missing_ok=True)
            removed += 1
    return removed


# --------------------------------------------------------------------------- #
# Focus config - externalizes the project-specific symbol/label lists so an
# agent can refocus the analysis on the code it just changed by editing a
# small JSON file instead of this script. Missing keys keep built-in defaults.
# --------------------------------------------------------------------------- #

DEFAULT_CONFIG_NAME = "trace-focus.json"


def apply_config(path: Path | None) -> Path | None:
    """Load focus config; auto-discovers ./trace-focus.json when not given.
    Mutates the module-level focus lists in place (single-file CLI pragmatism)."""
    chosen = path
    if chosen is None:
        candidate = Path(DEFAULT_CONFIG_NAME)
        chosen = candidate if candidate.exists() else None
    if chosen is None:
        return None
    try:
        data = json.loads(chosen.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(
            f"could not read focus config {redact(chosen)}: {redact(exc)}\n"
            f"hint: run with --print-config > {DEFAULT_CONFIG_NAME} to regenerate a valid file"
        )
    if isinstance(data.get("cpuSymbols"), list):
        CPU_SYMBOLS[:] = [str(s) for s in data["cpuSymbols"]]
    if isinstance(data.get("cpuCategories"), dict):
        CPU_CATEGORIES.clear()
        CPU_CATEGORIES.update({str(k): [str(v) for v in vs] for k, vs in data["cpuCategories"].items()})
    if isinstance(data.get("metalLabels"), list):
        METAL_LABELS_OF_INTEREST[:] = [str(s) for s in data["metalLabels"]]
    _invalidate_frame_interest_pattern()
    return chosen


def current_config_json() -> str:
    return json.dumps(
        {
            "cpuSymbols": CPU_SYMBOLS,
            "cpuCategories": CPU_CATEGORIES,
            "metalLabels": METAL_LABELS_OF_INTEREST,
        },
        indent=2,
        sort_keys=True,
    )


# --------------------------------------------------------------------------- #
# Brief report - the agent-facing stdout surface. Deterministic ordering,
# ~30 lines, no prose. Cheap to read, cheap to diff.
# --------------------------------------------------------------------------- #

def brief_report(summary: dict[str, Any], top: int = 8) -> str:
    lines: list[str] = []
    cpu = summary.get("cpu", {})
    lines.append(
        f"trace={summary.get('tracePath', '?')} kept_rows={cpu.get('rows', 0)} "
        f"weight_ms={cpu.get('totalWeightMs', 0.0)} filter={summary.get('processFilter') or '<all>'}"
    )
    if summary.get("skippedSchemas"):
        lines.append("skipped=" + ",".join(summary["skippedSchemas"]))
    if cpu.get("categoryHits"):
        lines.append("cpu_categories:")
        for item in cpu["categoryHits"][:top]:
            lines.append(f"  {item['percent']:7.2f}% {item['name']} (n={item['samples']})")
    if cpu.get("symbolHits"):
        lines.append("cpu_symbols:")
        for item in cpu["symbolHits"][:top]:
            lines.append(f"  {item['percent']:7.2f}% {item['name']} (n={item['samples']})")
    if cpu.get("rows", 0) and not cpu.get("rowsWithNestedFrames", 0):
        lines.append(
            "warn: no symbolicated frames in kept samples -> build may be stripped; "
            "record with dSYMs or add os_signpost spans before trusting CPU numbers"
        )
    for table in summary.get("metalTables", []):
        items = table.get("labelsOfInterest") or table.get("topLabels") or []
        if not items:
            continue
        lines.append(f"gpu {table['schema']} (rows={table.get('rows', 0)}):")
        for item in items[:top]:
            lines.append(
                f"  {item['label']}: n={item['count']} total={item['totalMs']}ms "
                f"p50={item['p50Ms']} p95={item['p95Ms']} p99={item['p99Ms']} max={item['maxMs']}"
            )
    findings = summary.get("findings", [])
    if findings:
        lines.append(f"findings={len(findings)} (top: {redact(findings[0]['area'])}) -> see json/md for actions")
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# Baseline compare - turns two analysis JSONs into a verdict an agent can act
# on. CPU symbols compare in percentage points; Metal labels compare p95 in
# percent. Regression gating is what makes the iterate loop self-checking.
# --------------------------------------------------------------------------- #

def _cpu_pct_map(summary: dict[str, Any]) -> dict[str, float]:
    return {i["name"]: float(i["percent"]) for i in summary.get("cpu", {}).get("symbolHits", [])}


def _gpu_p95_map(summary: dict[str, Any]) -> dict[tuple[str, str], dict[str, float]]:
    out: dict[tuple[str, str], dict[str, float]] = {}
    for table in summary.get("metalTables", []):
        for item in table.get("labelsOfInterest", []):
            out[(table["schema"], item["label"])] = {
                "p95Ms": float(item["p95Ms"]),
                "totalMs": float(item["totalMs"]),
                "count": float(item["count"]),
            }
    return out


def compare_summaries(
    baseline: dict[str, Any],
    current: dict[str, Any],
    threshold_pp: float,
    threshold_pct: float,
) -> dict[str, Any]:
    deltas: list[dict[str, Any]] = []

    base_cpu, cur_cpu = _cpu_pct_map(baseline), _cpu_pct_map(current)
    for name in sorted(set(base_cpu) | set(cur_cpu)):
        b, c = base_cpu.get(name, 0.0), cur_cpu.get(name, 0.0)
        delta = round(c - b, 3)
        status = "regressed" if delta > threshold_pp else "improved" if delta < -threshold_pp else "neutral"
        deltas.append(
            {"kind": "cpu", "name": name, "metric": "percent", "base": b, "current": c,
             "delta": delta, "unit": "pp", "status": status}
        )

    base_gpu, cur_gpu = _gpu_p95_map(baseline), _gpu_p95_map(current)
    for key in sorted(set(base_gpu) | set(cur_gpu)):
        schema, label = key
        b = base_gpu.get(key, {}).get("p95Ms")
        c = cur_gpu.get(key, {}).get("p95Ms")
        if b is None or c is None:
            deltas.append(
                {"kind": "gpu", "name": f"{schema}/{label}", "metric": "p95Ms",
                 "base": b, "current": c, "delta": None, "unit": "ms",
                 "status": "new" if b is None else "gone"}
            )
            continue
        if b > 0:
            delta_pct = round((c - b) / b * 100.0, 2)
            status = "regressed" if delta_pct > threshold_pct else "improved" if delta_pct < -threshold_pct else "neutral"
        else:
            delta_pct = None
            status = "neutral" if c == 0 else "regressed"
        deltas.append(
            {"kind": "gpu", "name": f"{schema}/{label}", "metric": "p95Ms",
             "base": b, "current": c, "delta": delta_pct, "unit": "%", "status": status}
        )

    regressed = [d for d in deltas if d["status"] == "regressed"]
    improved = [d for d in deltas if d["status"] == "improved"]
    verdict = "regressed" if regressed else "improved" if improved else "neutral"

    # Sanity guards: a broken comparison must not masquerade as IMPROVED.
    warnings: list[str] = []
    base_cpu_meta = baseline.get("cpu", {})
    cur_cpu_meta = current.get("cpu", {})
    if (
        base_cpu_meta.get("rowsWithNestedFrames", 0)
        and cur_cpu_meta.get("rows", 0)
        and not cur_cpu_meta.get("rowsWithNestedFrames", 0)
    ):
        warnings.append(
            "current trace has no symbolicated frames (baseline did): CPU deltas are meaningless; "
            "fix dSYMs before trusting this comparison"
        )
    base_weight = float(base_cpu_meta.get("totalWeightMs", 0.0) or 0.0)
    cur_weight = float(cur_cpu_meta.get("totalWeightMs", 0.0) or 0.0)
    if base_weight > 0 and cur_weight > 0:
        ratio = cur_weight / base_weight
        if ratio > 5.0 or ratio < 0.2:
            warnings.append(
                f"kept CPU sample weight differs {ratio:.1f}x from baseline; "
                "record equal-length sessions of the same workload for an attributable verdict"
            )
    base_version = baseline.get("schemaVersion")
    if base_version is not None and base_version != SCHEMA_VERSION:
        warnings.append(
            f"baseline schemaVersion={base_version} != current {SCHEMA_VERSION}; regenerate the baseline"
        )
    if warnings:
        verdict = "unreliable"

    return {
        "thresholdPp": threshold_pp,
        "thresholdPct": threshold_pct,
        "verdict": verdict,
        "regressedCount": len(regressed),
        "improvedCount": len(improved),
        "warnings": warnings,
        "deltas": deltas,
    }


def render_compare_brief(cmp: dict[str, Any], baseline_path: str, top: int = 12) -> str:
    lines = [
        f"compare vs {baseline_path} (cpu>{cmp['thresholdPp']}pp, gpu p95>{cmp['thresholdPct']}%):"
    ]
    notable = [d for d in cmp["deltas"] if d["status"] in {"regressed", "improved", "new", "gone"}]
    notable.sort(key=lambda d: (d["status"] != "regressed", -(abs(d["delta"]) if d["delta"] is not None else 0)))
    for d in notable[:top]:
        delta = "n/a" if d["delta"] is None else f"{d['delta']:+}{d['unit']}"
        lines.append(
            f"  {d['status'].upper():9s} {d['kind']} {d['name']} {d['metric']} "
            f"{d['base']}->{d['current']} ({delta})"
        )
    if not notable:
        lines.append("  no deltas beyond thresholds")
    for warning in cmp.get("warnings", []):
        lines.append(f"  WARNING   {warning}")
    lines.append(
        f"verdict={cmp['verdict'].upper()} improved={cmp['improvedCount']} regressed={cmp['regressedCount']}"
    )
    return "\n".join(lines)


def load_baseline(path: Path) -> dict[str, Any]:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(
            f"could not load baseline {redact(path)}: {redact(exc)}\n"
            "hint: a baseline is the JSON this tool wrote on a previous run "
            "(use --json-output to control its path)"
        )


# --------------------------------------------------------------------------- #
# Recording - closes the loop: build -> record -> analyze -> verdict.
# --------------------------------------------------------------------------- #

def record_trace(
    seconds: int,
    template: str,
    attach: str | None,
    launch: list[str] | None,
    output: Path | None,
) -> Path:
    xcrun = shutil.which("xcrun")
    if xcrun is None:
        raise SystemExit(
            "xcrun is required to record; install Xcode command line tools "
            "(xcode-select --install) or pass an existing .trace path instead"
        )
    if (attach is None) == (not launch):
        raise SystemExit("recording needs exactly one of --attach NAME or --launch -- <cmd> [args...]")
    out = output or Path(".build/traces") / f"trace-{time.strftime('%Y%m%d-%H%M%S')}.trace"
    out.parent.mkdir(parents=True, exist_ok=True)
    cmd = [xcrun, "xctrace", "record", "--template", template,
           "--time-limit", f"{seconds}s", "--output", str(out)]
    if attach:
        cmd += ["--attach", attach]
    else:
        argv = list(launch or [])
        if argv and argv[0] == "--":
            argv = argv[1:]
        if not argv:
            raise SystemExit("--launch given but no command followed; use --launch -- ./app args")
        cmd += ["--launch", "--", *argv]
    print(f"analyze-metal-trace: recording {seconds}s -> {redact(out)}", file=sys.stderr)
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if proc.returncode != 0:
        raise SystemExit(f"xctrace record failed: {redact(proc.stderr, max_len=1200)}")
    return out


# --------------------------------------------------------------------------- #
# Agent docs + self-test
# --------------------------------------------------------------------------- #

AGENT_DOCS = """\
## analyze-metal-trace - perf iteration loop (for coding agents)

Verify the tool first (no trace or macOS needed):
    ./analyze-metal-trace --self-test

Standard loop (each step is one command):
1. Establish a baseline from a recorded trace (exports are cached; reruns are fast):
       ./analyze-metal-trace path/to/run.trace --json-output .build/baseline.json
2. Make ONE code change, rebuild, then record + analyze + compare in one shot:
       ./analyze-metal-trace --record 10 --attach Laban \\
           --baseline .build/baseline.json --fail-on-regression
   (or: --launch -- ./build/Laban --bench-scroll)
   Exit 0 = no regression beyond thresholds; exit 3 = regression -> revert or fix.
3. Read ONLY stdout (brief report + verdict). Full details are in the JSON/MD
   files if a finding needs evidence.

Refocusing on the code you just changed:
    ./analyze-metal-trace --print-config > trace-focus.json
    # edit cpuSymbols / metalLabels to include your function or signpost label,
    # then rerun; trace-focus.json is auto-discovered in the cwd.

Fast paths:
    --cpu-only --max-rows 50000     # quick CPU hot-path check
    --list-schemas                  # what tables exist in this trace
    --no-cache / --clear-cache      # force fresh exports
Thresholds: --threshold-pp (CPU pp, default 1.0), --threshold-pct (GPU p95 %, default 10.0).

Rules of thumb:
- One change per trace; the compare verdict is only attributable if you do.
- If brief output warns about missing symbolicated frames, fix dSYMs before
  trusting CPU numbers.
- Never pass --allow-sensitive-schemas unless explicitly asked; raw exports can
  contain launch env vars and logs.
"""

_SELF_TEST_TIME_PROFILE = """<?xml version="1.0"?>
<trace-query-result><node><table schema="time-profile">
<col><mnemonic>sample-time</mnemonic><name>Sample Time</name><engineering-type>sample-time</engineering-type></col>
<col><mnemonic>process</mnemonic><name>Process</name><engineering-type>process</engineering-type></col>
<col><mnemonic>weight</mnemonic><name>Weight</name><engineering-type>weight</engineering-type></col>
<col><mnemonic>stack</mnemonic><name>Backtrace</name><engineering-type>backtrace</engineering-type></col>
<row>
  <sample-time id="1" fmt="00:00.001.000">1000000</sample-time>
  <process id="2" fmt="Laban (123)">Laban</process>
  <weight id="3" fmt="1.00 ms">1000000</weight>
  <backtrace id="4" fmt="buildGPUCellPayloadInstanceListsOnce">
    <frame id="5" name="buildGPUCellPayloadInstanceListsOnce"/>
    <frame id="6" name="MetalRenderer.render"/>
  </backtrace>
</row>
<row>
  <sample-time id="7" fmt="00:00.002.000">2000000</sample-time>
  <process ref="2"/>
  <weight ref="3"/>
  <backtrace ref="4"/>
</row>
<row>
  <sample-time id="8" fmt="00:00.003.000">3000000</sample-time>
  <process id="9" fmt="WindowServer (88)">WindowServer</process>
  <weight ref="3"/>
  <backtrace id="10" fmt="other"><frame id="11" name="otherWork"/></backtrace>
</row>
</table></node></trace-query-result>
"""

_SELF_TEST_METAL = """<?xml version="1.0"?>
<trace-query-result><node><table schema="metal-driver-event-intervals">
<col><mnemonic>start</mnemonic><name>Start</name><engineering-type>start-time</engineering-type></col>
<col><mnemonic>duration</mnemonic><name>Duration</name><engineering-type>duration</engineering-type></col>
<col><mnemonic>event-label</mnemonic><name>Label</name><engineering-type>string</engineering-type></col>
<col><mnemonic>process</mnemonic><name>Process</name><engineering-type>process</engineering-type></col>
<row>
  <start id="1" fmt="00:00.000.000">0</start>
  <duration id="2" fmt="2,00 ms">2000000</duration>
  <event-label id="3" fmt="terminal-content-gpu-cell">terminal-content-gpu-cell</event-label>
  <process id="4" fmt="Laban (123)">Laban</process>
</row>
<row>
  <start id="5" fmt="00:00.005.000">5000000</start>
  <duration id="6" fmt="4.00 ms">4000000</duration>
  <event-label ref="3"/>
  <process ref="4"/>
</row>
</table></node></trace-query-result>
"""


def self_test() -> int:
    failures: list[str] = []

    def check(name: str, condition: bool) -> None:
        if not condition:
            failures.append(name)

    with tempfile.TemporaryDirectory(prefix="amt-selftest-") as tmp:
        tp = Path(tmp) / "tp.xml"
        tp.write_text(_SELF_TEST_TIME_PROFILE, encoding="utf-8")
        rows = [row for _cols, row in iter_table_rows(tp)]
        check("3 time-profile rows parsed", len(rows) == 3)
        check("ref-row inherits process via id/ref", rows[1].get("process") == rows[0].get("process"))
        check("raw ns preferred over fmt for weight", rows[0].get("weight") == "1000000")
        check("nested frames extracted", "buildGPUCellPayloadInstanceListsOnce" in rows[0].get("_stackFrames", ""))

        cpu = analyze_time_profile(iter(rows), re.compile(r"Laban"))
        check("process filter keeps 2 of 3", cpu["rows"] == 2 and cpu["skippedRowsByProcessFilter"] == 1)
        check("weight summed from raw ns", abs(cpu["totalWeightMs"] - 2.0) < 1e-6)
        check(
            "focus symbol attributed 100% of kept weight",
            any(i["name"] == "buildGPUCellPayloadInstanceListsOnce" and abs(i["percent"] - 100.0) < 1e-6
                for i in cpu["symbolHits"]),
        )

        mt = Path(tmp) / "metal.xml"
        mt.write_text(_SELF_TEST_METAL, encoding="utf-8")
        metal = analyze_interval_rows(
            "metal-driver-event-intervals",
            (row for _c, row in iter_table_rows(mt)),
            re.compile(r"Laban"),
        )
        interest = {i["label"]: i for i in metal["labelsOfInterest"]}
        check("metal label of interest found", "terminal-content-gpu-cell" in interest)
        if "terminal-content-gpu-cell" in interest:
            item = interest["terminal-content-gpu-cell"]
            check("metal durations summed in ms", abs(item["totalMs"] - 6.0) < 1e-6)
            check("metal p95 between samples", 2.0 <= item["p95Ms"] <= 4.0)

        check("locale comma duration", parse_duration_ms("2,00 ms") == 2.0)
        check("thousands separator duration", parse_duration_ms("1,234.5 ms") == 1234.5)
        check("bare ns integer duration", parse_duration_ms("2000000") == 2.0)
        check("empty duration is None", parse_duration_ms("") is None)

        # F1: a genuine 0-weight sample must not be coerced to 1 ms.
        zero = analyze_time_profile(
            iter([{"process": "Laban", "weight": "0", "_stackFrames": "buildGPUCellPayloadInstanceListsOnce"}]),
            re.compile(r"Laban"),
        )
        check("zero weight stays zero", zero["rows"] == 1 and zero["totalWeightMs"] == 0.0)

        # F2: an unresolved <elem ref="..."/> must read as empty, not as the
        # literal ref id (which numeric parsing would treat as nanoseconds).
        dangling = Path(tmp) / "dangling.xml"
        dangling.write_text(
            """<r><table schema="x">
            <col><mnemonic>duration</mnemonic><name>D</name><engineering-type>duration</engineering-type></col>
            <row><duration ref="999"/></row>
            </table></r>""",
            encoding="utf-8",
        )
        dangling_rows = [row for _c, row in iter_table_rows(dangling)]
        check("unresolved ref reads empty", dangling_rows and dangling_rows[0].get("duration") == "")

        # F4: completed rows must be detached from the still-open <table>.
        many = Path(tmp) / "many.xml"
        many.write_text(
            "<r><table schema=\"x\"><col><mnemonic>v</mnemonic><name>V</name>"
            "<engineering-type>string</engineering-type></col>"
            + "".join(f"<row><v fmt=\"x{i}\"/></row>" for i in range(500))
            + "</table></r>",
            encoding="utf-8",
        )
        seen = 0
        for _cols, _row in iter_table_rows(many):
            seen += 1
        check("streaming parse yields all rows after detach", seen == 500)

        # F5: topFrames interest pattern follows the active focus config.
        CPU_SYMBOLS.append("totallyCustomHotFunction")
        _invalidate_frame_interest_pattern()
        custom = analyze_time_profile(
            iter([{"process": "Laban", "weight": "1000000", "_stackFrames": "totallyCustomHotFunction"}]),
            re.compile(r"Laban"),
        )
        check(
            "config symbol surfaces in topFrames",
            any(i["name"] == "totallyCustomHotFunction" for i in custom["topFrames"]),
        )
        CPU_SYMBOLS.remove("totallyCustomHotFunction")
        _invalidate_frame_interest_pattern()

        # F9: as_dict percentile parity with the reference implementation.
        stats = NumericStats()
        for v in (5.0, 1.0, 3.0, 2.0, 4.0):
            stats.add(v)
        d = stats.as_dict()
        check("p50 over sorted values", d["p50Ms"] == 3.0)
        check("max over sorted values", d["maxMs"] == 5.0)

        base = {"cpu": {"symbolHits": [{"name": "f", "samples": 1, "weightMs": 5.0, "percent": 50.0}]},
                "metalTables": [{"schema": "s", "labelsOfInterest": [
                    {"label": "L", "count": 10, "totalMs": 10.0, "p50Ms": 1.0, "p95Ms": 2.0, "p99Ms": 2.0, "maxMs": 2.0}]}]}
        better = {"cpu": {"symbolHits": [{"name": "f", "samples": 1, "weightMs": 4.0, "percent": 40.0}]},
                  "metalTables": [{"schema": "s", "labelsOfInterest": [
                      {"label": "L", "count": 10, "totalMs": 8.0, "p50Ms": 0.9, "p95Ms": 1.5, "p99Ms": 1.6, "maxMs": 1.7}]}]}
        worse = {"cpu": {"symbolHits": [{"name": "f", "samples": 1, "weightMs": 6.0, "percent": 62.0}]},
                 "metalTables": base["metalTables"]}
        check("compare detects improvement", compare_summaries(base, better, 1.0, 10.0)["verdict"] == "improved")
        check("compare detects regression", compare_summaries(base, worse, 1.0, 10.0)["verdict"] == "regressed")
        check("compare neutral vs self", compare_summaries(base, base, 1.0, 10.0)["verdict"] == "neutral")

        # F7: losing symbolication or comparing wildly different recordings
        # must yield UNRELIABLE rather than a fake IMPROVED.
        sym_base = {"schemaVersion": SCHEMA_VERSION,
                    "cpu": {"rows": 100, "rowsWithNestedFrames": 100, "totalWeightMs": 100.0,
                            "symbolHits": [{"name": "f", "samples": 1, "weightMs": 5.0, "percent": 50.0}]},
                    "metalTables": []}
        sym_lost = {"schemaVersion": SCHEMA_VERSION,
                    "cpu": {"rows": 100, "rowsWithNestedFrames": 0, "totalWeightMs": 100.0,
                            "symbolHits": []},
                    "metalTables": []}
        cmp_lost = compare_summaries(sym_base, sym_lost, 1.0, 10.0)
        check("symbolication loss -> unreliable", cmp_lost["verdict"] == "unreliable" and cmp_lost["warnings"])
        short = {"schemaVersion": SCHEMA_VERSION,
                 "cpu": {"rows": 5, "rowsWithNestedFrames": 5, "totalWeightMs": 5.0,
                         "symbolHits": [{"name": "f", "samples": 1, "weightMs": 2.5, "percent": 50.0}]},
                 "metalTables": []}
        check("10x shorter recording -> unreliable",
              compare_summaries(sym_base, short, 1.0, 10.0)["verdict"] == "unreliable")

        brief = brief_report({"tracePath": "t.trace", "processFilter": "Laban",
                              "cpu": cpu, "metalTables": [metal], "findings": []})
        check("brief mentions focus symbol", "buildGPUCellPayloadInstanceListsOnce" in brief)
        check("brief stays compact", len(brief.splitlines()) < 60)

        check("redaction strips bearer token", "<redacted>" in redact("Authorization: Bearer abc.def-123"))

    if failures:
        print("SELF-TEST FAILED:\n  " + "\n  ".join(failures))
        return 1
    print(f"self-test OK (schema_version={SCHEMA_VERSION}, all checks passed)")
    return 0


def default_output_paths(trace: Path) -> tuple[Path, Path]:
    build_dir = Path(".build") / "laban"
    stem = trace.name.removesuffix(".trace")
    return build_dir / f"{stem}-metal-trace-analysis.json", build_dir / f"{stem}-metal-trace-analysis.md"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Analyze an Instruments .trace bundle for Laban Metal renderer CPU/GPU optimization.",
    )
    parser.add_argument(
        "trace",
        nargs="?",
        type=Path,
        default=Path("~/Downloads/Untitled.trace").expanduser(),
        help="Path to the .trace bundle. Defaults to ~/Downloads/Untitled.trace.",
    )
    parser.add_argument("--json-output", type=Path, help="Write JSON summary to this path.")
    parser.add_argument("--markdown-output", type=Path, help="Write Markdown report to this path.")
    parser.add_argument(
        "--process",
        default=r"Laban|laband|labpty",
        help="Regex for process-owner rows to keep. Use --all-processes to disable.",
    )
    parser.add_argument("--all-processes", action="store_true", help="Do not filter rows by process name.")
    parser.add_argument(
        "--cpu-only",
        action="store_true",
        help="Only export/analyze Time Profiler. Use with --max-rows for fast CPU hot-path iteration.",
    )
    parser.add_argument(
        "--schema",
        action="append",
        default=[],
        help="Additional table schema to export. Dangerous schemas are refused unless --allow-sensitive-schemas is set.",
    )
    parser.add_argument("--deep-gpu", action="store_true", help="Also export heavier GPU counter/resource tables.")
    parser.add_argument(
        "--allow-sensitive-schemas",
        action="store_true",
        help="Allow schemas that can contain launch metadata or logs. Reports are still redacted, but raw temp XML may contain secrets.",
    )
    parser.add_argument("--keep-exports", action="store_true", help="Keep raw exported XML in --scratch-dir for local inspection.")
    parser.add_argument("--scratch-dir", type=Path, help="Directory for raw XML exports. Defaults to a temporary directory.")
    parser.add_argument("--max-rows", type=int, default=0, help="Maximum rows to parse per table; 0 means all rows.")
    parser.add_argument("--list-schemas", action="store_true", help="Only list sanitized table schemas in the trace.")

    agent = parser.add_argument_group("agent iteration loop")
    agent.add_argument("--format", choices=["brief", "json", "md", "none"], default="brief",
                       help="What to print to stdout (files are still written unless --no-files). Default: brief.")
    agent.add_argument("--top", type=int, default=8, help="Rows per section in brief output.")
    agent.add_argument("--no-files", action="store_true", help="Skip writing JSON/Markdown files (stdout only).")
    agent.add_argument("--baseline", type=Path,
                       help="Previous JSON output to compare against; prints deltas and a verdict.")
    agent.add_argument("--threshold-pp", type=float, default=1.0,
                       help="CPU regression threshold in percentage points (default 1.0).")
    agent.add_argument("--threshold-pct", type=float, default=10.0,
                       help="GPU p95 regression threshold in percent (default 10.0).")
    agent.add_argument("--fail-on-regression", action="store_true",
                       help="Exit 3 when --baseline compare detects a regression beyond thresholds.")
    agent.add_argument("--config", type=Path,
                       help=f"Focus config JSON (cpuSymbols/cpuCategories/metalLabels). Auto-discovers ./{DEFAULT_CONFIG_NAME}.")
    agent.add_argument("--print-config", action="store_true", help="Print the active focus config as JSON and exit.")
    agent.add_argument("--no-cache", action="store_true", help="Disable the export cache (always re-export).")
    agent.add_argument("--cache-dir", type=Path, help="Export cache directory (default: ~/.cache/analyze-metal-trace).")
    agent.add_argument("--clear-cache", action="store_true", help="Delete cached exports and exit.")
    agent.add_argument("--record", type=int, metavar="SECONDS",
                       help="Record a new trace for SECONDS before analyzing (needs --attach or --launch).")
    agent.add_argument("--attach", help="Process name or pid to attach to when recording.")
    agent.add_argument("--launch", nargs=argparse.REMAINDER,
                       help="Command to launch when recording; must be last: --launch -- ./app args")
    agent.add_argument("--template", default="Metal System Trace", help="xctrace template for --record.")
    agent.add_argument(
        "--time-profiler",
        action="store_true",
        help="Capture/analyze a CPU Time Profiler trace only (no Metal GPU tables). "
        "For --record this swaps the template to 'Time Profiler' (lighter capture); "
        "it always implies --cpu-only. Use for fast CPU hot-path iteration.",
    )
    agent.add_argument("--record-output", type=Path, help="Where to write the recorded .trace bundle.")
    agent.add_argument("--self-test", action="store_true", help="Run built-in tests (no trace or xcrun needed) and exit.")
    agent.add_argument("--print-agent-docs", action="store_true",
                       help="Print a CLAUDE.md/AGENTS.md-ready usage block and exit.")
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    # Short-circuit commands that need no trace.
    if args.self_test:
        return self_test()
    if args.print_agent_docs:
        print(AGENT_DOCS)
        return 0
    if args.clear_cache:
        removed = clear_cache(args.cache_dir)
        print(f"cleared {removed} cached export(s)", file=sys.stderr)
        return 0

    config_path = apply_config(args.config)
    if args.print_config:
        print(current_config_json())
        return 0
    if config_path is not None:
        print(f"analyze-metal-trace: focus config {redact(config_path)}", file=sys.stderr)

    # Time Profiler mode: CPU-only analysis, and (when recording) the lighter
    # "Time Profiler" instrument instead of the full "Metal System Trace".
    if args.time_profiler:
        args.cpu_only = True
        record_template = (
            "Time Profiler" if args.template == "Metal System Trace" else args.template
        )
    else:
        record_template = args.template

    if args.record is not None:
        trace = record_trace(args.record, record_template, args.attach, args.launch, args.record_output)
    else:
        trace = args.trace.expanduser()
    if not trace.exists():
        raise SystemExit(
            f"trace not found: {redact(trace)}\n"
            "hint: pass a .trace path, or record one with --record 10 --attach <ProcessName>"
        )

    json_output, markdown_output = default_output_paths(trace)
    if args.json_output:
        json_output = args.json_output
    if args.markdown_output:
        markdown_output = args.markdown_output
    if not args.no_files:
        json_output.parent.mkdir(parents=True, exist_ok=True)
        markdown_output.parent.mkdir(parents=True, exist_ok=True)

    configure_cache(trace, args.cache_dir, enabled=not args.no_cache)

    process_re = None if args.all_processes else re.compile(args.process)
    schemas_to_request = ["time-profile"] if args.cpu_only else list(DEFAULT_SCHEMAS)
    if args.deep_gpu and not args.cpu_only:
        schemas_to_request.extend(DEEP_GPU_SCHEMAS)
    schemas_to_request.extend(args.schema)

    if args.scratch_dir:
        scratch_root = args.scratch_dir
        scratch_root.mkdir(parents=True, exist_ok=True)
        temp_context: Any = None
    else:
        temp_context = tempfile.TemporaryDirectory(prefix="laban-metal-trace-")
        scratch_root = Path(temp_context.name)

    try:
        toc_path = scratch_root / "toc.xml"
        try:
            run_xctrace_export(trace, ["--toc"], toc_path)
        except RuntimeError as exc:
            raise SystemExit(
                f"{exc}\nhint: is {redact(trace)} a valid Instruments .trace bundle for this Xcode version?"
            )
        available = table_schemas_from_toc(toc_path)
        available_set = set(available)
        descriptors_by_schema = table_descriptors_from_toc(toc_path)
        if args.list_schemas:
            for schema in sorted(available_set):
                print(redact(schema))
            return 0

        parsed: list[str] = []
        skipped: list[str] = []
        metal_tables: list[dict[str, Any]] = []
        cpu_summary: dict[str, Any] = {
            "rows": 0,
            "rowsWithNestedFrames": 0,
            "rowsWithRawBacktraceAddresses": 0,
            "skippedRowsByProcessFilter": 0,
            "totalWeightMs": 0.0,
            "symbolHits": [],
            "categoryHits": [],
            "topFrames": [],
            "stackExamples": {},
        }

        for schema in dict.fromkeys(schemas_to_request):
            if schema not in available_set:
                skipped.append(f"{schema}:not-present")
                continue
            if schema in DANGEROUS_SCHEMAS and not args.allow_sensitive_schemas:
                skipped.append(f"{schema}:sensitive")
                continue
            try:
                print(f"analyze-metal-trace: exporting {schema}", file=sys.stderr)
                result = analyze_schema(
                    trace,
                    scratch_root,
                    schema,
                    process_re,
                    args.max_rows,
                    descriptors_by_schema.get(schema, []),
                )
            except Exception as exc:  # Keep the rest of the report useful.
                skipped.append(f"{schema}:error:{redact(type(exc).__name__)}")
                print(
                    f"analyze-metal-trace: {schema} failed: {redact(exc, max_len=400)}",
                    file=sys.stderr,
                )
                continue
            parsed.append(schema)
            if schema == "time-profile":
                cpu_summary = result
            else:
                metal_tables.append(result)

        if not parsed:
            raise SystemExit(
                "no requested schemas could be parsed from this trace "
                f"(skipped: {', '.join(skipped) or '<none>'})\n"
                "hint: run --list-schemas to see what the trace contains, or pass --schema NAME"
            )

        summary = {
            "schemaVersion": SCHEMA_VERSION,
            "tracePath": redact(trace),
            "processFilter": None if args.all_processes else args.process,
            "focusConfig": redact(config_path) if config_path else None,
            "availableSchemas": sorted(redact(schema) for schema in available_set),
            "parsedSchemas": parsed,
            "skippedSchemas": skipped,
            "rawExports": "cached" if not args.no_cache else ("kept" if args.keep_exports else "deleted"),
            "cpu": cpu_summary,
            "metalTables": metal_tables,
        }
        summary["findings"] = build_findings(summary)

        compare = None
        if args.baseline:
            baseline = load_baseline(args.baseline)
            compare = compare_summaries(baseline, summary, args.threshold_pp, args.threshold_pct)
            summary["compare"] = compare

        if not args.no_files:
            json_output.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            markdown = write_markdown(summary)
            if compare is not None:
                markdown += "\n## Baseline Compare\n\n```\n" + render_compare_brief(
                    compare, str(args.baseline)
                ) + "\n```\n"
            markdown_output.write_text(markdown, encoding="utf-8")
            print(f"wrote {json_output}", file=sys.stderr)
            print(f"wrote {markdown_output}", file=sys.stderr)

        if args.format == "brief":
            print(brief_report(summary, top=args.top))
            if compare is not None:
                print(render_compare_brief(compare, str(args.baseline)))
        elif args.format == "json":
            print(json.dumps(summary, indent=2, sort_keys=True))
        elif args.format == "md":
            print(write_markdown(summary))

        if args.keep_exports:
            print(f"kept raw exports in {scratch_root}", file=sys.stderr)
        if (
            compare is not None
            and args.fail_on_regression
            and compare["verdict"] in {"regressed", "unreliable"}
        ):
            return 3
        return 0
    finally:
        if temp_context is not None and not args.keep_exports:
            temp_context.cleanup()


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit as exc:
        # int codes pass through; string messages are usage/trace errors -> exit 2
        if isinstance(exc.code, str):
            print(exc.code, file=sys.stderr)
            raise SystemExit(2)
        raise
