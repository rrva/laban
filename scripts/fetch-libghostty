#!/usr/bin/env sh
# Fetch the pinned Ghostty source for header inspection.
# Fetched source goes to .external/libghostty (not committed).
# Pin: ghostty v1.1.0 (annotated tag)
#   tag object:  2f44bf55c3f89fa4dd44ea3238f567f9e7a36032
#   tree commit: facda0c3fb1310c7698fc77ba193165ef38cd58e
set -eu

GHOSTTY_TAG="v1.1.0"
GHOSTTY_COMMIT="facda0c3fb1310c7698fc77ba193165ef38cd58e"
GHOSTTY_URL="https://github.com/ghostty-org/ghostty"
DEST=".external/libghostty"

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if [ -d "$DEST/.git" ]; then
  stored=$(git -C "$DEST" rev-parse HEAD 2>/dev/null || echo "unknown")
  if [ "$stored" = "$GHOSTTY_COMMIT" ]; then
    printf 'fetch-libghostty: already at %s\n' "$GHOSTTY_COMMIT"
    exit 0
  fi
  printf 'fetch-libghostty: removing stale clone at %s\n' "$DEST"
  rm -rf "$DEST"
fi

mkdir -p "$(dirname "$DEST")"

git clone \
  --depth 1 \
  --branch "$GHOSTTY_TAG" \
  --filter=blob:none \
  --sparse \
  "$GHOSTTY_URL" \
  "$DEST"

cd "$DEST"

# Check out only the directories likely to contain the C API headers.
git sparse-checkout set include src/apprt
git checkout

actual=$(git rev-parse HEAD)
if [ "$actual" != "$GHOSTTY_COMMIT" ]; then
  printf 'fetch-libghostty: WARNING: expected %s, got %s\n' "$GHOSTTY_COMMIT" "$actual" >&2
fi

printf 'fetch-libghostty: cloned %s@%s -> %s\n' "$GHOSTTY_URL" "$GHOSTTY_TAG" "$DEST"
