#!/usr/bin/env sh
# Install this repo's git hooks into the checkout. Idempotent. Targets the
# common git dir so the hook also fires from linked worktrees.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

hooks_dir="$(git rev-parse --git-common-dir)/hooks"
mkdir -p "$hooks_dir"
chmod +x "$repo_root/scripts/pre-push"
ln -sf "$repo_root/scripts/pre-push" "$hooks_dir/pre-push"
printf 'installed: %s -> %s\n' "$hooks_dir/pre-push" "$repo_root/scripts/pre-push"
