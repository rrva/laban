#!/usr/bin/env sh
# Fetch and build libghostty-vt from source.
# Pin: Ghostty commit 46d54ed673a004df09078bee56e809421a82370e (main snapshot, 2026-05-20)
# Artifacts written to .external/libghostty-vt/zig-out/ (git-ignored).
# Requires: git, Zig 0.15.2
set -eu

GHOSTTY_COMMIT="46d54ed673a004df09078bee56e809421a82370e"
GHOSTTY_URL="https://github.com/ghostty-org/ghostty"
DEST=".external/libghostty-vt"
LIB_OUT="$DEST/zig-out/lib/libghostty-vt.a"
HDR_OUT="$DEST/zig-out/include/ghostty/vt.h"
PATCH_STAMP="$DEST/zig-out/.laban-patchset"
RELINK_INPUT="Sources/LabanTerminalCore/ghostty_vt_bridge_smoke.c"

# Application order is intentional and shared by the fingerprint, applied-state
# check, and rebuild path. Keep each patch in a named variable so
# scripts/check-dependencies can prove that every committed vendored patch is
# represented here.
PATCH_0002="patches/libghostty-vt-0002-stream-log-scope-and-mode-debug.patch"
PATCH_0001="patches/libghostty-vt-0001-alt-screen-clear-uses-primary-pen.patch"
PATCH_0003="patches/libghostty-vt-0003-decxcpr-cursor-position-report.patch"
PATCH_ORDER="$PATCH_0002 $PATCH_0001 $PATCH_0003"

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

# Scrub inherited git environment. When this script runs from a git hook
# (e.g. pre-push), git exports GIT_DIR — and from a linked worktree it points
# at that worktree's gitdir (.git/worktrees/<name>). Every `git` command below
# targets the *vendored Ghostty* checkout under .external/, a DIFFERENT repo, so
# the inherited env must not leak into them: `git -C "$DEST" …` does NOT override
# an exported GIT_DIR (the env var wins over cwd discovery). Left set, `git init`
# would reinitialize the superproject's gitdir and flip `core.bare=true` in the
# shared config (breaking every worktree), and `git remote add origin` would
# hit the superproject ("remote origin already exists") instead of Ghostty.
# Clear all repo-targeting GIT_* vars so each nested command discovers $DEST.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE \
      GIT_PREFIX GIT_QUARANTINE_PATH 2>/dev/null || true

fail() {
    printf 'fetch-libghostty-vt: error: %s\n' "$1" >&2
    exit 1
}

command -v git >/dev/null 2>&1 || fail "git is required"

# The upstream pin alone is not a complete cache key: Laban's numbered patches
# can change while GHOSTTY_COMMIT remains fixed. Hash their contents in the same
# order in which they are applied and persist the result only after a successful
# Zig build.
patchset_fingerprint=$(
    for patch in $PATCH_ORDER; do
        git hash-object "$repo_root/$patch"
    done
)

patches_are_applied() {
    for patch in $PATCH_ORDER; do
        git -C "$DEST" apply --reverse --check "$repo_root/$patch" >/dev/null 2>&1 \
            || return 1
    done
    return 0
}

# A no-op requires all four parts of the vendored build identity: upstream pin,
# artifacts, patch-set stamp, and source state. The source check catches an
# interrupted or manually reset shared .external checkout even when an old
# stamp remains beside the archive.
if [ -f "$LIB_OUT" ] && [ -f "$HDR_OUT" ] && [ -d "$DEST/.git" ]; then
    stored=$(git -C "$DEST" rev-parse HEAD 2>/dev/null || echo "unknown")
    stamped=$(cat "$PATCH_STAMP" 2>/dev/null || echo "missing")
    if [ "$stored" = "$GHOSTTY_COMMIT" ] && \
       [ "$stamped" = "$patchset_fingerprint" ] && \
       patches_are_applied; then
        printf 'fetch-libghostty-vt: already at %s with current Laban patch set\n' \
            "$GHOSTTY_COMMIT"
        exit 0
    fi
    printf 'fetch-libghostty-vt: stale pin, patch set, or source state; rebuilding\n'
fi

# Clone or reset to the pinned commit.
if [ -d "$DEST/.git" ]; then
    stored=$(git -C "$DEST" rev-parse HEAD 2>/dev/null || echo "unknown")
    if [ "$stored" != "$GHOSTTY_COMMIT" ]; then
        printf 'fetch-libghostty-vt: removing stale clone at %s\n' "$DEST"
        rm -rf "$DEST"
    fi
fi

if [ ! -d "$DEST/.git" ]; then
    printf 'fetch-libghostty-vt: cloning Ghostty at %s\n' "$GHOSTTY_COMMIT"
    mkdir -p "$DEST"
    git init "$DEST"
    # Idempotent: a prior interrupted run may have left the remote behind, so
    # set-url when it already exists rather than erroring on a re-add.
    if git -C "$DEST" remote get-url origin >/dev/null 2>&1; then
        git -C "$DEST" remote set-url origin "$GHOSTTY_URL"
    else
        git -C "$DEST" remote add origin "$GHOSTTY_URL"
    fi
    # Fetch only the specific commit (GitHub supports this via partial clone).
    git -C "$DEST" fetch --depth=1 origin "$GHOSTTY_COMMIT"
    git -C "$DEST" checkout FETCH_HEAD
    printf 'fetch-libghostty-vt: clone done\n'
fi

actual=$(git -C "$DEST" rev-parse HEAD)
if [ "$actual" != "$GHOSTTY_COMMIT" ]; then
    fail "expected commit $GHOSTTY_COMMIT, got $actual"
fi

# A previous run may have applied only part of the patch series, or may have
# failed after applying it but before rebuilding. Remove the success stamp
# first, then restore the disposable vendored checkout to the pin so every
# patch below is applied exactly once.
rm -f "$PATCH_STAMP"
git -C "$DEST" reset --hard "$GHOSTTY_COMMIT" >/dev/null \
    || fail "failed to restore vendored source to $GHOSTTY_COMMIT"

# Apply local patches to the vendored source. Every modification lives as a
# reviewable patch in patches/ — never an inline sed — so its provenance is
# auditable as a diff and it applies identically on every platform.
#
# 0002 (stream.zig): rename the log scope to libghostty_vt_stream so log lines
# are clearly attributed to this library; downgrade unimplemented-mode warnings
# to debug so benign mode requests from programs like tmux don't surface as
# noise.
# 0001 (Terminal.zig): clear the alternate screen using the PRIMARY screen's pen, not the
# alternate screen's stale SGR background. Upstream switchScreenMode (mode 1049
# enter) erases the screen BEFORE copying the primary cursor; because each screen
# keeps its own cursor, the erase uses the previous alt-screen app's leftover pen.
# Re-entering the alt screen — e.g. quitting btop (black bg) then launching top —
# then repaints in the old app's background until the new app draws (a black
# flash). The patch reorders the cursor copy before the erase.
# See docs/adr/0011-libghostty-alt-screen-clear-uses-primary-pen.md.
# 0003 (device_status.zig, stream_terminal.zig, stream_handler.zig): answer
# DECXCPR (CSI ? 6 n) with the DEC-private form CSI ? row ; col R. Upstream
# only answers the plain CSI 6 n; apps prefer the ? form because a plain
# CSI row;col R reply is ambiguous with modified function-key input.
# See docs/adr/0019-libghostty-answers-decxcpr.md.
for patch in $PATCH_ORDER; do
    git -C "$DEST" apply "$repo_root/$patch" \
        || fail "failed to apply vendored patch $patch"
done

# Build libghostty-vt. Zig fetches its own dependencies on first build
# (~3-10 min). Subsequent builds use ~/.cache/zig and are fast.
#
# `-Doptimize=ReleaseFast` is critical: zig's default Debug build leaves
# `runtime_safety` on, which means `Page.verifyIntegrity` runs an O(N)
# hash-map walk on every `clearCells` operation. A workload that emits
# many EL/clear sequences (e.g. an interactive AI agent redrawing its
# UI) then takes O(N²) per screen and pegs the main thread to a halt.
# We're consuming libghostty as a vendored production artifact, not
# debugging into it — the swift side stays at -Onone for breakpoints
# regardless of how we built this static lib.
#
# If you ever DO need to step into libghostty under a debugger, the
# minimal-impact workaround is to stub out `verifyIntegrity` so the
# rest of runtime_safety stays live. Uncomment the sed below and drop
# the -Doptimize flag:
#
#   sed -i '' \
#     's/pub fn verifyIntegrity(self: \*const Page) void {/&\n    return;/' \
#     "$DEST/src/terminal/page.zig"
#
command -v zig >/dev/null 2>&1 \
    || fail "Zig 0.15.2 is required. Install via https://ziglang.org/download/"
zig_version=$(zig version 2>/dev/null || echo "unknown")
if [ "$zig_version" != "0.15.2" ]; then
    fail "Ghostty pin $GHOSTTY_COMMIT requires Zig 0.15.2 exactly; found $zig_version"
fi
printf 'fetch-libghostty-vt: running zig build -Demit-lib-vt -Doptimize=ReleaseFast (this may take a few minutes)\n'
cd "$repo_root/$DEST"
zig build -Demit-lib-vt -Doptimize=ReleaseFast

cd "$repo_root"
[ -f "$LIB_OUT" ] || fail "zig build did not produce $LIB_OUT"
[ -f "$HDR_OUT" ] || fail "zig build did not produce $HDR_OUT"

# SwiftPM does not track the static archive supplied through unsafeFlags. A
# newer mtime on this established bridge input makes every scratch build relink
# LabanTerminalCore after an actual vendored rebuild. Publish the patch stamp
# only after both the archive and relink trigger are ready.
touch "$repo_root/$RELINK_INPUT"
stamp_tmp="$PATCH_STAMP.tmp.$$"
printf '%s\n' "$patchset_fingerprint" > "$stamp_tmp"
mv "$stamp_tmp" "$PATCH_STAMP"

printf 'fetch-libghostty-vt: done. artifacts at %s/zig-out/\n' "$DEST"
