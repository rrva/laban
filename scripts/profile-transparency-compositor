class ProfileError(RuntimeError):
    pass


class ProfileTerminationSignalGuard:
    signals = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)

    def __init__(self) -> None:
        self.previous_handlers: dict[signal.Signals, Any] = {}
        self.handler = self._handle_signal
        self.defer_depth = 0
        self.pending_signal: int | None = None
        self.interrupted = False

    def __enter__(self) -> ProfileTerminationSignalGuard:
        try:
            for signum in self.signals:
                self.previous_handlers[signum] = signal.getsignal(signum)
                signal.signal(signum, self.handler)
        except (OSError, ValueError) as error:
            self.restore()
            fail(f"could not install profiling termination handler: {error}")
        return self

    def __exit__(self, _kind: Any, _value: Any, _traceback: Any) -> bool:
        self.restore()
        return False

    def restore(self) -> None:
        handlers = self.previous_handlers
        self.previous_handlers = {}
        for signum, handler in handlers.items():
            signal.signal(signum, handler)

    def defer(self) -> ProfileTerminationDeferral:
        return ProfileTerminationDeferral(self)

    def _handle_signal(self, signum: int, _frame: Any) -> None:
        if self.defer_depth > 0 or self.interrupted:
            if self.pending_signal is None:
                self.pending_signal = signum
            return
        self._raise_signal(signum)

    def _raise_signal(self, signum: int) -> None:
        self.interrupted = True
        try:
            name = signal.Signals(signum).name
        except ValueError:
            name = str(signum)
        fail(f"profiling interrupted by {name}")


class ProfileTerminationDeferral:
    def __init__(self, guard: ProfileTerminationSignalGuard) -> None:
        self.guard = guard

    def __enter__(self) -> ProfileTerminationDeferral:
        self.guard.defer_depth += 1
        return self

    def __exit__(self, _kind: Any, _value: Any, _traceback: Any) -> bool:
        self.guard.defer_depth -= 1
        if self.guard.defer_depth == 0 and self.guard.pending_signal is not None:
            signum = self.guard.pending_signal
            self.guard.pending_signal = None
            if not self.guard.interrupted:
                self.guard._raise_signal(signum)
        return False


def fail(message: str) -> None:
    raise ProfileError(message)


def command(arguments: list[str], label: str) -> str:
    completed = subprocess.run(arguments, check=False, text=True, capture_output=True)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip()
        fail(f"{label} failed: {detail}")
    return completed.stdout.strip()


def load_json(path: Path, label: str) -> dict[str, Any]:
    if not path.is_file():
        fail(f"{label} is missing: {path}")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"{label} is invalid: {error}")
    if not isinstance(value, dict):
        fail(f"{label} must be a JSON object")
    return value


def app_bundle_identifier(app_path: Path) -> str:
    info_plist = app_path / "Contents/Info.plist"
    try:
        with info_plist.open("rb") as handle:
            value = plistlib.load(handle)
    except (OSError, plistlib.InvalidFileException) as error:
        fail(f"installed app Info.plist is invalid: {error}")
    identifier = value.get("CFBundleIdentifier") if isinstance(value, dict) else None
    if not isinstance(identifier, str) or not identifier:
        fail("installed app has no bundle identifier")
    return identifier


def read_transparency_preferences(domain: str) -> dict[str, Any]:
    completed = subprocess.run(
        ["/usr/bin/defaults", "export", domain, "-"],
        check=False,
        capture_output=True,
    )
    if completed.returncode != 0:
        detail = completed.stderr.decode("utf-8", errors="replace").strip()
        if "does not exist" in detail:
            return {}
        fail(f"could not snapshot installed-app preferences: {detail}")
    try:
        value = plistlib.loads(completed.stdout)
    except plistlib.InvalidFileException as error:
        fail(f"installed-app preference snapshot is invalid: {error}")
    if not isinstance(value, dict):
        fail("installed-app preference snapshot is not a dictionary")
    snapshot = {
        key: value[key]
        for key in TRANSPARENCY_PREFERENCE_TYPES
        if key in value
    }
    validate_transparency_preference_snapshot(snapshot)
    return snapshot


def validate_transparency_preference_snapshot(snapshot: dict[str, Any]) -> None:
    for key, value in snapshot.items():
        kind = TRANSPARENCY_PREFERENCE_TYPES.get(key)
        if kind is None:
            fail(f"preference snapshot contains an unexpected key: {key}")
        if kind == "float":
            valid = isinstance(value, float) and math.isfinite(value)
        elif kind == "bool":
            valid = isinstance(value, bool)
        else:
            valid = isinstance(value, str)
        if not valid:
            fail(f"preference snapshot has the wrong type for {key}")


def restore_transparency_preferences(domain: str, snapshot: dict[str, Any]) -> None:
    validate_transparency_preference_snapshot(snapshot)
    for key, kind in TRANSPARENCY_PREFERENCE_TYPES.items():
        if key not in snapshot:
            subprocess.run(
                ["/usr/bin/defaults", "delete", domain, key],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            continue
        value = snapshot[key]
        if kind == "float":
            arguments = ["-float", repr(value)]
        elif kind == "bool":
            arguments = ["-bool", "true" if value else "false"]
        else:
            arguments = ["-string", value]
        completed = subprocess.run(
            ["/usr/bin/defaults", "write", domain, key, *arguments],
            check=False,
            text=True,
            capture_output=True,
        )
        if completed.returncode != 0:
            detail = completed.stderr.strip() or completed.stdout.strip()
            fail(f"could not restore installed-app preference {key}: {detail}")

    restored = read_transparency_preferences(domain)
    if not transparency_preference_snapshots_equal(restored, snapshot):
        differing = [
            key
            for key in TRANSPARENCY_PREFERENCE_TYPES
            if (key in restored) != (key in snapshot)
            or (
                key in restored
                and (
                    type(restored[key]) is not type(snapshot[key])
                    or restored[key] != snapshot[key]
                )
            )
        ]
        fail("installed-app preference restoration mismatch: " + ", ".join(differing))


def transparency_preference_snapshots_equal(
    left: dict[str, Any],
    right: dict[str, Any],
) -> bool:
    if left.keys() != right.keys():
        return False
    return all(
        type(left[key]) is type(right[key]) and left[key] == right[key]
        for key in left
    )


def validate_lane_contract(contract: dict[str, Any]) -> None:
    if set(contract) != set(IDENTITY_FIELDS):
        fail("lane contract fields do not match the required identity contract")
    if not isinstance(contract["osBuild"], str) or re.fullmatch(r"[0-9]{2}[A-Z][0-9]+[a-z]?", contract["osBuild"]) is None:
        fail("lane contract osBuild is malformed")
    lane = contract.get("lane")
    if lane == STABLE_LANE:
        if not isinstance(contract["osVersion"], str) or re.fullmatch(r"26(?:\.[0-9]+){1,2}", contract["osVersion"]) is None:
            fail("stable lane contract osVersion must be macOS 26.x")
        if contract["osReleaseChannel"] != "stable":
            fail("stable lane contract must pin the stable release channel")
        if contract["hardwareModel"] != "Macmini9,1" or contract["chipModel"] != "Apple M1":
            fail("stable lane contract must pin a base Apple M1 Mac mini")
        if contract["memoryBytes"] != EIGHT_GIB:
            fail("stable lane contract must pin exactly 8 GiB")
        if contract["displayHz"] != 60:
            fail("stable lane contract must pin exactly 60 Hz")
        return
    if lane == HIGH_REFRESH_LANE:
        if not isinstance(contract["osVersion"], str) or re.fullmatch(r"27(?:\.[0-9]+){1,2}", contract["osVersion"]) is None:
            fail("120 Hz lane contract osVersion must be macOS 27.x")
        if contract["osReleaseChannel"] not in ("stable", "developerSeed"):
            fail("120 Hz lane contract release channel must be stable or developerSeed")
        if not isinstance(contract["hardwareModel"], str) or not contract["hardwareModel"].startswith("Mac"):
            fail("120 Hz lane contract hardwareModel must identify a Mac")
        if not isinstance(contract["chipModel"], str) or not contract["chipModel"].startswith("Apple M"):
            fail("120 Hz lane contract chipModel must identify Apple silicon")
        if isinstance(contract["memoryBytes"], bool) or not isinstance(contract["memoryBytes"], int) or contract["memoryBytes"] <= 0:
            fail("120 Hz lane contract memoryBytes must be a positive exact byte count")
        if contract["displayHz"] != 120:
            fail("120 Hz lane contract must pin exactly 120 Hz")
        return
    fail("lane contract must name one of the two required compositor lanes")


def display_hz() -> int:
    raw = command(["system_profiler", "SPDisplaysDataType", "-json"], "display identity")
    try:
        report = json.loads(raw)
    except json.JSONDecodeError as error:
        fail(f"display identity was not JSON: {error}")
    rates: list[float] = []
    for adapter in report.get("SPDisplaysDataType", []):
        for display in adapter.get("spdisplays_ndrvs", []):
            if display.get("spdisplays_main") != "spdisplays_yes":
                continue
            for key, raw_value in display.items():
                key_lower = str(key).lower()
                text_value = str(raw_value)
                match: re.Match[str] | None = None
                if "refresh" in key_lower:
                    match = re.search(r"([0-9]+(?:\.[0-9]+)?)", text_value)
                elif "resolution" in key_lower:
                    match = re.search(r"@\s*([0-9]+(?:\.[0-9]+)?)\s*Hz", text_value)
                if match:
                    rates.append(float(match.group(1)))
    rounded_rates = {
        round(rate)
        for rate in rates
        if math.isfinite(rate) and abs(rate - round(rate)) <= 0.1
    }
    if len(rounded_rates) != 1:
        fail("could not identify exactly one main-display refresh rate")
    return int(next(iter(rounded_rates)))


def host_identity(contract: dict[str, Any]) -> dict[str, Any]:
    os_version = command(["sw_vers", "-productVersion"], "OS version")
    os_build = command(["sw_vers", "-buildVersion"], "OS build")
    # Release-channel classification is established by the checked-in contract's
    # exact version/build and its dated ExecPlan decision. A host with either
    # value changed is rejected rather than being inferred stable.
    release_channel = contract["osReleaseChannel"] if (
        os_version == contract["osVersion"] and os_build == contract["osBuild"]
    ) else "unverified"
    return {
        "lane": contract["lane"],
        "osVersion": os_version,
        "osBuild": os_build,
        "osReleaseChannel": release_channel,
        "hardwareModel": command(["sysctl", "-n", "hw.model"], "hardware model"),
        "chipModel": command(["sysctl", "-n", "machdep.cpu.brand_string"], "chip model"),
        "memoryBytes": int(command(["sysctl", "-n", "hw.memsize"], "memory size")),
        "displayHz": display_hz(),
    }


def validate_host(identity: dict[str, Any], contract: dict[str, Any]) -> None:
    mismatches = [field for field in IDENTITY_FIELDS if identity.get(field) != contract.get(field)]
    if mismatches:
        fail("host does not match lane contract: " + ", ".join(mismatches))


def wait_for_control(control_dir: Path, run_id: str, pid: int, timeout: float = 30.0) -> tuple[Path, str]:
    advertisement_path = control_dir / "control.json"
    deadline = time.monotonic() + timeout
    last_detail = "control.json not created"
    while time.monotonic() < deadline:
        if not process_alive(pid):
            fail("installed app exited before diagnostic control became ready")
        try:
            advertisement = load_json(advertisement_path, "diagnostic control advertisement")
            socket_path = Path(str(advertisement.get("url") or ""))
            token = advertisement.get("diagnosticControlToken")
            if advertisement.get("runId") != run_id:
                last_detail = "runId mismatch"
            elif advertisement.get("pid") != pid:
                last_detail = "pid mismatch"
            elif socket_path != control_dir / "control.sock":
                last_detail = "socket path mismatch"
            elif not stat.S_ISSOCK(socket_path.stat().st_mode):
                last_detail = "control socket is not live"
            elif not isinstance(token, str) or not token:
                last_detail = "diagnosticControlToken missing"
            else:
                return socket_path, token
        except (ProfileError, OSError):
            pass
        time.sleep(0.1)
    fail(f"diagnostic control readiness timed out: {last_detail}")


def process_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


class ControlClient:
    def __init__(self, socket_path: Path, token: str, control_dir: Path):
        self.socket_path = socket_path
        self.config_path = control_dir / "curl-diagnostic.conf"
        self.config_path.write_text(
            "silent\nshow-error\nfail-with-body\n"
            + f'header = "Authorization: Bearer {token}"\n',
            encoding="utf-8",
        )
        self.config_path.chmod(0o600)

    def close(self) -> None:
        try:
            self.config_path.unlink()
        except FileNotFoundError:
            pass

    def request(self, method: str, path: str, payload: dict[str, Any] | None = None) -> dict[str, Any]:
        arguments = [
            "curl",
            "--config",
            str(self.config_path),
            "--unix-socket",
            str(self.socket_path),
            "--request",
            method,
            "http://localhost" + path,
        ]
        if payload is not None:
            arguments += ["--header", "Content-Type: application/json", "--data-binary", json.dumps(payload, separators=(",", ":"))]
        completed = subprocess.run(arguments, check=False, text=True, capture_output=True)
        if completed.returncode != 0:
            fail(f"diagnostic {method} {path} failed: {completed.stderr.strip()}")
        try:
            value = json.loads(completed.stdout)
        except json.JSONDecodeError as error:
            fail(f"diagnostic {method} {path} returned invalid JSON: {error}")
        if not isinstance(value, dict):
            fail(f"diagnostic {method} {path} did not return an object")
        return value

    def action(self, action: str, **fields: Any) -> dict[str, Any]:
        return self.request("POST", "/debug/actions", {"action": action, **fields})

    def transparency(self) -> dict[str, Any]:
        return self.request("GET", "/debug/transparency")


BACKDROP_SOURCE = r'''import AppKit

final class BackdropView: NSView {
  let animated: Bool
  var phase: CGFloat = 0
  init(frame: NSRect, animated: Bool) {
    self.animated = animated
    super.init(frame: frame)
    if animated {
      Timer.scheduledTimer(withTimeInterval: 1.0 / 30.0, repeats: true) { [weak self] _ in
        guard let self else { return }
        self.phase = (self.phase + 6).truncatingRemainder(dividingBy: 160)
        self.needsDisplay = true
      }
    }
  }
  required init?(coder: NSCoder) { nil }
  override func draw(_ dirtyRect: NSRect) {
    NSColor.white.setFill(); dirtyRect.fill()
    let tile: CGFloat = 80
    let offset = animated ? phase : 0
    for row in -1...Int(bounds.height / tile) + 1 {
      for column in -1...Int(bounds.width / tile) + 1 where (row + column) % 2 == 0 {
        NSColor.black.setFill()
        NSRect(x: CGFloat(column) * tile + offset, y: CGFloat(row) * tile, width: tile, height: tile).fill()
      }
    }
    NSColor.systemRed.setFill(); NSRect(x: bounds.midX - 12 + offset, y: 0, width: 24, height: bounds.height).fill()
    NSColor.systemBlue.setFill(); NSRect(x: 0, y: bounds.midY - 12, width: bounds.width, height: 24).fill()
  }
}

final class Delegate: NSObject, NSApplicationDelegate {
  var window: NSWindow?
  func applicationDidFinishLaunching(_ notification: Notification) {
    guard let screen = NSScreen.main else { exit(2) }
    let animated = CommandLine.arguments.contains("--animated")
    let window = NSWindow(contentRect: screen.frame, styleMask: [.borderless], backing: .buffered, defer: false)
    window.level = NSWindow.Level(rawValue: NSWindow.Level.normal.rawValue - 1)
    window.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary]
    window.contentView = BackdropView(frame: screen.frame, animated: animated)
    window.orderFront(nil)
    self.window = window
    print("READY"); fflush(stdout)
  }
}

let app = NSApplication.shared
app.setActivationPolicy(.accessory)
let delegate = Delegate()
app.delegate = delegate
app.run()
'''


def build_backdrop_helper(work: Path) -> Path:
    source = work / "TransparencyBackdrop.swift"
    executable = work / "transparency-backdrop"
    source.write_text(BACKDROP_SOURCE, encoding="utf-8")
    completed = subprocess.run(
        ["xcrun", "swiftc", str(source), "-framework", "AppKit", "-o", str(executable)],
        check=False,
        text=True,
        capture_output=True,
    )
    if completed.returncode != 0:
        fail(f"could not build deterministic backdrop helper: {completed.stderr.strip()}")
    return executable


class OwnedProcesses:
    def __init__(self, termination_guard: ProfileTerminationSignalGuard) -> None:
        self.termination_guard = termination_guard
        self.processes: list[tuple[subprocess.Popen[Any], int]] = []

    def __enter__(self) -> OwnedProcesses:
        return self

    def __exit__(self, _kind: Any, _value: Any, _traceback: Any) -> bool:
        self.close()
        return False

    def start(self, arguments: list[str], **options: Any) -> subprocess.Popen[Any]:
        # A deferred signal cannot land after Popen created the child but before
        # this owner records it. The signal is raised as soon as registration is
        # complete, and the surrounding ownership scope then reaps the child.
        with self.termination_guard.defer():
            options["start_new_session"] = True
            process = subprocess.Popen(arguments, **options)
            self.processes.append((process, process.pid))
        return process

    def close(self) -> None:
        cleanup_errors: list[str] = []
        with self.termination_guard.defer():
            processes = list(reversed(self.processes))
            self.processes = []
            for process, process_group_id in processes:
                try:
                    terminate(process, process_group_id=process_group_id)
                except (OSError, subprocess.SubprocessError) as error:
                    cleanup_errors.append(str(error))
        if cleanup_errors:
            fail("could not terminate owned profiling process: " + "; ".join(cleanup_errors))


def start_backdrop(
    executable: Path,
    animated: bool,
    scenario_dir: Path,
    processes: OwnedProcesses,
) -> subprocess.Popen[str]:
    stdout = (scenario_dir / "backdrop.stdout.log").open("w", encoding="utf-8")
    stderr = (scenario_dir / "backdrop.stderr.log").open("w", encoding="utf-8")
    arguments = [str(executable)] + (["--animated"] if animated else [])
    try:
        process = processes.start(arguments, stdout=stdout, stderr=stderr, text=True)
    finally:
        stdout.close()
        stderr.close()
    readiness = scenario_dir / "backdrop.stdout.log"
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if process.poll() is not None:
            fail("deterministic backdrop helper exited before readiness")
        if readiness.is_file() and "READY" in readiness.read_text(encoding="utf-8", errors="replace"):
            return process
        time.sleep(0.1)
    fail("deterministic backdrop helper timed out")


def terminate(
    process: subprocess.Popen[Any],
    *,
    process_group_id: int | None = None,
    group_grace_seconds: float = 5.0,
    group_poll_interval: float = 0.05,
) -> None:
    group_error: OSError | None = None
    try:
        if process_group_id is not None:
            try:
                os.killpg(process_group_id, signal.SIGTERM)
            except ProcessLookupError:
                pass
            if not wait_for_process_group_disappearance(
                process_group_id,
                process,
                timeout=group_grace_seconds,
                poll_interval=group_poll_interval,
            ):
                try:
                    os.killpg(process_group_id, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                if not wait_for_process_group_disappearance(
                    process_group_id,
                    process,
                    timeout=group_grace_seconds,
                    poll_interval=group_poll_interval,
                ):
                    raise OSError(
                        f"profiling process group {process_group_id} survived SIGKILL"
                    )
    except OSError as error:
        group_error = error

    if process_group_id is None:
        try:
            process.terminate()
        except ProcessLookupError:
            pass

    # Reap the direct child independently of group liveness. A short-lived
    # wrapper may already be gone while xctrace/curl descendants remain in its
    # process group, or may have moved out of the original group itself.
    direct_error: OSError | subprocess.SubprocessError | None = None
    try:
        reap_direct_child(process)
    except (OSError, subprocess.SubprocessError) as error:
        direct_error = error
    if direct_error is not None:
        if group_error is not None:
            raise OSError(f"{group_error}; direct-child reap failed: {direct_error}")
        raise direct_error
    if group_error is not None:
        raise group_error


def reap_direct_child(process: subprocess.Popen[Any]) -> None:
    try:
        process.wait(timeout=5)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        process.terminate()
    except ProcessLookupError:
        pass
    try:
        process.wait(timeout=5)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        process.kill()
    except ProcessLookupError:
        pass
    process.wait(timeout=5)


def wait_for_process_group_disappearance(
    process_group_id: int,
    direct_child: subprocess.Popen[Any],
    *,
    timeout: float,
    poll_interval: float,
) -> bool:
    deadline = time.monotonic() + timeout
    while True:
        # poll() nonblockingly reaps a direct child that exited while the group
        # still had descendants; group liveness remains an independent check.
        direct_child.poll()
        try:
            os.killpg(process_group_id, 0)
        except ProcessLookupError:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(min(poll_interval, max(0.0, deadline - time.monotonic())))


def percentile(values: list[float], fraction: float) -> float:
    ordered = sorted(values)
    if not ordered:
        fail("CPU sampler produced no values")
    rank = (len(ordered) - 1) * fraction
    low = math.floor(rank)
    high = math.ceil(rank)
    if low == high:
        return ordered[low]
    return ordered[low] + (ordered[high] - ordered[low]) * (rank - low)


def sample_cpu(app_pid: int, window_server_pid: int, duration: int) -> tuple[list[float], list[float]]:
    app: list[float] = []
    window_server: list[float] = []
    deadline = time.monotonic() + duration
    while time.monotonic() < deadline:
        started = time.monotonic()
        output = command(
            ["ps", "-p", f"{app_pid},{window_server_pid}", "-o", "pid=,%cpu="],
            "CPU sampling",
        )
        found: dict[int, float] = {}
        for line in output.splitlines():
            fields = line.split()
            if len(fields) == 2:
                found[int(fields[0])] = float(fields[1])
        if app_pid not in found or window_server_pid not in found:
            fail("CPU sampling lost the app or WindowServer process")
        app.append(found[app_pid])
        window_server.append(found[window_server_pid])
        remaining = 1.0 - (time.monotonic() - started)
        if remaining > 0:
            time.sleep(remaining)
    if len(app) < duration - 1:
        fail("CPU sampler did not produce the required one-second cadence")
    return app, window_server


def counters(state: dict[str, Any]) -> dict[str, int]:
    result: dict[str, int] = {}
    for field in COUNTERS:
        value = state.get(field)
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            fail(f"/debug/transparency missing nonnegative counter {field}")
        result[field] = value
    return result


def observed_state(state: dict[str, Any]) -> dict[str, Any]:
    missing = [field for field in STATE_FIELDS if field not in state]
    if missing:
        fail("/debug/transparency is missing state fields: " + ", ".join(missing))
    return {field: state[field] for field in STATE_FIELDS}


def validate_managed_image_identity(state: dict[str, Any]) -> None:
    identifier = state.get("backgroundImageIdentifier")
    if not isinstance(identifier, str) or not identifier:
        fail("/debug/transparency is missing the managed image identifier")
    for field in ("backgroundImagePixelWidth", "backgroundImagePixelHeight"):
        value = state.get(field)
        if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
            fail(f"/debug/transparency is missing positive {field}")
    if state["backgroundImagePixelWidth"] * state["backgroundImagePixelHeight"] < HIGH_RESOLUTION_MINIMUM_PIXELS:
        fail("managed image fixture is not high resolution")
    digest = state.get("backgroundImageContentDigest")
    if not isinstance(digest, str) or re.fullmatch(r"[0-9a-f]{64}", digest) is None:
        fail("/debug/transparency is missing a SHA-256 image content digest")


def validate_scenario_state(
    state: dict[str, Any],
    *,
    name: str,
    opacity: float,
    source: str,
    scaling: str,
) -> None:
    validate_managed_image_identity(state)
    effective_source = "none" if opacity == 1.0 else source
    expected: dict[str, Any] = {
        "requestedOpacity": opacity,
        "effectiveOpacity": opacity,
        "requestedBlur": 0,
        "effectiveBlur": 0,
        "requestedBackdropStyle": source,
        "effectiveBackdropStyle": effective_source,
        "backgroundImageScaling": scaling,
        "backgroundImageState": "available",
        "applyToExplicitCellBackgrounds": False,
        "forceOpaqueReason": None,
        "surfaceOpaque": opacity == 1.0,
        "backdropSubviewCount": 1 if effective_source == "image" else 0,
        "backdropSubviewKind": "image" if effective_source == "image" else "none",
        "windowBlurAvailable": True,
        "windowBlurRadius": 0,
    }
    mismatches = [field for field, value in expected.items() if state.get(field) != value]
    if mismatches:
        fail(f"{name} did not reach its exact requested/effective identity: " + ", ".join(mismatches))


def wait_for_scenario_state(
    client: ControlClient,
    *,
    name: str,
    opacity: float,
    source: str,
    scaling: str,
    timeout: float = 15.0,
) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    last_error = "no state returned"
    while time.monotonic() < deadline:
        state = client.transparency()
        try:
            validate_scenario_state(
                state,
                name=name,
                opacity=opacity,
                source=source,
                scaling=scaling,
            )
            return state
        except ProfileError as error:
            last_error = str(error)
        time.sleep(0.1)
    fail(f"{name} state did not settle: {last_error}")


def configure_scenario(
    client: ControlClient,
    *,
    opacity: float,
    source: str,
    scaling: str,
) -> None:
    client.action(
        "setBackgroundTransparency",
        opacity=opacity,
        blur=0,
        applyToExplicitCellBackgrounds=False,
    )
    client.action("setBackgroundImageScaling", scaling=scaling)
    client.action("setBackgroundSource", source=source)


def validate_image_fixture(path: Path) -> tuple[str, str]:
    try:
        resolved = path.resolve(strict=True)
        relative = resolved.relative_to(REPOSITORY_ROOT.resolve())
    except (FileNotFoundError, ValueError):
        fail("image fixture must be an existing file contained by the repository")
    if not resolved.is_file() or resolved.stat().st_size == 0:
        fail("image fixture must be a nonempty regular file")
    command(
        ["git", "ls-files", "--error-unmatch", relative.as_posix()],
        "checked-in image fixture validation",
    )
    return relative.as_posix(), hashlib.sha256(resolved.read_bytes()).hexdigest()


def wait_for_imported_image(client: ControlClient, timeout: float = 15.0) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    last_error = "no state returned"
    while time.monotonic() < deadline:
        state = client.transparency()
        try:
            if state.get("backgroundImageState") != "available":
                fail("background image is not available")
            validate_managed_image_identity(state)
            return state
        except ProfileError as error:
            last_error = str(error)
        time.sleep(0.1)
    fail(f"managed image import did not settle: {last_error}")


def isolated_managed_image_path(control_dir: Path, state: dict[str, Any]) -> Path:
    identifier = state.get("backgroundImageIdentifier")
    if not isinstance(identifier, str) or re.fullmatch(r"image-[A-Za-z0-9-]+\.png", identifier) is None:
        fail("managed image identifier is not a path-safe run-scoped asset")
    directory = (control_dir / "background-images").resolve()
    path = (directory / identifier).resolve()
    try:
        path.relative_to(directory)
    except ValueError:
        fail("managed image escaped the isolated control directory")
    if not path.is_file():
        fail("run-scoped managed image is missing after import")
    return path


def relative_artifact(path: Path, root: Path) -> str:
    return path.resolve().relative_to(root.resolve()).as_posix()


def run_scenario(
    *,
    name: str,
    opacity: float,
    source: str,
    scaling: str,
    animated: bool,
    run: int,
    app_path: Path,
    app_pid: int,
    window_server_pid: int,
    client: ControlClient,
    backdrop_executable: Path,
    duration: int,
    artifacts: Path,
    termination_guard: ProfileTerminationSignalGuard,
) -> dict[str, Any]:
    scenario_dir = artifacts / name / f"run-{run}"
    scenario_dir.mkdir(parents=True)
    processes = OwnedProcesses(termination_guard)
    try:
        _ = start_backdrop(
            backdrop_executable,
            animated,
            scenario_dir,
            processes,
        )
        configure_scenario(client, opacity=opacity, source=source, scaling=scaling)
        command(["open", "-a", str(app_path)], "installed-app activation")
        _ = wait_for_scenario_state(
            client,
            name=name,
            opacity=opacity,
            source=source,
            scaling=scaling,
        )
        time.sleep(2)
        client.action("resetTransparencyDiagnostics")
        before_state = client.transparency()
        validate_scenario_state(
            before_state,
            name=name,
            opacity=opacity,
            source=source,
            scaling=scaling,
        )
        before = counters(before_state)

        cpu_profile = scenario_dir / "cpu.perf"
        metal_trace = scenario_dir / "metal.trace"
        metal_analysis = scenario_dir / "metal-analysis.json"
        cpu_log = (scenario_dir / "capture-profile.log").open("w", encoding="utf-8")
        try:
            cpu_capture = processes.start(
                [
                    str(REPOSITORY_ROOT / "scripts/capture-profile"),
                    "--pid", str(app_pid),
                    "--samples", str(duration * 10),
                    "--interval", "100 ms",
                    "--out", str(cpu_profile),
                ],
                stdout=cpu_log,
                stderr=subprocess.STDOUT,
                text=True,
            )
        finally:
            cpu_log.close()
        metal_log = (scenario_dir / "metal-analysis.log").open("w", encoding="utf-8")
        try:
            metal_capture = processes.start(
                [
                    sys.executable,
                    str(REPOSITORY_ROOT / "scripts/analyze-metal-trace"),
                    "--record", str(duration),
                    "--attach", str(app_pid),
                    "--record-output", str(metal_trace),
                    "--json-output", str(metal_analysis),
                    "--format", "none",
                ],
                stdout=metal_log,
                stderr=subprocess.STDOUT,
                text=True,
            )
        finally:
            metal_log.close()
        app_samples, window_samples = sample_cpu(app_pid, window_server_pid, duration)
        try:
            cpu_status = cpu_capture.wait(timeout=120)
            metal_status = metal_capture.wait(timeout=600)
        except subprocess.TimeoutExpired:
            fail(f"{name} run {run} trace capture timed out")
        if cpu_status != 0:
            fail(f"{name} run {run} in-process CPU capture failed")
        if metal_status != 0:
            fail(f"{name} run {run} Metal trace capture/analysis failed")
        for path, label in ((cpu_profile, "CPU profile"), (metal_trace, "Metal trace"), (metal_analysis, "Metal analysis")):
            nonempty = path.is_file() and path.stat().st_size > 0 if path.exists() else False
            if path.is_dir():
                nonempty = any(item.is_file() and item.stat().st_size > 0 for item in path.rglob("*"))
            if not nonempty:
                fail(f"{name} run {run} produced no {label}")

        after_state = client.transparency()
        validate_scenario_state(
            after_state,
            name=name,
            opacity=opacity,
            source=source,
            scaling=scaling,
        )
        if observed_state(after_state) != observed_state(before_state):
            fail(f"{name} run {run} requested/effective state drifted during sampling")
        after = counters(after_state)
        deltas = {field: after[field] - before[field] for field in COUNTERS}
        if any(value < 0 for value in deltas.values()):
            fail(f"{name} run {run} diagnostics counters moved backwards")
        return {
            "run": run,
            "durationSeconds": duration,
            "settlingSeconds": 2,
            "scenarioIdentity": {
                "name": name,
                "requestedOpacity": opacity,
                "requestedBackdropStyle": source,
                "backgroundImageScaling": scaling,
                "backdropAnimated": animated,
            },
            "observedState": observed_state(before_state),
            "appCPU": {
                "medianPercent": percentile(app_samples, 0.50),
                "p95Percent": percentile(app_samples, 0.95),
                "samples": len(app_samples),
            },
            "windowServerCPU": {
                "medianPercent": percentile(window_samples, 0.50),
                "p95Percent": percentile(window_samples, 0.95),
                "samples": len(window_samples),
            },
            "rendererPresentDelta": deltas["rendererPresentCount"],
            "accessibilityRefreshDelta": deltas["accessibilityRefreshCount"],
            "effectiveTransparencyApplyDelta": deltas["effectiveTransparencyApplyCount"],
            "transparencyRenderWakeDelta": deltas["transparencyRenderWakeCount"],
            "presentIntervalDeadlineMisses": deltas["presentIntervalDeadlineMisses"],
            "backgroundImageImportDelta": deltas["backgroundImageImportCount"],
            "backgroundImageDecodeDelta": deltas["backgroundImageDecodeCount"],
            "backgroundImageFileReadDelta": deltas["backgroundImageFileReadCount"],
            "backgroundImageApplyDelta": deltas["backgroundImageApplyCount"],
            "backgroundImageRedrawDelta": deltas["backgroundImageRedrawCount"],
            "tracePaths": {
                "cpuProfile": relative_artifact(cpu_profile, artifacts),
                "metalTrace": relative_artifact(metal_trace, artifacts),
                "metalAnalysis": relative_artifact(metal_analysis, artifacts),
            },
        }
    finally:
        processes.close()


def median(values: list[float]) -> float:
    ordered = sorted(values)
    return ordered[len(ordered) // 2]


def gate_scenarios(scenarios: dict[str, list[dict[str, Any]]]) -> list[str]:
    failures: list[str] = []
    for name, runs in scenarios.items():
        for run in runs:
            if run["presentIntervalDeadlineMisses"] != 0:
                failures.append(f"{name} run {run['run']} has deadline misses")
            if name.endswith("Static"):
                if run["rendererPresentDelta"] != 0:
                    failures.append(f"{name} run {run['run']} presented while static")
                if run["appCPU"]["medianPercent"] >= 1.0:
                    failures.append(f"{name} run {run['run']} app CPU median is not below 1.0%")
            for counter in IMAGE_LIFECYCLE_DELTAS:
                if run[counter] != 0:
                    failures.append(
                        f"{name} run {run['run']} grew settled image lifecycle counter {counter}"
                    )
    opaque = median([run["windowServerCPU"]["medianPercent"] for run in scenarios["opaqueStatic"]])
    direct = median([run["windowServerCPU"]["medianPercent"] for run in scenarios["directStatic"]])
    if direct > opaque + 2.0:
        failures.append("direct static WindowServer CPU median exceeds opaque by more than 2.0 points")
    frosted_static = median([run["windowServerCPU"]["medianPercent"] for run in scenarios["frostedStatic"]])
    if frosted_static > opaque + 8.0:
        failures.append("Frosted static WindowServer CPU median exceeds opaque by more than 8.0 points")
    opaque_animated = median([run["windowServerCPU"]["medianPercent"] for run in scenarios["opaqueAnimated"]])
    frosted_animated = median([run["windowServerCPU"]["medianPercent"] for run in scenarios["frostedAnimated"]])
    if frosted_animated > opaque_animated + 15.0:
        failures.append("Frosted animated WindowServer CPU median exceeds opaque by more than 15.0 points")
    for name in ("imageFillStatic", "imageFitStatic", "imageStretchStatic"):
        for run in scenarios[name]:
            if run["windowServerCPU"]["medianPercent"] > opaque + 2.0:
                failures.append(
                    f"{name} run {run['run']} WindowServer CPU median exceeds opaque "
                    "by more than 2.0 points"
                )
    return failures


def installed_executable(app_path: Path) -> Path:
    executable = app_path / "Contents/MacOS/LabanApp"
    if not app_path.is_dir() or not os.access(executable, os.X_OK):
        fail(f"installed app executable is missing: {executable}")
    return executable


def running_laban_pids() -> list[int]:
    completed = subprocess.run(["pgrep", "-x", "LabanApp"], check=False, text=True, capture_output=True)
    if completed.returncode not in (0, 1):
        fail(f"could not inspect existing Laban processes: {completed.stderr.strip()}")
    return [int(line) for line in completed.stdout.splitlines() if line.strip().isdigit()]


def run_profile(
    arguments: argparse.Namespace,
    termination_guard: ProfileTerminationSignalGuard,
) -> None:
    contract = load_json(arguments.lane_contract, "lane contract")
    validate_lane_contract(contract)
    if contract["lane"] != arguments.lane:
        fail("--lane does not match the lane contract")
    identity = host_identity(contract)
    validate_host(identity, contract)
    image_fixture_path, image_fixture_sha256 = validate_image_fixture(arguments.image_fixture)
    lane_contract_sha256 = hashlib.sha256(arguments.lane_contract.read_bytes()).hexdigest()
    executable = installed_executable(arguments.app)
    bundle_identifier = app_bundle_identifier(arguments.app)
    existing = running_laban_pids()
    if existing:
        fail("an existing LabanApp is running; close it before the isolated installed-app profile")
    if arguments.artifacts.exists() and any(arguments.artifacts.iterdir()):
        fail(f"artifact directory is not empty: {arguments.artifacts}")
    arguments.artifacts.mkdir(parents=True, exist_ok=True)
    (REPOSITORY_ROOT / ".tmp").mkdir(exist_ok=True)

    for required in ("curl", "open", "ps", "pgrep", "xcrun", "system_profiler", "sw_vers", "sysctl"):
        if shutil.which(required) is None:
            fail(f"missing required command: {required}")
    window_server = command(["pgrep", "-x", "WindowServer"], "WindowServer lookup").splitlines()
    if len(window_server) != 1:
        fail("expected exactly one WindowServer process")
    window_server_pid = int(window_server[0])

    with tempfile.TemporaryDirectory(prefix="transparency-compositor-", dir=REPOSITORY_ROOT / ".tmp") as temporary:
        work = Path(temporary)
        control_dir = work / "control"
        control_dir.mkdir(mode=0o700)
        fixture_relative_path = Path("fixtures") / arguments.image_fixture.name
        isolated_fixture = control_dir / fixture_relative_path
        isolated_fixture.parent.mkdir(mode=0o700)
        shutil.copy2(arguments.image_fixture, isolated_fixture)
        backdrop_executable = build_backdrop_helper(work)
        run_id = f"transparency-compositor-{os.getpid()}"
        environment = os.environ.copy()
        environment.update({
            "LABAN_GUI_FIXTURE_CONTROL": "1",
            "LABAN_CONTROL_DIR": str(control_dir),
            "LABAN_RUN_ID": run_id,
        })
        app_stdout = (arguments.artifacts / "app.stdout.log").open("w", encoding="utf-8")
        app_stderr = (arguments.artifacts / "app.stderr.log").open("w", encoding="utf-8")
        preference_snapshot = read_transparency_preferences(bundle_identifier)
        processes = OwnedProcesses(termination_guard)
        client: ControlClient | None = None
        run_managed_image: Path | None = None
        try:
            try:
                app_process = processes.start(
                    [
                        str(executable),
                        "--no-persistence",
                        "--terminal-backend=in-process",
                        "--profile-recorder",
                    ],
                    env=environment,
                    stdout=app_stdout,
                    stderr=app_stderr,
                    text=True,
                )
            finally:
                app_stdout.close()
                app_stderr.close()
            socket_path, token = wait_for_control(control_dir, run_id, app_process.pid)
            client = ControlClient(socket_path, token, control_dir)
            client.action(
                "importBackgroundImage",
                path=fixture_relative_path.as_posix(),
                scaling="fill",
            )
            imported_image_state = wait_for_imported_image(client)
            run_managed_image = isolated_managed_image_path(control_dir, imported_image_state)
            managed_image_identity = {
                field: imported_image_state[field]
                for field in (
                    "backgroundImageIdentifier",
                    "backgroundImagePixelWidth",
                    "backgroundImagePixelHeight",
                    "backgroundImageContentDigest",
                )
            }
            scenarios: dict[str, list[dict[str, Any]]] = {
                name: [] for name, _, _, _, _ in SCENARIOS
            }
            for run in range(1, arguments.runs + 1):
                for name, opacity, source, scaling, animated in SCENARIOS:
                    print(f"profile-transparency-compositor: {name} run {run}/{arguments.runs}", file=sys.stderr)
                    scenarios[name].append(run_scenario(
                        name=name,
                        opacity=opacity,
                        source=source,
                        scaling=scaling,
                        animated=animated,
                        run=run,
                        app_path=arguments.app,
                        app_pid=app_process.pid,
                        window_server_pid=window_server_pid,
                        client=client,
                        backdrop_executable=backdrop_executable,
                        duration=arguments.duration,
                        artifacts=arguments.artifacts,
                        termination_guard=termination_guard,
                    ))
            failures = gate_scenarios(scenarios)
            summary = {
                "schemaVersion": 2,
                "benchmark": "terminal-background-transparency-compositor",
                **identity,
                "laneContractSHA256": lane_contract_sha256,
                "imageFixture": {
                    "path": image_fixture_path,
                    "sha256": image_fixture_sha256,
                },
                "managedImageIdentity": managed_image_identity,
                "durationSeconds": arguments.duration,
                "settlingSeconds": 2,
                "runsPerScenario": arguments.runs,
                "scenarios": scenarios,
                "validation": {"passed": not failures, "failures": failures},
            }
            summary_path = arguments.artifacts / "summary.json"
            temporary_summary = summary_path.with_suffix(f".json.tmp.{os.getpid()}")
            temporary_summary.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
            temporary_summary.replace(summary_path)
            if failures:
                fail("; ".join(failures))
            print(f"profile-transparency-compositor: summary={summary_path}")
        finally:
            with termination_guard.defer():
                cleanup_errors: list[str] = []
                if client is not None:
                    try:
                        client.action("removeBackgroundImage")
                    except ProfileError:
                        # The generated asset is confined to control_dir and is
                        # removed below if the app can no longer service actions.
                        pass
                    client.close()
                try:
                    processes.close()
                except ProfileError as error:
                    cleanup_errors.append(str(error))
                if run_managed_image is not None:
                    try:
                        run_managed_image.unlink(missing_ok=True)
                    except OSError as error:
                        cleanup_errors.append(f"could not remove run-scoped managed image: {error}")
                    if run_managed_image.exists():
                        cleanup_errors.append("run-scoped managed image remained after cleanup")
                try:
                    restore_transparency_preferences(bundle_identifier, preference_snapshot)
                except ProfileError as error:
                    cleanup_errors.append(str(error))
                if cleanup_errors:
                    fail("; ".join(cleanup_errors))


def self_test_preference_restoration() -> None:
    domain = (
        "com.laban.profile-transparency-compositor.self-test."
        f"{os.getpid()}.{time.time_ns()}"
    )
    complete = {
        "LabanTerminalBackgroundOpacity": 0.875,
        "LabanTerminalApplyOpacityToExplicitCellBackgrounds": True,
        "LabanTerminalBackdropStyle": "image",
        "LabanTerminalBackgroundImageScaling": "fit",
        "LabanTerminalBackgroundImageIdentifier": "image-original.png",
        "LabanTerminalBackgroundImageDisplayName": "Original.png",
    }
    sparse = {
        "LabanTerminalBackgroundOpacity": 1.0,
        "LabanTerminalApplyOpacityToExplicitCellBackgrounds": False,
        "LabanTerminalBackdropStyle": "none",
    }
    try:
        restore_transparency_preferences(domain, complete)
        restore_transparency_preferences(domain, {})
        restore_transparency_preferences(domain, complete)
        if not transparency_preference_snapshots_equal(
            read_transparency_preferences(domain), complete
        ):
            fail("self-test did not restore all six transparency preferences")

        restore_transparency_preferences(domain, sparse)
        if not transparency_preference_snapshots_equal(
            read_transparency_preferences(domain), sparse
        ):
            fail("self-test did not restore absent transparency preferences")
        if transparency_preference_snapshots_equal(
            {"LabanTerminalApplyOpacityToExplicitCellBackgrounds": True},
            {"LabanTerminalApplyOpacityToExplicitCellBackgrounds": 1},
        ):
            fail("self-test accepted a preference type mismatch")
    finally:
        subprocess.run(
            ["/usr/bin/defaults", "delete", domain],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def self_test_termination_signal_guard() -> None:
    original = {
        signum: signal.getsignal(signum)
        for signum in ProfileTerminationSignalGuard.signals
    }
    for interrupted_by in ProfileTerminationSignalGuard.signals:
        guard = ProfileTerminationSignalGuard()
        try:
            with guard:
                for signum in ProfileTerminationSignalGuard.signals:
                    if signal.getsignal(signum) != guard.handler:
                        fail("self-test did not install a profiling termination handler")
                guard.handler(interrupted_by, None)
        except ProfileError as error:
            if signal.Signals(interrupted_by).name not in str(error):
                fail("self-test termination handler reported the wrong signal")
        else:
            fail("self-test termination handler did not interrupt profiling")
        for signum, handler in original.items():
            if signal.getsignal(signum) != handler:
                fail("self-test did not restore the prior signal handler")

    guard = ProfileTerminationSignalGuard()
    try:
        with guard:
            raise RuntimeError("self-test sentinel")
    except RuntimeError:
        pass
    for signum, handler in original.items():
        if signal.getsignal(signum) != handler:
            fail("self-test exception path did not restore the prior signal handler")

    for deferred_signal in ProfileTerminationSignalGuard.signals:
        critical_section_completed = False
        guard = ProfileTerminationSignalGuard()
        try:
            with guard:
                with guard.defer():
                    guard.handler(deferred_signal, None)
                    critical_section_completed = True
        except ProfileError as error:
            if signal.Signals(deferred_signal).name not in str(error):
                fail("self-test deferred termination reported the wrong signal")
        else:
            fail("self-test deferred termination did not interrupt after cleanup")
        if not critical_section_completed:
            fail("self-test termination interrupted a deferred cleanup section")
        for signum, handler in original.items():
            if signal.getsignal(signum) != handler:
                fail("self-test deferred termination did not restore the prior handler")

    reentrant_cleanup_completed = False
    guard = ProfileTerminationSignalGuard()
    with guard:
        try:
            guard.handler(signal.SIGTERM, None)
        except ProfileError:
            with guard.defer():
                guard.handler(signal.SIGHUP, None)
                reentrant_cleanup_completed = True
    if not reentrant_cleanup_completed:
        fail("self-test reentrant termination interrupted cleanup")
    for signum, handler in original.items():
        if signal.getsignal(signum) != handler:
            fail("self-test reentrant termination did not restore the prior handler")


def self_test_owned_process_cleanup() -> None:
    class FakeProcess:
        def __init__(self, pid: int) -> None:
            self.pid = pid
            self.returncode: int | None = None
            self.terminate_count = 0
            self.wait_count = 0
            self.kill_count = 0

        def poll(self) -> int | None:
            return self.returncode

        def terminate(self) -> None:
            self.terminate_count += 1
            self.returncode = -signal.SIGTERM

        def wait(self, timeout: float | None = None) -> int:
            _ = timeout
            self.wait_count += 1
            return self.returncode or 0

        def kill(self) -> None:
            self.kill_count += 1
            self.returncode = -signal.SIGKILL

    original_popen = subprocess.Popen
    original_killpg = os.killpg
    created: list[FakeProcess] = []
    group_alive: dict[int, bool] = {}
    ignore_group_sigterm: set[int] = set()
    group_sigkill_count: dict[int, int] = {}
    guard = ProfileTerminationSignalGuard()
    inject_signal = True

    def fake_popen(_arguments: list[str], **options: Any) -> FakeProcess:
        if options.get("start_new_session") is not True:
            fail("self-test child was not isolated in an owned process group")
        process = FakeProcess(10_000 + len(created))
        created.append(process)
        group_alive[process.pid] = True
        if inject_signal and len(created) == 2:
            # OwnedProcesses.start has created the child but has not returned;
            # this is the adversarial window that previously leaked a process.
            guard.handler(signal.SIGTERM, None)
        return process

    def fake_killpg(process_group_id: int, signum: int) -> None:
        if not group_alive.get(process_group_id, False):
            raise ProcessLookupError(process_group_id)
        process = next(
            (candidate for candidate in created if candidate.pid == process_group_id),
            None,
        )
        if process is None:
            raise ProcessLookupError(process_group_id)
        if signum == 0:
            return
        if signum == signal.SIGTERM:
            if process.returncode is None:
                process.terminate()
            if process_group_id not in ignore_group_sigterm:
                group_alive[process_group_id] = False
        elif signum == signal.SIGKILL:
            if process.returncode is None:
                process.kill()
            group_alive[process_group_id] = False
            group_sigkill_count[process_group_id] = (
                group_sigkill_count.get(process_group_id, 0) + 1
            )
        else:
            fail("self-test process group received an unexpected signal")

    subprocess.Popen = fake_popen  # type: ignore[assignment]
    os.killpg = fake_killpg  # type: ignore[assignment]
    try:
        try:
            with guard:
                with OwnedProcesses(guard) as processes:
                    _ = processes.start(["first"])
                    _ = processes.start(["second"])
        except ProfileError:
            pass
        else:
            fail("self-test injected termination did not interrupt process startup")
        if len(created) != 2:
            fail("self-test did not create both adversarial child processes")
        if any(
            process.terminate_count != 1
            or process.wait_count != 1
            or process.kill_count != 0
            for process in created
        ):
            fail("self-test did not terminate and reap every adversarial child")

        created = []
        inject_signal = False
        guard = ProfileTerminationSignalGuard()
        try:
            with guard:
                with OwnedProcesses(guard) as processes:
                    _ = processes.start(["first"])
                    _ = processes.start(["second"])
                    raise RuntimeError("self-test process-owner sentinel")
        except RuntimeError:
            pass
        if len(created) != 2 or any(
            process.terminate_count != 1 or process.wait_count != 1
            for process in created
        ):
            fail("self-test arbitrary error orphaned an owned child")

        # The direct wrapper has already exited, but a descendant keeps its
        # process group alive and ignores SIGTERM. Cleanup must still observe
        # group liveness, escalate the group, and reap the direct child.
        created = [FakeProcess(20_000)]
        wrapper = created[0]
        wrapper.returncode = 0
        group_alive[wrapper.pid] = True
        ignore_group_sigterm.add(wrapper.pid)
        terminate(
            wrapper,
            process_group_id=wrapper.pid,
            group_grace_seconds=0,
            group_poll_interval=0,
        )
        if group_alive[wrapper.pid]:
            fail("self-test left a descendant process group alive")
        if group_sigkill_count.get(wrapper.pid) != 1:
            fail("self-test did not SIGKILL a surviving descendant process group")
        if wrapper.wait_count != 1:
            fail("self-test did not reap an already-exited direct child")

        direct_child = FakeProcess(30_000)
        terminate(direct_child)
        if direct_child.terminate_count != 1 or direct_child.wait_count != 1:
            fail("self-test regressed non-group process termination")
    finally:
        subprocess.Popen = original_popen
        os.killpg = original_killpg


def self_test() -> None:
    self_test_termination_signal_guard()
    self_test_owned_process_cleanup()
    self_test_preference_restoration()
    fixture_path, fixture_sha256 = validate_image_fixture(DEFAULT_IMAGE_FIXTURE)
    if fixture_path != "fixtures/transparency/background-gradient.png" or re.fullmatch(r"[0-9a-f]{64}", fixture_sha256) is None:
        fail("self-test did not validate the checked-in high-resolution image fixture")
    contract = {
        "lane": STABLE_LANE,
        "osVersion": "26.5.1",
        "osBuild": "25F80",
        "osReleaseChannel": "stable",
        "hardwareModel": "Macmini9,1",
        "chipModel": "Apple M1",
        "memoryBytes": EIGHT_GIB,
        "displayHz": 60,
    }
    validate_lane_contract(contract)
    validate_host(dict(contract), contract)
    high_refresh_contract = {
        "lane": HIGH_REFRESH_LANE,
        "osVersion": "27.0",
        "osBuild": "26A123a",
        "osReleaseChannel": "developerSeed",
        "hardwareModel": "Mac16,1",
        "chipModel": "Apple M4 Pro",
        "memoryBytes": 24 * 1024 * 1024 * 1024,
        "displayHz": 120,
    }
    validate_lane_contract(high_refresh_contract)
    validate_host(dict(high_refresh_contract), high_refresh_contract)
    try:
        validate_lane_contract(dict(high_refresh_contract, displayHz=60))
    except ProfileError:
        pass
    else:
        fail("self-test accepted 60 Hz for the 120 Hz lane")
    wrong = dict(contract, memoryBytes=16 * 1024 * 1024 * 1024)
    try:
        validate_host(wrong, contract)
    except ProfileError:
        pass
    else:
        fail("self-test accepted a 16 GiB host for the 8 GiB lane")
    counter_state = {field: 0 for field in COUNTERS}
    if counters(counter_state) != counter_state:
        fail("self-test did not preserve the exact diagnostics counters")
    missing_counter = dict(counter_state)
    missing_counter.pop("backgroundImageFileReadCount")
    try:
        counters(missing_counter)
    except ProfileError:
        pass
    else:
        fail("self-test accepted a missing image lifecycle counter")
    scenarios: dict[str, list[dict[str, Any]]] = {}
    for name, opacity, source, scaling, animated in SCENARIOS:
        effective_source = "none" if opacity == 1.0 else source
        state = {
            "requestedOpacity": opacity,
            "effectiveOpacity": opacity,
            "requestedBlur": 0,
            "effectiveBlur": 0,
            "requestedBackdropStyle": source,
            "effectiveBackdropStyle": effective_source,
            "backgroundImageScaling": scaling,
            "backgroundImageState": "available",
            "applyToExplicitCellBackgrounds": False,
            "forceOpaqueReason": None,
            "surfaceOpaque": opacity == 1.0,
            "backdropSubviewCount": 1 if effective_source == "image" else 0,
            "backdropSubviewKind": "image" if effective_source == "image" else "none",
            "windowBlurAvailable": True,
            "windowBlurRadius": 0,
            "backgroundImageIdentifier": "image-self-test.png",
            "backgroundImagePixelWidth": 1920,
            "backgroundImagePixelHeight": 1080,
            "backgroundImageContentDigest": "a" * 64,
        }
        validate_scenario_state(
            state,
            name=name,
            opacity=opacity,
            source=source,
            scaling=scaling,
        )
        window_server = {
            "opaqueStatic": 1.0,
            "opaqueAnimated": 2.0,
            "directStatic": 2.0,
            "directAnimated": 2.0,
            "frostedStatic": 8.0,
            "frostedAnimated": 16.0,
            "imageFillStatic": 2.0,
            "imageFitStatic": 2.0,
            "imageStretchStatic": 2.0,
        }[name]
        scenarios[name] = [{
            "run": run,
            "appCPU": {"medianPercent": 0.2},
            "windowServerCPU": {"medianPercent": window_server},
            "rendererPresentDelta": 0,
            "presentIntervalDeadlineMisses": 0,
            "backgroundImageImportDelta": 0,
            "backgroundImageDecodeDelta": 0,
            "backgroundImageFileReadDelta": 0,
            "backgroundImageApplyDelta": 0,
            "backgroundImageRedrawDelta": 0,
        } for run in range(1, 6)]
    if gate_scenarios(scenarios):
        fail("self-test rejected valid fixed thresholds")
    scenarios["opaqueStatic"][0]["rendererPresentDelta"] = 1
    if not gate_scenarios(scenarios):
        fail("self-test accepted a static renderer present")
    scenarios["opaqueStatic"][0]["rendererPresentDelta"] = 0
    scenarios["imageFillStatic"][0]["backgroundImageFileReadDelta"] = 1
    if not gate_scenarios(scenarios):
        fail("self-test accepted a settled image file read")
    scenarios["imageFillStatic"][0]["backgroundImageFileReadDelta"] = 0
    for counter in ("backgroundImageApplyDelta", "backgroundImageRedrawDelta"):
        scenarios["imageFillStatic"][0][counter] = 1
        if not gate_scenarios(scenarios):
            fail(f"self-test accepted settled image lifecycle growth for {counter}")
        scenarios["imageFillStatic"][0][counter] = 0
    opaque_median = median([
        run["windowServerCPU"]["medianPercent"] for run in scenarios["opaqueStatic"]
    ])
    scenarios["imageFitStatic"][0]["windowServerCPU"]["medianPercent"] = opaque_median + 2.1
    if not gate_scenarios(scenarios):
        fail("self-test accepted one over-budget Image/Fit run hidden by the aggregate median")
    scenarios["imageFitStatic"][0]["windowServerCPU"]["medianPercent"] = 2.0
    for case_name, baseline_name, excess in (
        ("directStatic", "opaqueStatic", 2.1),
        ("frostedStatic", "opaqueStatic", 8.1),
        ("frostedAnimated", "opaqueAnimated", 15.1),
    ):
        baseline = median([
            run["windowServerCPU"]["medianPercent"] for run in scenarios[baseline_name]
        ])
        previous = [
            run["windowServerCPU"]["medianPercent"] for run in scenarios[case_name]
        ]
        for run in scenarios[case_name]:
            run["windowServerCPU"]["medianPercent"] = baseline + excess
        if not gate_scenarios(scenarios):
            fail(f"self-test accepted the {case_name} WindowServer budget violation")
        for run, value in zip(scenarios[case_name], previous):
            run["windowServerCPU"]["medianPercent"] = value


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--app", type=Path)
    parser.add_argument("--lane")
    parser.add_argument("--lane-contract", type=Path)
    parser.add_argument("--duration", type=int)
    parser.add_argument("--runs", type=int)
    parser.add_argument("--artifacts", type=Path)
    parser.add_argument("--image-fixture", type=Path)
    parser.add_argument("--self-test", action="store_true")
    arguments = parser.parse_args()
    if arguments.self_test:
        if any((arguments.app, arguments.lane, arguments.lane_contract, arguments.duration, arguments.runs, arguments.artifacts, arguments.image_fixture)):
            parser.error("--self-test cannot be combined with capture arguments")
        return arguments
    if not all((arguments.app, arguments.lane, arguments.lane_contract, arguments.duration, arguments.runs, arguments.artifacts)):
        parser.error("all capture arguments are required")
    if arguments.lane not in REQUIRED_LANES:
        parser.error("--lane must name one of the two required compositor lanes")
    if arguments.duration != 60:
        parser.error("--duration must be 60")
    if arguments.runs != 5:
        parser.error("--runs must be 5")
    if arguments.image_fixture is None:
        arguments.image_fixture = DEFAULT_IMAGE_FIXTURE
    return arguments


def main() -> int:
    arguments = parse_arguments()
    try:
        if arguments.self_test:
            self_test()
            print("profile-transparency-compositor: self-test passed")
        else:
            with ProfileTerminationSignalGuard() as termination_guard:
                run_profile(arguments, termination_guard)
        return 0
    except (ProfileError, ValueError) as error:
        print(f"profile-transparency-compositor: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
