#!/usr/bin/env sh
# Build a *profilable release* Laban.app and install it over ~/Laban.app, with
# its .dSYM placed next to the bundle so `sample`, Instruments, and xctrace
# resolve symbols and line numbers.
#
# `build-app` defaults to a *debug* (-Onone) bundle: generics go unspecialised,
# so a debug build mis-reports CPU hot paths (e.g. String/Span generic dispatch
# that the optimiser removes in release). Profiling the shipped app means
# profiling release. This wraps `build-app --profile` (release + dSYM, no strip)
# and replaces the installed bundle.
#
# Does NOT launch the app — quit and relaunch Laban yourself to pick up the
# new build (a windowless launch from the shell grabs the single-instance lock).
#
# Usage:
#   scripts/install-app                          # -> ~/Laban.app  (+ ~/Laban.app.dSYM)
#   LABAN_INSTALL_DIR=/Applications scripts/install-app
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

install_dir="${LABAN_INSTALL_DIR:-$HOME}"
dest="${install_dir%/}/Laban.app"
src=".build/laban/Laban.app"

# A brand-new worktree's `.build` starts empty, so the first `swift build`
# pays to re-resolve and re-fetch every pinned dependency (swift-nio,
# swift-crypto, ...) even though the main checkout already has them on disk.
# `.build/checkouts` and `.build/repositories` hold only fetched dependency
# sources and git metadata, not this worktree's compiled output, so they are
# safe to clone from the main checkout: SwiftPM re-validates them against
# Package.resolved and re-fetches on any mismatch, so a stale or unrelated
# clone just falls back to normal resolution instead of misbuilding.
if [ ! -d ".build/checkouts" ]; then
  main_git_dir=$(git rev-parse --git-common-dir 2>/dev/null || echo "")
  case "$main_git_dir" in
    /*) : ;;
    "") main_git_dir="" ;;
    *) main_git_dir="$repo_root/$main_git_dir" ;;
  esac
  if [ -n "$main_git_dir" ]; then
    main_root=$(CDPATH= cd -- "$(dirname -- "$main_git_dir")" && pwd)
    if [ "$main_root" != "$repo_root" ] && [ -d "$main_root/.build/checkouts" ]; then
      printf 'install-app: seeding .build from %s (first build in this worktree)\n' "$main_root"
      mkdir -p .build
      cp -c -R "$main_root/.build/checkouts" .build/checkouts
      [ -d "$main_root/.build/repositories" ] && cp -c -R "$main_root/.build/repositories" .build/repositories
      [ -f "$main_root/.build/workspace-state.json" ] && cp -c "$main_root/.build/workspace-state.json" .build/workspace-state.json
    fi
  fi
fi

# Profilable release build: -c release + dSYM emitted next to the bundle, no
# strip and no path scrub (so Instruments keeps the debug map).
./scripts/build-app --profile

if [ ! -x "$src/Contents/MacOS/LabanApp" ]; then
  printf 'install-app failed: %s missing after `build-app --profile`\n' "$src" >&2
  exit 1
fi

# Replace the bundle and its debug map in lockstep. A stale .dSYM left beside a
# new binary would mis-symbolicate by UUID, so it is removed and recopied too.
# ditto preserves the ad-hoc code signature and bundle layout.
rm -rf "$dest" "${dest}.dSYM"
ditto "$src" "$dest"
if [ -d "${src}.dSYM" ]; then
  ditto "${src}.dSYM" "${dest}.dSYM"
fi

stamp=$(/usr/libexec/PlistBuddy -c 'Print :LABANBuildCommit' \
  "$dest/Contents/Info.plist" 2>/dev/null || echo unknown)
printf 'install-app: installed profilable release build %s -> %s\n' "$stamp" "$dest"
if [ -d "${dest}.dSYM" ]; then
  printf 'install-app: dSYM at %s\n' "${dest}.dSYM"
fi
printf 'install-app: quit and relaunch Laban to pick up the new build\n'
