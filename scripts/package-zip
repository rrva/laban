#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/package-zip <version>

Environment:
  LABAN_BUILD_NUMBER          Build number stamped into Info.plist. Defaults to
                              the current epoch seconds (monotonic, so Sparkle
                              can compare builds).
  LABAN_SPARKLE_FEED_URL      Sparkle appcast URL stamped into Info.plist as
                              SUFeedURL. Defaults to the appcast committed on
                              the main branch. Set empty to omit Sparkle keys.
  LABAN_RELEASE_DIR           Zip output directory. Defaults to .artifacts/release.
  LABAN_CODESIGN_IDENTITY     Signing identity. Defaults to the release
                              identity below; set to "-" for ad-hoc signing.
  LABAN_NOTARY_PROFILE        notarytool keychain profile. When set, the zip is
                              submitted for notarization and the app is stapled
                              before the final zip is produced. When unset, the
                              zip is left un-notarized (with a loud warning).
  LABAN_SKIP_CODESIGN         Defaults to 0. Skipped bundles may not launch.
  LABAN_BUILD_CONFIG          Swift build config (debug|release). Defaults to release
                              for distribution; release builds emit no in-binary DWARF.
EOF
  exit 2
}

[ "$#" -eq 1 ] || usage

app_version=$1
[ -n "$app_version" ] || usage

# Release builds are signed with the distribution identity by default so a
# downloaded zip carries a valid Developer ID signature. The identity is
# public information (it is embedded in every signed binary), so keeping
# the default here is not a secret leak; build-app's ad-hoc default for
# local dev builds is unchanged. Set LABAN_CODESIGN_IDENTITY=- for ad-hoc.
release_codesign_identity="Developer ID Application: Ragnar Rova (3563RJWBQP)"
export LABAN_CODESIGN_IDENTITY=${LABAN_CODESIGN_IDENTITY:-$release_codesign_identity}

export LABAN_APP_VERSION=$app_version
# Sparkle compares CFBundleVersion, not the marketing version, so the build
# number must increase between releases. Epoch seconds are monotonic and
# stateless; LABAN_BUILD_NUMBER overrides.
export LABAN_BUILD_NUMBER=${LABAN_BUILD_NUMBER:-$(date +%s)}
default_sparkle_feed_url="https://raw.githubusercontent.com/rrva/laban/main/appcast.xml"
export LABAN_SPARKLE_FEED_URL=${LABAN_SPARKLE_FEED_URL:-$default_sparkle_feed_url}
# Distribution builds optimize and skip emitting in-binary DWARF; combined
# with the prefix-map flags in build-app, this is what lets a public zip
# stay free of build-host paths.
export LABAN_BUILD_CONFIG=${LABAN_BUILD_CONFIG:-release}

release_dir=${LABAN_RELEASE_DIR:-.artifacts/release}
app_bundle=".build/laban/Laban.app"
plist="${app_bundle}/Contents/Info.plist"
zip_path="${release_dir}/Laban-${app_version}.zip"
tmp_zip="${zip_path}.tmp"

mkdir -p "$release_dir"

# Wipe the SwiftPM build cache before a release build by default.
# Releases are rare, the cache-staleness failure mode is hard to
# distinguish from a successful build at the script level, and we have
# at least one shipping example where a stale cache silently produced
# a binary whose optimizer dead-stripped a UI parameter because it
# inherited a pre-refactor module signature. The full clean costs
# ~30-60s and is the only reliable way to keep that class of bug out
# of a release. Set LABAN_SKIP_CLEAN_BUILD=1 to opt out.
if [ "${LABAN_SKIP_CLEAN_BUILD:-0}" != "1" ]; then
  printf 'package-zip: wiping .build for a clean release build\n'
  rm -rf .build
fi

rm -rf "$app_bundle"
LABAN_SKIP_CODESIGN=${LABAN_SKIP_CODESIGN:-0} ./scripts/build-app

[ -d "$app_bundle" ] || {
  printf 'package-zip failed: missing %s\n' "$app_bundle" >&2
  exit 1
}

# Defense in depth against build-app handing us a partial bundle.
# build-app already asserts the binaries exist after its own cp; this
# is the package-zip-level check that nothing destructive happens
# between build-app returning and zip creation.
for product in LabanApp laband; do
  dest="${app_bundle}/Contents/MacOS/${product}"
  if [ ! -s "$dest" ] || [ ! -x "$dest" ]; then
    printf 'package-zip failed: %s missing, empty, or non-executable\n' \
      "$dest" >&2
    exit 1
  fi
done

plutil -lint "$plist" >/dev/null
if ! codesign --verify --verbose=4 "$app_bundle" >/dev/null 2>&1; then
  printf 'package-zip failed: invalid code signature in %s\n' "$app_bundle" >&2
  exit 1
fi
stamped_version=$(plutil -extract CFBundleShortVersionString raw -o - "$plist")
if [ "$stamped_version" != "$app_version" ]; then
  printf 'package-zip failed: expected version %s, got %s\n' "$app_version" "$stamped_version" >&2
  exit 1
fi

# Final hygiene gate on the whole bundle (build-app already gates the
# binary). Catches identifying strings that might land in xattrs, the
# Info.plist, or the SwiftPM resource bundles that get copied in.
# Two deliberate, public forms are exempt: the `NSHumanReadableCopyright`
# notice (`© <year> Ragnar Rova`) and the code-signature-embedded release
# identity (`Developer ID Application: Ragnar Rova (3563RJWBQP)`), which is
# present in every properly signed binary. The developer name anywhere else
# — or a host path / personal team id — is still treated as a leak.
forbidden=$(LC_ALL=C find "$app_bundle" -type f -print0 |
  xargs -0 grep -aHInE '/Users/|Ragnar Rova|U34QC433V8|/private/var/folders/' |
  grep -vE '©[[:space:]]+[0-9]{4}[[:space:]]+Ragnar Rova|Developer ID Application: Ragnar Rova \(3563RJWBQP\)' || true)
if [ -n "$forbidden" ]; then
  printf 'package-zip failed: identifying strings present in:\n%s\n' "$forbidden" >&2
  exit 1
fi

make_zip() {
  rm -f "$tmp_zip" "$zip_path"
  ditto -c -k --sequesterRsrc --keepParent "$app_bundle" "$tmp_zip"
  mv "$tmp_zip" "$zip_path"
}

make_zip

# Notarize and staple so Gatekeeper accepts the download on other Macs.
# Sparkle's EdDSA signature proves the update to Sparkle; notarization is
# what lets macOS launch it at all. The zip is submitted as-is, the ticket
# is stapled into the app bundle, and the zip is rebuilt from the stapled
# bundle so the ticket travels with the download.
if [ -n "${LABAN_NOTARY_PROFILE:-}" ]; then
  if [ "$LABAN_CODESIGN_IDENTITY" = "-" ]; then
    printf 'package-zip failed: notarization requires Developer ID signing, not ad-hoc\n' >&2
    exit 1
  fi
  printf 'package-zip: submitting for notarization (profile %s)\n' "$LABAN_NOTARY_PROFILE"
  xcrun notarytool submit "$zip_path" \
    --keychain-profile "$LABAN_NOTARY_PROFILE" --wait
  xcrun stapler staple "$app_bundle"
  xcrun stapler validate "$app_bundle"
  make_zip
  printf 'package-zip: notarized and stapled\n'
else
  printf 'package-zip: WARNING: LABAN_NOTARY_PROFILE unset; zip is NOT notarized.\n' >&2
  printf 'package-zip: Gatekeeper will block it on other Macs. One-time setup:\n' >&2
  printf 'package-zip:   xcrun notarytool store-credentials <profile-name>\n' >&2
fi

printf 'package-zip: %s\n' "$zip_path"
