#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

usage() {
  cat >&2 <<'EOF'
usage: scripts/package-zip <version>

Environment:
  LABAN_BUILD_NUMBER          Build number stamped into Info.plist. Defaults to 1.
  LABAN_UPDATE_MANIFEST_URL   Public update JSON URL stamped into Info.plist.
                              Defaults to the public Laban manifest on Google Drive.
  LABAN_RELEASE_DIR           Zip output directory. Defaults to .artifacts/release.
  LABAN_CODESIGN_IDENTITY     Optional signing identity. Defaults to ad-hoc signing.
  LABAN_SKIP_CODESIGN         Defaults to 0. Skipped bundles may not launch.
  LABAN_BUILD_CONFIG          Swift build config (debug|release). Defaults to release
                              for distribution; release builds emit no in-binary DWARF.
EOF
  exit 2
}

[ "$#" -eq 1 ] || usage

app_version=$1
[ -n "$app_version" ] || usage

export LABAN_APP_VERSION=$app_version
export LABAN_BUILD_NUMBER=${LABAN_BUILD_NUMBER:-1}
default_update_manifest_url="https://drive.google.com/uc?export=download&id=1021htaI6ngLEoF1ItVLvFJHzP-TczOeG"
export LABAN_UPDATE_MANIFEST_URL=${LABAN_UPDATE_MANIFEST_URL:-$default_update_manifest_url}
# Distribution builds optimize and skip emitting in-binary DWARF; combined
# with the prefix-map flags in build-app, this is what lets a public zip
# stay free of build-host paths.
export LABAN_BUILD_CONFIG=${LABAN_BUILD_CONFIG:-release}

release_dir=${LABAN_RELEASE_DIR:-.artifacts/release}
app_bundle=".build/laban/Laban.app"
plist="${app_bundle}/Contents/Info.plist"
zip_path="${release_dir}/Laban-${app_version}.zip"
tmp_zip="${zip_path}.tmp"

mkdir -p "$release_dir"

# Wipe the SwiftPM build cache before a release build by default.
# Releases are rare, the cache-staleness failure mode is hard to
# distinguish from a successful build at the script level, and we have
# at least one shipping example where a stale cache silently produced
# a binary whose optimizer dead-stripped a UI parameter because it
# inherited a pre-refactor module signature. The full clean costs
# ~30-60s and is the only reliable way to keep that class of bug out
# of a release. Set LABAN_SKIP_CLEAN_BUILD=1 to opt out.
if [ "${LABAN_SKIP_CLEAN_BUILD:-0}" != "1" ]; then
  printf 'package-zip: wiping .build for a clean release build\n'
  rm -rf .build
fi

rm -rf "$app_bundle"
LABAN_SKIP_CODESIGN=${LABAN_SKIP_CODESIGN:-0} ./scripts/build-app

[ -d "$app_bundle" ] || {
  printf 'package-zip failed: missing %s\n' "$app_bundle" >&2
  exit 1
}

# Defense in depth against build-app handing us a partial bundle.
# build-app already asserts the binaries exist after its own cp; this
# is the package-zip-level check that nothing destructive happens
# between build-app returning and zip creation.
for product in LabanApp laband; do
  dest="${app_bundle}/Contents/MacOS/${product}"
  if [ ! -s "$dest" ] || [ ! -x "$dest" ]; then
    printf 'package-zip failed: %s missing, empty, or non-executable\n' \
      "$dest" >&2
    exit 1
  fi
done

plutil -lint "$plist" >/dev/null
if ! codesign --verify --verbose=4 "$app_bundle" >/dev/null 2>&1; then
  printf 'package-zip failed: invalid code signature in %s\n' "$app_bundle" >&2
  exit 1
fi
stamped_version=$(plutil -extract CFBundleShortVersionString raw -o - "$plist")
if [ "$stamped_version" != "$app_version" ]; then
  printf 'package-zip failed: expected version %s, got %s\n' "$app_version" "$stamped_version" >&2
  exit 1
fi

# Final hygiene gate on the whole bundle (build-app already gates the
# binary). Catches identifying strings that might land in xattrs, the
# Info.plist, or the SwiftPM resource bundles that get copied in.
forbidden=$(LC_ALL=C find "$app_bundle" -type f -print0 |
  xargs -0 grep -aIlE '/Users/|Ragnar Rova|U34QC433V8|/private/var/folders/' || true)
if [ -n "$forbidden" ]; then
  printf 'package-zip failed: identifying strings present in:\n%s\n' "$forbidden" >&2
  exit 1
fi

rm -f "$tmp_zip" "$zip_path"
ditto -c -k --sequesterRsrc --keepParent "$app_bundle" "$tmp_zip"
mv "$tmp_zip" "$zip_path"

printf 'package-zip: %s\n' "$zip_path"
