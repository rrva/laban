#!/usr/bin/env sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

./scripts/fetch-libghostty-vt

find Sources/LabanTerminalCore -name '*.c' | while IFS= read -r f; do
  abs_file="$repo_root/$f"
  jq -n \
    --arg dir "$repo_root" \
    --arg cmd "clang -std=c11 -I$repo_root/Sources/LabanTerminalCore/include -I$repo_root/.external/libghostty-vt/zig-out/include -Wall -Wextra -Wpedantic -Wstrict-prototypes -Werror=implicit-function-declaration -c $abs_file" \
    --arg file "$abs_file" \
    '{"directory":$dir,"command":$cmd,"file":$file}'
done | jq -s '.' > compile_commands.json

swift build --enable-index-store
