#!/usr/bin/env python3
import re
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DOC = ROOT / "docs/process/dev-process.md"
ROUTES = ROOT / "Sources/LabanDebug/DebugHTTPServer.swift"

DOC_ENDPOINT = re.compile(r"`(GET|POST) (/debug[^`\s]+)`")
ROUTE_ENDPOINT = re.compile(
    r'DebugHTTPRoute\(\s*method:\s*"(?P<method>GET|POST)",\s*'
    r'path:\s*"(?P<path>[^"]+)"',
    re.S,
)
ROUTE_SCHEMA = re.compile(r'(?:requestSchema|responseSchema):\s*"([^"]+)"')


def normalize_path(path: str) -> str:
    return path.split("?", 1)[0]


def doc_endpoints() -> set[tuple[str, str]]:
    text = DOC.read_text(encoding="utf-8")
    return {
        (match.group(1), normalize_path(match.group(2)))
        for match in DOC_ENDPOINT.finditer(text)
    }


def route_endpoints() -> set[tuple[str, str]]:
    text = ROUTES.read_text(encoding="utf-8")
    return {
        (match.group("method"), match.group("path"))
        for match in ROUTE_ENDPOINT.finditer(text)
    }


def route_schemas() -> set[str]:
    text = ROUTES.read_text(encoding="utf-8")
    return set(ROUTE_SCHEMA.findall(text))


def main() -> int:
    errors: list[str] = []

    docs = doc_endpoints()
    routes = route_endpoints()

    for endpoint in sorted(docs - routes):
        errors.append(f"documented endpoint missing from route table: {endpoint[0]} {endpoint[1]}")

    for schema in sorted(route_schemas()):
        if not (ROOT / schema).is_file():
            errors.append(f"route table references missing schema: {schema}")

    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    print("check-debug-contract passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
