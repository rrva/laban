#!/usr/bin/env bash
set -euo pipefail

FIXTURE="${1:-fixtures/colored-boxes.fixture.json}"
RUN_ID="${LABAN_RUN_ID:-manual-debug-$(date +%Y%m%d-%H%M%S)-$$}"
ARTIFACTS="${LABAN_ARTIFACTS:-.artifacts/runs/$RUN_ID}"
TMP="${LABAN_TMP:-.tmp/$RUN_ID}"
ADDRESS="${LABAN_DEBUG_ADDRESS:-127.0.0.1:0}"

swift run laban-agent -- \
  --headless \
  --fixture="$FIXTURE" \
  --debug-server="$ADDRESS" \
  --artifacts="$ARTIFACTS" \
  --temp-dir="$TMP" \
  --deterministic
