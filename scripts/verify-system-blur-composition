#!/usr/bin/env python3
"""Verify real System Blur composition with a full-display ScreenCaptureKit oracle."""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any, NoReturn


REPOSITORY_ROOT = Path(__file__).resolve().parent.parent
FIXTURE = (
    REPOSITORY_ROOT
    / "Tests/LabanAppTests/Fixtures/SystemBlurCompositionOracle.swift"
)
PREFERENCE_TYPES = {
    "LabanTerminalBackgroundOpacity": "float",
    "LabanTerminalApplyOpacityToExplicitCellBackgrounds": "bool",
    "LabanTerminalBackdropStyle": "string",
    "LabanTerminalBackgroundImageScaling": "string",
    "LabanTerminalBackgroundImageIdentifier": "string",
    "LabanTerminalBackgroundImageDisplayName": "string",
}


class OracleError(RuntimeError):
    pass


def fail(message: str) -> NoReturn:
    raise OracleError(message)


def run(arguments: list[str], description: str) -> subprocess.CompletedProcess[str]:
    completed = subprocess.run(arguments, check=False, text=True, capture_output=True)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip()
        fail(f"{description} failed: {detail}")
    return completed


def compile_fixture(destination: Path) -> None:
    run(
        [
            "xcrun",
            "swiftc",
            str(FIXTURE),
            "-framework",
            "AppKit",
            "-framework",
            "ScreenCaptureKit",
            "-o",
            str(destination),
        ],
        "fixture build",
    )


def bundle_identifier(app: Path) -> str:
    info = app / "Contents/Info.plist"
    try:
        value = plistlib.loads(info.read_bytes()).get("CFBundleIdentifier")
    except (OSError, plistlib.InvalidFileException) as error:
        fail(f"could not read installed app metadata: {error}")
    if not isinstance(value, str) or not value:
        fail("installed app has no bundle identifier")
    return value


def read_preferences(domain: str) -> dict[str, Any]:
    completed = subprocess.run(
        ["/usr/bin/defaults", "export", domain, "-"],
        check=False,
        capture_output=True,
    )
    if completed.returncode != 0:
        detail = completed.stderr.decode("utf-8", errors="replace")
        if "does not exist" in detail:
            return {}
        fail(f"could not snapshot transparency preferences: {detail.strip()}")
    try:
        value = plistlib.loads(completed.stdout)
    except plistlib.InvalidFileException as error:
        fail(f"transparency preference snapshot is invalid: {error}")
    if not isinstance(value, dict):
        fail("transparency preference snapshot is not a dictionary")
    return {key: value[key] for key in PREFERENCE_TYPES if key in value}


def restore_preferences(domain: str, snapshot: dict[str, Any]) -> None:
    for key, kind in PREFERENCE_TYPES.items():
        if key not in snapshot:
            subprocess.run(
                ["/usr/bin/defaults", "delete", domain, key],
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            continue
        value = snapshot[key]
        if kind == "float":
            arguments = ["-float", repr(float(value))]
        elif kind == "bool":
            arguments = ["-bool", "true" if bool(value) else "false"]
        else:
            arguments = ["-string", str(value)]
        run(
            ["/usr/bin/defaults", "write", domain, key, *arguments],
            f"restoring {key}",
        )
    if read_preferences(domain) != snapshot:
        fail("transparency preferences did not restore exactly")


def terminate(process: subprocess.Popen[str] | None) -> None:
    if process is None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        process.wait(timeout=5)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait(timeout=5)


def wait_for_backdrop(process: subprocess.Popen[str], log: Path) -> dict[str, Any]:
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if process.poll() is not None:
            fail("stripe backdrop exited before readiness")
        if log.is_file():
            lines = log.read_text(encoding="utf-8", errors="replace").splitlines()
            if lines:
                try:
                    value = json.loads(lines[0])
                except json.JSONDecodeError:
                    value = None
                if isinstance(value, dict) and value.get("ready") is True:
                    return value
        time.sleep(0.05)
    fail("timed out waiting for stripe backdrop")


def wait_for_control(
    process: subprocess.Popen[str], control_dir: Path, run_id: str
) -> dict[str, Any]:
    advertisement = control_dir / "control.json"
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if process.poll() is not None:
            fail("installed app exited before fixture control became ready")
        try:
            value = json.loads(advertisement.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            value = None
        if (
            isinstance(value, dict)
            and value.get("runId") == run_id
            and value.get("pid") == process.pid
            and isinstance(value.get("diagnosticControlToken"), str)
            and Path(str(value.get("url", ""))).is_socket()
        ):
            return value
        time.sleep(0.05)
    fail("timed out waiting for installed-app fixture control")


class Client:
    def __init__(self, advertisement: dict[str, Any]) -> None:
        self.socket = str(advertisement["url"])
        self.token = str(advertisement["diagnosticControlToken"])

    def request(
        self, method: str, path: str, payload: dict[str, Any] | None = None
    ) -> dict[str, Any]:
        arguments = [
            "curl",
            "--silent",
            "--show-error",
            "--max-time",
            "5",
            "--unix-socket",
            self.socket,
            "--header",
            f"Authorization: Bearer {self.token}",
            "--request",
            method,
            "http://laban" + path,
        ]
        if payload is not None:
            arguments += [
                "--header",
                "Content-Type: application/json",
                "--data-binary",
                json.dumps(payload, separators=(",", ":")),
            ]
        completed = run(arguments, f"fixture request {method} {path}")
        try:
            value = json.loads(completed.stdout)
        except json.JSONDecodeError as error:
            fail(f"fixture request returned invalid JSON: {error}")
        if not isinstance(value, dict):
            fail("fixture request did not return an object")
        return value

    def action(self, name: str, **fields: Any) -> None:
        self.request("POST", "/debug/actions", {"action": name, **fields})

    def transparency(self) -> dict[str, Any]:
        return self.request("GET", "/debug/transparency")


def wait_for_state(client: Client, source: str) -> dict[str, Any]:
    expected = {
        "requestedOpacity": 0.3,
        "effectiveOpacity": 0.3,
        "requestedBackdropStyle": source,
        "effectiveBackdropStyle": source,
        "applyToExplicitCellBackgrounds": False,
        "forceOpaqueReason": None,
        "surfaceOpaque": False,
        "backdropSubviewKind": source,
        "backdropSubviewCount": 1 if source == "systemBlur" else 0,
    }
    if source == "none":
        expected["backdropSubviewKind"] = "none"
    deadline = time.monotonic() + 15
    state: dict[str, Any] = {}
    while time.monotonic() < deadline:
        state = client.transparency()
        if all(state.get(key) == value for key, value in expected.items()):
            return state
        time.sleep(0.05)
    mismatches = [key for key, value in expected.items() if state.get(key) != value]
    fail(f"{source} state did not settle exactly: " + ", ".join(mismatches))


def capture(executable: Path, destination: Path) -> None:
    run([str(executable), "capture", str(destination)], "full-display capture")
    if not destination.is_file() or destination.stat().st_size == 0:
        fail("full-display capture did not create a PNG")


def verify(app: Path, artifacts: Path) -> None:
    executable = app / "Contents/MacOS/LabanApp"
    if not executable.is_file() or not os.access(executable, os.X_OK):
        fail(f"installed app executable not found: {executable}")
    existing = subprocess.run(
        ["pgrep", "-x", "LabanApp"], check=False, text=True, capture_output=True
    ).stdout.split()
    if existing:
        fail("close the existing LabanApp before running the isolated visual oracle")
    if artifacts.exists() and any(artifacts.iterdir()):
        fail(f"artifact directory is not empty: {artifacts}")
    artifacts.mkdir(parents=True, exist_ok=True)

    domain = bundle_identifier(app)
    preference_snapshot = read_preferences(domain)
    backdrop: subprocess.Popen[str] | None = None
    laban: subprocess.Popen[str] | None = None
    with tempfile.TemporaryDirectory(
        prefix="system-blur-composition-", dir=REPOSITORY_ROOT / ".tmp"
    ) as raw_work:
        work = Path(raw_work)
        control_dir = work / "control"
        control_dir.mkdir(mode=0o700)
        helper = work / "system-blur-composition-oracle"
        compile_fixture(helper)
        backdrop_log = artifacts / "backdrop.stdout.log"
        backdrop_error = (artifacts / "backdrop.stderr.log").open("w", encoding="utf-8")
        app_log = (artifacts / "app.log").open("w", encoding="utf-8")
        try:
            backdrop_output = backdrop_log.open("w", encoding="utf-8")
            try:
                backdrop = subprocess.Popen(
                    [str(helper), "backdrop"],
                    stdout=backdrop_output,
                    stderr=backdrop_error,
                    text=True,
                    start_new_session=True,
                )
            finally:
                backdrop_output.close()
                backdrop_error.close()
            geometry = wait_for_backdrop(backdrop, backdrop_log)

            run_id = f"system-blur-composition-{os.getpid()}"
            environment = os.environ.copy()
            environment.update(
                {
                    "LABAN_CONTROL_DIR": str(control_dir),
                    "LABAN_GUI_FIXTURE_CONTROL": "1",
                    "LABAN_RUN_ID": run_id,
                }
            )
            try:
                laban = subprocess.Popen(
                    [
                        str(executable),
                        "--no-persistence",
                        "--terminal-backend=in-process",
                    ],
                    env=environment,
                    stdout=app_log,
                    stderr=subprocess.STDOUT,
                    text=True,
                    start_new_session=True,
                )
            finally:
                app_log.close()
            client = Client(wait_for_control(laban, control_dir, run_id))

            client.action(
                "setBackgroundTransparency",
                opacity=0.3,
                applyToExplicitCellBackgrounds=False,
            )
            client.action("setBackgroundSource", source="none")
            direct_state = wait_for_state(client, "none")
            (artifacts / "direct-state.json").write_text(
                json.dumps(direct_state, indent=2, sort_keys=True) + "\n",
                encoding="utf-8",
            )
            time.sleep(0.5)
            direct_capture = artifacts / "direct-full-display.png"
            capture(helper, direct_capture)

            client.action("setBackgroundSource", source="systemBlur")
            blur_state = wait_for_state(client, "systemBlur")
            (artifacts / "system-blur-state.json").write_text(
                json.dumps(blur_state, indent=2, sort_keys=True) + "\n",
                encoding="utf-8",
            )
            time.sleep(0.5)
            blur_capture = artifacts / "system-blur-full-display.png"
            capture(helper, blur_capture)

            analyzed = subprocess.run(
                [
                    str(helper),
                    "analyze",
                    str(direct_capture),
                    str(blur_capture),
                    str(laban.pid),
                    str(geometry["screenWidth"]),
                    str(geometry["screenHeight"]),
                    str(geometry["stripeWidth"]),
                ],
                check=False,
                text=True,
                capture_output=True,
            )
            (artifacts / "summary.json").write_text(analyzed.stdout, encoding="utf-8")
            if analyzed.returncode != 0:
                fail(analyzed.stderr.strip() or "full-display composition gates failed")
        finally:
            terminate(laban)
            terminate(backdrop)
            restore_preferences(domain, preference_snapshot)

    print(f"verify-system-blur-composition: summary={artifacts / 'summary.json'}")


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--app", type=Path)
    parser.add_argument(
        "--artifacts",
        type=Path,
        default=REPOSITORY_ROOT / ".artifacts/transparency/system-blur-composition",
    )
    parser.add_argument("--self-test", action="store_true")
    arguments = parser.parse_args()
    if not arguments.self_test and arguments.app is None:
        parser.error("--app is required unless --self-test is used")
    return arguments


def main() -> int:
    arguments = parse_arguments()
    try:
        (REPOSITORY_ROOT / ".tmp").mkdir(exist_ok=True)
        with tempfile.TemporaryDirectory(
            prefix="system-blur-oracle-self-test-", dir=REPOSITORY_ROOT / ".tmp"
        ) as raw_work:
            helper = Path(raw_work) / "system-blur-composition-oracle"
            compile_fixture(helper)
            run([str(helper), "self-test"], "metric self-test")
        if arguments.self_test:
            print("verify-system-blur-composition: self-test passed")
            return 0
        verify(arguments.app.resolve(), arguments.artifacts.resolve())
        return 0
    except OracleError as error:
        print(f"verify-system-blur-composition: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
