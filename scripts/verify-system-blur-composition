#!/usr/bin/env python3
"""Verify real System Blur composition without persisting a desktop capture."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import plistlib
import runpy
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable, NoReturn


REPOSITORY_ROOT = Path(__file__).resolve().parent.parent
FIXTURE = REPOSITORY_ROOT / "Tests/LabanAppTests/Fixtures/SystemBlurCompositionOracle.swift"
PROCESS_SUPPORT = runpy.run_path(str(REPOSITORY_ROOT / "scripts/profile-transparency-compositor"))
ProfileTerminationSignalGuard = PROCESS_SUPPORT["ProfileTerminationSignalGuard"]
OwnedProcesses = PROCESS_SUPPORT["OwnedProcesses"]
ProfileError = PROCESS_SUPPORT["ProfileError"]


class OracleError(RuntimeError):
    pass


@dataclass(frozen=True)
class PreferenceSnapshot:
    existed: bool
    exported: bytes
    canonical: bytes


@dataclass(frozen=True)
class ThemeScenario:
    key: str
    name: str
    is_dark: bool
    effective_appearance: str


THEME_SCENARIOS = (
    ThemeScenario("selenized-light-aqua", "Selenized Light", False, "aqua"),
    ThemeScenario("selenized-dark-dark-aqua", "Selenized Dark", True, "darkAqua"),
)

# Darwin's sockaddr_un.sun_path is 104 bytes including the trailing NUL.
# Keep this oracle's fixture path check aligned with LabanControl's bind guard
# so a configuration failure is reported before AppKit can present a modal
# startup alert.
DARWIN_UNIX_SOCKET_PATH_CAPACITY = 104
CONTROL_SOCKET_BASENAME = "control.sock"


def fail(message: str) -> NoReturn:
    raise OracleError(message)


def run(arguments: list[str], description: str) -> subprocess.CompletedProcess[str]:
    completed = subprocess.run(arguments, check=False, text=True, capture_output=True)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip()
        fail(f"{description} failed: {detail}")
    return completed


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def compile_fixture(destination: Path) -> None:
    run(
        [
            "xcrun",
            "swiftc",
            str(FIXTURE),
            "-framework",
            "AppKit",
            "-framework",
            "ScreenCaptureKit",
            "-o",
            str(destination),
        ],
        "fixture build",
    )


def app_info(app: Path) -> dict[str, Any]:
    try:
        value = plistlib.loads((app / "Contents/Info.plist").read_bytes())
    except (OSError, plistlib.InvalidFileException) as error:
        fail(f"could not read installed app metadata: {error}")
    if not isinstance(value, dict):
        fail("installed app metadata is not a dictionary")
    return value


def canonical_plist(value: dict[str, Any]) -> bytes:
    return plistlib.dumps(value, fmt=plistlib.FMT_BINARY, sort_keys=True)


def read_preferences(domain: str) -> PreferenceSnapshot:
    exists = subprocess.run(
        ["/usr/bin/defaults", "read", domain],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode == 0
    if not exists:
        return PreferenceSnapshot(False, b"", b"")
    completed = subprocess.run(
        ["/usr/bin/defaults", "export", domain, "-"],
        check=False,
        capture_output=True,
    )
    if completed.returncode != 0:
        detail = completed.stderr.decode("utf-8", errors="replace")
        fail(f"could not snapshot installed-app preferences: {detail.strip()}")
    try:
        value = plistlib.loads(completed.stdout)
    except plistlib.InvalidFileException as error:
        fail(f"installed-app preference snapshot is invalid: {error}")
    if not isinstance(value, dict):
        fail("installed-app preference snapshot is not a dictionary")
    return PreferenceSnapshot(True, completed.stdout, canonical_plist(value))


def import_preference_domain(domain: str, payload: bytes) -> None:
    subprocess.run(
        ["/usr/bin/defaults", "delete", domain],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    completed = subprocess.run(
        ["/usr/bin/defaults", "import", domain, "-"],
        input=payload,
        check=False,
        capture_output=True,
    )
    if completed.returncode != 0:
        detail = completed.stderr.decode("utf-8", errors="replace").strip()
        fail(f"could not import installed-app preferences: {detail}")


def restore_preferences(domain: str, snapshot: PreferenceSnapshot) -> None:
    if snapshot.existed:
        import_preference_domain(domain, snapshot.exported)
    else:
        subprocess.run(
            ["/usr/bin/defaults", "delete", domain],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    restored = read_preferences(domain)
    if restored != snapshot:
        fail("installed-app preference domain did not restore byte-for-byte with exact types")


def pinned_scenario_preferences(
    snapshot: PreferenceSnapshot, scenario: ThemeScenario
) -> bytes:
    if snapshot.existed:
        try:
            values = plistlib.loads(snapshot.exported)
        except plistlib.InvalidFileException as error:
            fail(f"installed-app preference snapshot is invalid: {error}")
        if not isinstance(values, dict):
            fail("installed-app preference snapshot is not a dictionary")
    else:
        values = {}
    # Pin the exact renderer, theme, and app appearance that this visual
    # regression covers. ThemeMenuController maps a manually selected light or
    # dark theme to Aqua or Dark Aqua before the terminal window is created.
    values.update(
        {
            "LabanRendererMode": "slugGlyph",
            "LabanThemeDark": "Selenized Dark",
            "LabanThemeLight": "Selenized Light",
            "LabanThemeCurrent": scenario.name,
            "LabanThemeFollowsSystem": False,
        }
    )
    return plistlib.dumps(values, fmt=plistlib.FMT_XML, sort_keys=True)


def cleanup_all(steps: list[tuple[str, Callable[[], None]]]) -> list[str]:
    errors: list[str] = []
    for label, action in steps:
        try:
            action()
        except BaseException as error:
            errors.append(f"{label}: {error}")
    return errors


def reset_reduce_transparency_override(client: Client | None) -> None:
    if client is None:
        return
    client.action("setReduceTransparencyOverride", enabled=None)
    state = client.transparency()
    validate_reduce_transparency_override_reset(state)


def validate_reduce_transparency_override_reset(state: dict[str, Any]) -> None:
    if "reduceTransparencyOverride" not in state or state["reduceTransparencyOverride"] is not None:
        fail("Reduce Transparency override did not restore to null")
    if state.get("effectiveReduceTransparency") != state.get("systemReduceTransparency"):
        fail("Reduce Transparency override did not restore to the live system value")


def decode_http_json(raw: str, label: str) -> dict[str, Any]:
    try:
        body, raw_status = raw.rsplit("\n", 1)
        status = int(raw_status)
    except (ValueError, TypeError):
        fail(f"{label} did not return an HTTP status")
    if not 200 <= status < 300:
        detail = body.strip()
        fail(f"{label} returned HTTP {status}: {detail}")
    try:
        value = json.loads(body)
    except json.JSONDecodeError as error:
        fail(f"{label} returned invalid JSON: {error}")
    if not isinstance(value, dict):
        fail(f"{label} did not return an object")
    return value


def validate_action_response(name: str, value: dict[str, Any]) -> None:
    if value.get("ok") is not True:
        fail(f"fixture action {name} did not return ok=true")


def wait_for_backdrop(process: subprocess.Popen[str], log: Path) -> dict[str, Any]:
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if process.poll() is not None:
            fail("stripe backdrop exited before readiness")
        if log.is_file():
            lines = log.read_text(encoding="utf-8", errors="replace").splitlines()
            if lines:
                try:
                    value = json.loads(lines[0])
                except json.JSONDecodeError:
                    value = None
                if isinstance(value, dict) and value.get("ready") is True:
                    return value
        time.sleep(0.05)
    fail("timed out waiting for stripe backdrop")


def wait_for_control(
    process: subprocess.Popen[str], control_dir: Path, run_id: str
) -> dict[str, Any]:
    advertisement = control_dir / "control.json"
    expected_socket = expected_control_socket_path(control_dir)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if process.poll() is not None:
            fail("installed app exited before fixture control became ready")
        try:
            value = json.loads(advertisement.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            value = None
        if validated_control_advertisement(
            value,
            expected_pid=process.pid,
            expected_run_id=run_id,
            expected_socket=expected_socket,
        ):
            return value
        time.sleep(0.05)
    fail("timed out waiting for installed-app fixture control")


def expected_control_socket_path(control_dir: Path) -> Path:
    path = control_dir / CONTROL_SOCKET_BASENAME
    byte_count = len(os.fsencode(path)) + 1
    if byte_count > DARWIN_UNIX_SOCKET_PATH_CAPACITY:
        fail(
            "fixture control socket path exceeds Darwin sockaddr_un capacity: "
            f"{byte_count} > {DARWIN_UNIX_SOCKET_PATH_CAPACITY} bytes"
        )
    return path


def validated_control_advertisement(
    value: Any,
    *,
    expected_pid: int,
    expected_run_id: str,
    expected_socket: Path,
) -> bool:
    if not isinstance(value, dict):
        return False
    if value.get("runId") != expected_run_id or value.get("pid") != expected_pid:
        return False
    if not isinstance(value.get("diagnosticControlToken"), str):
        return False
    if Path(str(value.get("url", ""))) != expected_socket:
        return False
    try:
        return stat.S_ISSOCK(expected_socket.stat().st_mode)
    except OSError:
        return False


class Client:
    def __init__(self, advertisement: dict[str, Any]) -> None:
        self.socket = str(advertisement["url"])
        self.token = str(advertisement["diagnosticControlToken"])

    def request(
        self, method: str, path: str, payload: dict[str, Any] | None = None
    ) -> dict[str, Any]:
        arguments = [
            "curl",
            "--silent",
            "--show-error",
            "--max-time",
            "5",
            "--unix-socket",
            self.socket,
            "--header",
            f"Authorization: Bearer {self.token}",
            "--request",
            method,
            "--write-out",
            "\n%{http_code}",
            "http://laban" + path,
        ]
        if payload is not None:
            arguments += [
                "--header",
                "Content-Type: application/json",
                "--data-binary",
                json.dumps(payload, separators=(",", ":")),
            ]
        label = f"fixture request {method} {path}"
        completed = subprocess.run(arguments, check=False, text=True, capture_output=True)
        if completed.returncode != 0:
            detail = completed.stderr.strip() or completed.stdout.strip()
            fail(f"{label} failed: {detail}")
        return decode_http_json(completed.stdout, label)

    def action(self, name: str, **fields: Any) -> None:
        value = self.request("POST", "/debug/actions", {"action": name, **fields})
        validate_action_response(name, value)

    def transparency(self) -> dict[str, Any]:
        return self.request("GET", "/debug/transparency")


def wait_for_state(
    client: Client, source: str, scenario: ThemeScenario
) -> dict[str, Any]:
    expected = {
        "requestedOpacity": 0.3,
        "effectiveOpacity": 0.3,
        "requestedBackdropStyle": source,
        "effectiveBackdropStyle": source,
        "applyToExplicitCellBackgrounds": False,
        "forceOpaqueReason": None,
        "surfaceOpaque": False,
        "backdropSubviewKind": source,
        "backdropSubviewCount": 1 if source == "systemBlur" else 0,
        "effectiveReduceTransparency": False,
        "reduceTransparencyOverride": False,
        "configuredRenderer": "slugGlyph",
        "effectiveRenderer": "slugGlyph",
        "themeName": scenario.name,
        "themeIsDark": scenario.is_dark,
        "effectiveAppearance": scenario.effective_appearance,
    }
    deadline = time.monotonic() + 15
    state: dict[str, Any] = {}
    while time.monotonic() < deadline:
        state = client.transparency()
        if all(state.get(key) == value for key, value in expected.items()):
            return state
        time.sleep(0.05)
    mismatches = [key for key, value in expected.items() if state.get(key) != value]
    fail(f"{source} state did not settle exactly: " + ", ".join(mismatches))


def capture(
    executable: Path,
    destination: Path,
    pid: int,
    backdrop_pid: int,
) -> dict[str, Any]:
    if destination.exists():
        fail("full-display crop destination was not fresh")
    try:
        completed = run(
            [
                str(executable),
                "capture",
                str(destination),
                str(pid),
                str(backdrop_pid),
            ],
            "full-display in-memory crop",
        )
    except BaseException:
        destination.unlink(missing_ok=True)
        raise
    if not destination.is_file() or destination.stat().st_size == 0:
        destination.unlink(missing_ok=True)
        fail("in-memory terminal crop did not create a PNG")
    try:
        value = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        destination.unlink(missing_ok=True)
        fail(f"capture metadata is invalid: {error}")
    if (
        not isinstance(value, dict)
        or value.get("schemaVersion") != 2
        or value.get("captureKind") != "fullDisplayCroppedInMemory"
        or value.get("labanPID") != pid
        or value.get("backdropPID") != backdrop_pid
        or value.get("labanActivationRequested") is not True
        or value.get("windowStackValidatedBeforeCapture") is not True
        or value.get("windowStackValidatedBeforePNGEncoding") is not True
        or type(value.get("labanWindowID")) is not int
        or value["labanWindowID"] <= 0
        or type(value.get("backdropWindowID")) is not int
        or value["backdropWindowID"] <= 0
    ):
        destination.unlink(missing_ok=True)
        fail("capture did not attest full-display in-memory cropping")
    return value


def git_output(arguments: list[str], description: str) -> str:
    return run(["git", *arguments], description).stdout.strip()


def tracked_oracle_identity(
    repository_head: str,
    relative_path: str,
    *,
    worktree_bytes: bytes | None = None,
) -> dict[str, str]:
    completed = subprocess.run(
        ["git", "show", f"{repository_head}:{relative_path}"],
        check=False,
        capture_output=True,
    )
    if completed.returncode != 0:
        detail = completed.stderr.decode("utf-8", errors="replace").strip()
        fail(f"tracked oracle source is absent at repository HEAD: {relative_path}: {detail}")
    expected = completed.stdout
    actual = (
        (REPOSITORY_ROOT / relative_path).read_bytes()
        if worktree_bytes is None
        else worktree_bytes
    )
    if actual != expected:
        fail(f"oracle source differs from repository HEAD: {relative_path}")
    return {
        "path": relative_path,
        "sha256": hashlib.sha256(expected).hexdigest(),
        "gitBlob": git_output(
            ["rev-parse", f"{repository_head}:{relative_path}"],
            f"tracked oracle blob for {relative_path}",
        ),
    }


def provenance(app: Path, executable: Path, info: dict[str, Any]) -> dict[str, Any]:
    raw_commit = info.get("LABANBuildCommit")
    if not isinstance(raw_commit, str) or not raw_commit:
        fail("installed app is missing LABANBuildCommit")
    installed_commit = git_output(["rev-parse", f"{raw_commit}^{{commit}}"], "build commit")
    repository_head = git_output(["rev-parse", "HEAD"], "repository HEAD")
    verifier_identity = tracked_oracle_identity(
        repository_head, "scripts/verify-system-blur-composition")
    fixture_identity = tracked_oracle_identity(
        repository_head, "Tests/LabanAppTests/Fixtures/SystemBlurCompositionOracle.swift")
    process_support_identity = tracked_oracle_identity(
        repository_head, "scripts/profile-transparency-compositor")
    ancestor = subprocess.run(
        ["git", "merge-base", "--is-ancestor", installed_commit, repository_head],
        check=False,
    ).returncode == 0
    if not ancestor:
        fail("installed LABANBuildCommit is not an ancestor of repository HEAD")
    relation = "current"
    if installed_commit != repository_head:
        unchanged = subprocess.run(
            [
                "git",
                "diff",
                "--quiet",
                f"{installed_commit}..{repository_head}",
                "--",
                "Package.swift",
                "Package.resolved",
                "Sources",
            ],
            check=False,
        ).returncode == 0
        if not unchanged:
            fail("installed app is stale relative to current app sources")
        relation = "ancestorWithNoAppSourceChanges"
    if subprocess.run(
        ["git", "diff", "--quiet", "HEAD", "--", "Package.swift", "Package.resolved", "Sources"],
        check=False,
    ).returncode != 0:
        fail("uncommitted app-source changes make installed provenance ambiguous")
    return {
        "appPath": str(app),
        "executableSHA256": sha256(executable),
        "fixtureSHA256": fixture_identity["sha256"],
        "processSupportSHA256": process_support_identity["sha256"],
        "verifierSHA256": verifier_identity["sha256"],
        "labanBuildCommit": raw_commit,
        "labanBuildCommitResolved": installed_commit,
        "repositoryHead": repository_head,
        "installedCommitRelation": relation,
        "oracleSources": {
            "fixture": fixture_identity,
            "processSupport": process_support_identity,
            "verifier": verifier_identity,
        },
        "osVersion": run(["sw_vers", "-productVersion"], "OS version").stdout.strip(),
        "osBuild": run(["sw_vers", "-buildVersion"], "OS build").stdout.strip(),
    }


def sanitized_environment(control_dir: Path, run_id: str) -> dict[str, str]:
    home = control_dir / "home"
    temporary = control_dir / "tmp"
    home.mkdir(mode=0o700)
    temporary.mkdir(mode=0o700)
    return {
        "HOME": str(home),
        "LANG": "C",
        "LC_ALL": "C",
        "LOGNAME": "laban-fixture",
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "SHELL": "/bin/sh",
        "TERM": "xterm-256color",
        "TMPDIR": str(temporary),
        "USER": "laban-fixture",
        "LABAN_CONTROL_DIR": str(control_dir),
        "LABAN_GUI_FIXTURE_CONTROL": "1",
        "LABAN_RUN_ID": run_id,
    }


def write_json(path: Path, value: dict[str, Any]) -> None:
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def measure_theme_scenario(
    *,
    scenario: ThemeScenario,
    executable: Path,
    helper: Path,
    control_root: Path,
    artifacts: Path,
    domain: str,
    preference_snapshot: PreferenceSnapshot,
    termination_guard: Any,
) -> dict[str, Any]:
    import_preference_domain(
        domain, pinned_scenario_preferences(preference_snapshot, scenario)
    )
    scenario_artifacts = artifacts / scenario.key
    scenario_artifacts.mkdir()
    # The artifact name remains descriptive, but fixture IPC lives below a
    # short per-run root. Descriptive scenario names can exceed Darwin's
    # sockaddr_un path capacity after tempfile prefixes are included.
    control_dir = control_root / ("l" if not scenario.is_dark else "d")
    control_dir.mkdir(mode=0o700)
    if any(control_dir.iterdir()):
        fail(f"{scenario.name}: fixture control directory was not fresh")
    expected_control_socket_path(control_dir)
    processes = OwnedProcesses(termination_guard)
    client: Client | None = None
    primary_error: BaseException | None = None
    completed: dict[str, Any] | None = None
    try:
        backdrop_log = scenario_artifacts / "backdrop.stdout.log"
        backdrop_output = backdrop_log.open("w", encoding="utf-8")
        backdrop_error = (scenario_artifacts / "backdrop.stderr.log").open(
            "w", encoding="utf-8"
        )
        try:
            backdrop = processes.start(
                [str(helper), "backdrop"],
                stdout=backdrop_output,
                stderr=backdrop_error,
                text=True,
            )
        finally:
            backdrop_output.close()
            backdrop_error.close()
        geometry = wait_for_backdrop(backdrop, backdrop_log)

        run_id = (
            f"system-blur-composition-{scenario.key}-{os.getpid()}-{time.time_ns()}"
        )
        app_log = (scenario_artifacts / "app.log").open("w", encoding="utf-8")
        try:
            laban = processes.start(
                [str(executable), "--no-persistence", "--terminal-backend=in-process"],
                env=sanitized_environment(control_dir, run_id),
                cwd=control_dir / "home",
                stdout=app_log,
                stderr=subprocess.STDOUT,
                text=True,
            )
        finally:
            app_log.close()
        client = Client(wait_for_control(laban, control_dir, run_id))
        client.action("setReduceTransparencyOverride", enabled=False)
        client.action(
            "setBackgroundTransparency",
            opacity=0.3,
            applyToExplicitCellBackgrounds=False,
        )
        client.action("setBackgroundSource", source="none")
        direct_state = wait_for_state(client, "none", scenario)
        direct_state_path = scenario_artifacts / "direct-state.json"
        write_json(direct_state_path, direct_state)
        time.sleep(0.5)
        direct_capture = scenario_artifacts / "direct-terminal-crop.png"
        direct_metadata = capture(helper, direct_capture, laban.pid, backdrop.pid)

        client.action("setBackgroundSource", source="systemBlur")
        blur_state = wait_for_state(client, "systemBlur", scenario)
        blur_state_path = scenario_artifacts / "system-blur-state.json"
        write_json(blur_state_path, blur_state)
        time.sleep(0.5)
        blur_capture = scenario_artifacts / "system-blur-terminal-crop.png"
        blur_metadata = capture(helper, blur_capture, laban.pid, backdrop.pid)
        if blur_metadata != direct_metadata:
            fail(
                f"{scenario.name}: direct and System Blur terminal crops "
                "have different metadata"
            )

        analyzed = subprocess.run(
            [
                str(helper),
                "analyze",
                str(direct_capture),
                str(blur_capture),
                str(direct_metadata["sampleOriginXPoints"]),
                str(direct_metadata["captureScale"]),
                str(direct_metadata["terminalSampleHeight"]),
                str(geometry["stripeWidth"]),
            ],
            check=False,
            text=True,
            capture_output=True,
        )
        try:
            summary = json.loads(analyzed.stdout)
        except json.JSONDecodeError as error:
            fail(f"{scenario.name}: composition summary is invalid: {error}")
        if analyzed.returncode != 0:
            failures = summary.get("failures") if isinstance(summary, dict) else None
            fail(
                analyzed.stderr.strip()
                or f"{scenario.name}: full-display composition gates failed: {failures}"
            )
        if not isinstance(summary, dict):
            fail(f"{scenario.name}: composition summary is not an object")
        summary.update(
            {
                "theme": {
                    "name": scenario.name,
                    "isDark": scenario.is_dark,
                    "effectiveAppearance": scenario.effective_appearance,
                },
                "renderer": {"configured": "slugGlyph", "effective": "slugGlyph"},
                "capture": direct_metadata,
                "artifacts": {
                    "directCropSHA256": sha256(direct_capture),
                    "systemBlurCropSHA256": sha256(blur_capture),
                    "directStateSHA256": sha256(direct_state_path),
                    "systemBlurStateSHA256": sha256(blur_state_path),
                },
            }
        )
        completed = summary
    except BaseException as error:
        primary_error = error

    with termination_guard.defer():
        cleanup_errors = cleanup_all(
            [
                (
                    f"{scenario.name} Reduce Transparency override reset",
                    lambda: reset_reduce_transparency_override(client),
                ),
                (f"{scenario.name} owned process cleanup", processes.close),
            ]
        )
    if cleanup_errors:
        prefix = f"{primary_error}; " if primary_error is not None else ""
        fail(prefix + "cleanup failures: " + "; ".join(cleanup_errors))
    if primary_error is not None:
        raise primary_error
    if completed is None:
        fail(f"{scenario.name}: composition completed without a summary")
    return completed


def verify(
    app: Path,
    artifacts: Path,
    termination_guard: Any,
) -> None:
    executable = app / "Contents/MacOS/LabanApp"
    if not executable.is_file() or not os.access(executable, os.X_OK):
        fail(f"installed app executable not found: {executable}")
    if subprocess.run(
        ["pgrep", "-x", "LabanApp"], check=False, capture_output=True
    ).stdout.split():
        fail("close the existing LabanApp before running the isolated visual oracle")
    if artifacts.exists() and any(artifacts.iterdir()):
        fail(f"artifact directory is not empty: {artifacts}")
    artifacts.mkdir(parents=True, exist_ok=True)

    info = app_info(app)
    domain = info.get("CFBundleIdentifier")
    if not isinstance(domain, str) or not domain:
        fail("installed app has no bundle identifier")
    identity = provenance(app, executable, info)
    preference_snapshot = read_preferences(domain)
    primary_error: BaseException | None = None
    completed_summary: dict[str, Any] | None = None

    with tempfile.TemporaryDirectory(
        prefix="system-blur-composition-", dir=REPOSITORY_ROOT / ".tmp"
    ) as raw_work, tempfile.TemporaryDirectory(
        prefix=f"lbo-{os.getpid()}-", dir="/tmp"
    ) as raw_control:
        work = Path(raw_work)
        control_root = Path(raw_control)
        expected_control_socket_path(control_root / "d")
        helper = work / "system-blur-composition-oracle"
        compile_fixture(helper)
        try:
            scenario_results = {
                scenario.key: measure_theme_scenario(
                    scenario=scenario,
                    executable=executable,
                    helper=helper,
                    control_root=control_root,
                    artifacts=artifacts,
                    domain=domain,
                    preference_snapshot=preference_snapshot,
                    termination_guard=termination_guard,
                )
                for scenario in THEME_SCENARIOS
            }
            if set(scenario_results) != {scenario.key for scenario in THEME_SCENARIOS}:
                fail("the required light and dark scenarios were not both measured")
            completed_summary = {
                "schemaVersion": 3,
                "passed": all(result.get("passed") is True for result in scenario_results.values()),
                "requiredScenarios": [
                    {
                        "key": scenario.key,
                        "themeName": scenario.name,
                        "themeIsDark": scenario.is_dark,
                        "effectiveAppearance": scenario.effective_appearance,
                        "configuredRenderer": "slugGlyph",
                        "effectiveRenderer": "slugGlyph",
                    }
                    for scenario in THEME_SCENARIOS
                ],
                "scenarioResults": scenario_results,
                "provenance": identity,
            }
            if completed_summary["passed"] is not True:
                fail("one or more required theme scenarios did not pass")
        except BaseException as error:
            primary_error = error

        with termination_guard.defer():
            cleanup_errors = cleanup_all(
                [
                    ("preference restoration", lambda: restore_preferences(domain, preference_snapshot)),
                ]
            )
        if cleanup_errors:
            prefix = f"{primary_error}; " if primary_error is not None else ""
            fail(prefix + "cleanup failures: " + "; ".join(cleanup_errors))
        if primary_error is not None:
            raise primary_error
        if completed_summary is None:
            fail("composition completed without a summary")
        completed_summary["cleanup"] = {
            "ownedProcessGroupsReaped": True,
            "preferenceDomainRestoredByteForByte": True,
            "reduceTransparencyOverrideRestoredToSystemForEveryScenario": True,
        }
        write_json(artifacts / "summary.json", completed_summary)

    print(f"verify-system-blur-composition: summary={artifacts / 'summary.json'}")


def self_test_preferences() -> None:
    domain = f"com.laban.system-blur-oracle.self-test.{os.getpid()}.{time.time_ns()}"
    malformed: dict[str, Any] = {
        "LabanTerminalBackgroundOpacity": "malformed-opacity",
        "LabanTerminalApplyOpacityToExplicitCellBackgrounds": 7,
        "LabanTerminalBackdropStyle": ["not", "a", "string"],
        "UnrelatedBinary": b"\x00\xfffixture",
        "UnrelatedInteger": 42,
    }
    try:
        missing = read_preferences(domain)
        if missing.existed:
            fail("preference self-test domain unexpectedly existed")
        import_preference_domain(domain, plistlib.dumps(malformed, fmt=plistlib.FMT_XML))
        snapshot = read_preferences(domain)
        pinned = []
        for scenario in THEME_SCENARIOS:
            scenario_values = plistlib.loads(
                pinned_scenario_preferences(snapshot, scenario)
            )
            if (
                scenario_values.get("UnrelatedBinary") != malformed["UnrelatedBinary"]
                or scenario_values.get("UnrelatedInteger") != malformed["UnrelatedInteger"]
                or scenario_values.get("LabanRendererMode") != "slugGlyph"
                or scenario_values.get("LabanThemeCurrent") != scenario.name
                or scenario_values.get("LabanThemeFollowsSystem") is not False
            ):
                fail("pinned scenario preferences changed unrelated values or lost identity")
            pinned.append(scenario_values["LabanThemeCurrent"])
        if pinned != ["Selenized Light", "Selenized Dark"]:
            fail("light and dark scenario preferences are not distinct and ordered")
        import_preference_domain(domain, plistlib.dumps({"replacement": True}))
        restore_preferences(domain, snapshot)
        restored = read_preferences(domain)
        if restored.exported != snapshot.exported or restored.canonical != canonical_plist(malformed):
            fail("malformed preference values did not restore byte-for-byte with exact types")
        restore_preferences(domain, missing)
        if read_preferences(domain).existed:
            fail("missing preference domain was not restored as missing")
    finally:
        subprocess.run(
            ["/usr/bin/defaults", "delete", domain],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def self_test_cleanup_aggregation() -> None:
    called: list[str] = []

    def step(name: str, broken: bool) -> Callable[[], None]:
        def action() -> None:
            called.append(name)
            if broken:
                raise RuntimeError(name)

        return action

    errors = cleanup_all(
        [("first", step("first", True)), ("second", step("second", True)), ("third", step("third", False))]
    )
    if called != ["first", "second", "third"] or len(errors) != 2:
        fail("cleanup aggregation did not run every independent cleanup step")


def self_test_control_path_and_advertisement() -> None:
    short = Path("/tmp/lbo-self/d")
    if expected_control_socket_path(short) != short / CONTROL_SOCKET_BASENAME:
        fail("short fixture control socket path did not pass its path budget")
    expect_oracle_failure(
        lambda: expected_control_socket_path(Path("/tmp") / ("x" * 100)),
        "an over-capacity fixture control socket path",
    )

    with tempfile.TemporaryDirectory(
        prefix="lbo-self-", dir="/tmp"
    ) as raw_control:
        control_dir = Path(raw_control) / "d"
        control_dir.mkdir(mode=0o700)
        expected_socket = expected_control_socket_path(control_dir)
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            listener.bind(str(expected_socket))
            valid: dict[str, Any] = {
                "runId": "fresh-run",
                "pid": 1234,
                "url": str(expected_socket),
                "diagnosticControlToken": "fixture-token",
            }
            if not validated_control_advertisement(
                valid,
                expected_pid=1234,
                expected_run_id="fresh-run",
                expected_socket=expected_socket,
            ):
                fail("fresh fixture control advertisement was rejected")
            stale_variants = (
                {**valid, "runId": "stale-run"},
                {**valid, "pid": 4321},
                {**valid, "url": str(control_dir / "stale.sock")},
                {key: value for key, value in valid.items() if key != "diagnosticControlToken"},
            )
            if any(
                validated_control_advertisement(
                    value,
                    expected_pid=1234,
                    expected_run_id="fresh-run",
                    expected_socket=expected_socket,
                )
                for value in stale_variants
            ):
                fail("stale fixture control advertisement was accepted")
        finally:
            listener.close()


def expect_oracle_failure(action: Callable[[], None], label: str) -> None:
    try:
        action()
    except OracleError:
        return
    fail(f"self-test accepted {label}")


def self_test_http_and_override_validation() -> None:
    valid = decode_http_json('{"ok":true}\n200', "self-test request")
    validate_action_response("selfTest", valid)
    expect_oracle_failure(
        lambda: decode_http_json('{"error":"denied"}\n403', "self-test request"),
        "an HTTP error response",
    )
    expect_oracle_failure(
        lambda: validate_action_response("selfTest", {"ok": False}),
        "an action response with ok=false",
    )
    expect_oracle_failure(
        lambda: validate_action_response("selfTest", {}),
        "an action response without ok=true",
    )
    validate_reduce_transparency_override_reset(
        {
            "systemReduceTransparency": False,
            "effectiveReduceTransparency": False,
            "reduceTransparencyOverride": None,
        }
    )
    expect_oracle_failure(
        lambda: validate_reduce_transparency_override_reset(
            {
                "systemReduceTransparency": False,
                "effectiveReduceTransparency": False,
                "reduceTransparencyOverride": False,
            }
        ),
        "a false Reduce Transparency override after reset",
    )
    expect_oracle_failure(
        lambda: validate_reduce_transparency_override_reset(
            {
                "systemReduceTransparency": False,
                "effectiveReduceTransparency": False,
            }
        ),
        "a missing Reduce Transparency override projection after reset",
    )


def self_test_oracle_source_identity() -> None:
    repository_head = git_output(["rev-parse", "HEAD"], "self-test repository HEAD")
    oracle_sources = (
        "scripts/verify-system-blur-composition",
        "Tests/LabanAppTests/Fixtures/SystemBlurCompositionOracle.swift",
        "scripts/profile-transparency-compositor",
    )
    for relative_path in oracle_sources:
        head_bytes = subprocess.run(
            ["git", "show", f"{repository_head}:{relative_path}"],
            check=True,
            capture_output=True,
        ).stdout
        identity = tracked_oracle_identity(
            repository_head,
            relative_path,
            worktree_bytes=head_bytes,
        )
        if identity["sha256"] != hashlib.sha256(head_bytes).hexdigest():
            fail(f"oracle source identity self-test recorded the wrong SHA-256: {relative_path}")
        expect_oracle_failure(
            lambda path=relative_path, content=head_bytes: tracked_oracle_identity(
                repository_head,
                path,
                worktree_bytes=content + b"mutation",
            ),
            f"an oracle source mutation relative to repository HEAD: {relative_path}",
        )


def run_signal_cleanup_child(directory: Path) -> int:
    directory.mkdir(parents=True, exist_ok=True)
    descendant_ready = directory / "descendant-ready"
    stubborn_script = directory / "stubborn-descendant.py"
    stubborn_script.write_text(
        "import os, pathlib, signal, time\n"
        "signal.signal(signal.SIGHUP, signal.SIG_IGN)\n"
        "signal.signal(signal.SIGINT, signal.SIG_IGN)\n"
        "signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
        f"pathlib.Path({str(descendant_ready)!r}).write_text(str(os.getpid()))\n"
        "time.sleep(60)\n",
        encoding="utf-8",
    )
    processes: Any = None
    interrupted = False
    try:
        with ProfileTerminationSignalGuard() as termination_guard:
            processes = OwnedProcesses(termination_guard)
            worker = processes.start(
                [
                    "/bin/sh",
                    "-c",
                    '"$1" "$2" &',
                    "system-blur-signal-wrapper",
                    sys.executable,
                    str(stubborn_script),
                ],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            deadline = time.monotonic() + 5
            while time.monotonic() < deadline and not descendant_ready.is_file():
                time.sleep(0.05)
            if not descendant_ready.is_file():
                return 3
            (directory / "ready").write_text(str(worker.pid), encoding="utf-8")
            try:
                while True:
                    time.sleep(1)
            except ProfileError:
                interrupted = True
            finally:
                processes.close()
                processes = None
    finally:
        if processes is not None:
            processes.close()
    if not interrupted:
        return 2
    (directory / "cleaned").write_text("cleaned\n", encoding="utf-8")
    return 0


def self_test_real_signal_cleanup() -> None:
    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        with tempfile.TemporaryDirectory(
            prefix=f"system-blur-signal-{signal.Signals(signum).name.lower()}-",
            dir=REPOSITORY_ROOT / ".tmp",
        ) as raw_directory:
            directory = Path(raw_directory)
            child = subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve()), f"--signal-cleanup-child={directory}"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                start_new_session=True,
            )
            worker_pid: int | None = None
            descendant_pid: int | None = None
            try:
                deadline = time.monotonic() + 10
                ready = directory / "ready"
                while time.monotonic() < deadline:
                    if child.poll() is not None:
                        stdout, stderr = child.communicate()
                        fail(
                            f"real-signal child exited before readiness for "
                            f"{signal.Signals(signum).name}: {stderr or stdout}"
                        )
                    if ready.is_file():
                        worker_pid = int(ready.read_text(encoding="utf-8"))
                        descendant_pid = int(
                            (directory / "descendant-ready").read_text(encoding="utf-8")
                        )
                        break
                    time.sleep(0.05)
                if worker_pid is None:
                    fail(f"real-signal child did not become ready for {signal.Signals(signum).name}")
                os.kill(child.pid, signum)
                stdout, stderr = child.communicate(timeout=12)
                if child.returncode != 0 or not (directory / "cleaned").is_file():
                    fail(
                        f"real {signal.Signals(signum).name} cleanup failed: "
                        f"{stderr or stdout or child.returncode}"
                    )
                try:
                    os.killpg(worker_pid, 0)
                except ProcessLookupError:
                    pass
                else:
                    fail(
                        f"real {signal.Signals(signum).name} cleanup left a stubborn "
                        "descendant process group alive"
                    )
                if descendant_pid is None:
                    fail("real-signal cleanup did not record the stubborn descendant")
                try:
                    os.kill(descendant_pid, 0)
                except ProcessLookupError:
                    pass
                else:
                    fail(
                        f"real {signal.Signals(signum).name} cleanup left stubborn "
                        f"descendant PID {descendant_pid} alive"
                    )
            finally:
                if child.poll() is None:
                    PROCESS_SUPPORT["terminate"](child, process_group_id=child.pid)
                if worker_pid is not None:
                    try:
                        os.killpg(worker_pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                if descendant_pid is not None:
                    try:
                        os.kill(descendant_pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass


def self_test() -> None:
    with tempfile.TemporaryDirectory(
        prefix="system-blur-oracle-self-test-", dir=REPOSITORY_ROOT / ".tmp"
    ) as raw_work:
        helper = Path(raw_work) / "system-blur-composition-oracle"
        compile_fixture(helper)
        run([str(helper), "self-test"], "metric and no-blur negative self-test")
    PROCESS_SUPPORT["self_test_termination_signal_guard"]()
    PROCESS_SUPPORT["self_test_owned_process_cleanup"]()
    self_test_real_signal_cleanup()
    self_test_preferences()
    self_test_cleanup_aggregation()
    self_test_control_path_and_advertisement()
    self_test_http_and_override_validation()
    self_test_oracle_source_identity()


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--app", type=Path)
    parser.add_argument(
        "--artifacts",
        type=Path,
        default=REPOSITORY_ROOT / ".artifacts/transparency/system-blur-composition",
    )
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--signal-cleanup-child", type=Path, help=argparse.SUPPRESS)
    arguments = parser.parse_args()
    if arguments.signal_cleanup_child is not None:
        if arguments.self_test or arguments.app is not None:
            parser.error("--signal-cleanup-child cannot be combined with other modes")
        return arguments
    if not arguments.self_test and arguments.app is None:
        parser.error("--app is required unless --self-test is used")
    return arguments


def main() -> int:
    arguments = parse_arguments()
    try:
        (REPOSITORY_ROOT / ".tmp").mkdir(exist_ok=True)
        if arguments.signal_cleanup_child is not None:
            return run_signal_cleanup_child(arguments.signal_cleanup_child)
        if arguments.self_test:
            self_test()
            print("verify-system-blur-composition: self-test passed")
        else:
            with ProfileTerminationSignalGuard() as termination_guard:
                verify(arguments.app.resolve(), arguments.artifacts.resolve(), termination_guard)
        return 0
    except (OracleError, ProfileError, ValueError) as error:
        print(f"verify-system-blur-composition: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
