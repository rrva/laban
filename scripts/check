#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

fail() {
  printf 'check failed: %s\n' "$1" >&2
  exit 1
}

command -v jq >/dev/null 2>&1 || fail "jq is required to validate JSON"

# Content-hash memoization (scripts/check-memo): a heavy stage whose declared
# inputs are byte-identical to its last passing run is skipped. Guarantees are
# unchanged; only re-proving identical bytes is elided. The input lists below
# are deliberately over-inclusive (a too-narrow list could skip a stage that
# should rerun; a too-wide one only loses cache hits). LABAN_CHECK_NO_MEMO=1
# forces every stage to run. Known limitation: stages that self-skip when a
# tool is absent (cbmc, TLA+) stamp that skip as a pass, so after installing
# such a tool run once with LABAN_CHECK_NO_MEMO=1.
memo=./scripts/check-memo
swift_inputs="-i Sources -i Tests -i Package.swift -i Package.resolved"
labpty_inputs="-i Sources/Labpty -i Sources/LabanTerminalCore -i proofs -i specs"

# One batched jq invocation is far cheaper than one process per file. On
# failure, fall back to a per-file pass so the error output still names
# every invalid file instead of just the first one jq stopped at.
if ! find schemas fixtures -name '*.json' -print0 | xargs -0 jq empty; then
  find schemas fixtures -name '*.json' -print0 | xargs -0 -n1 jq empty
  fail "invalid JSON found"
fi

agents_lines=$(wc -l < AGENTS.md | tr -d ' ')
if [ "$agents_lines" -gt 150 ]; then
  fail "AGENTS.md should stay map-sized; found ${agents_lines} lines"
fi

if [ -d execplans/active ]; then
  for plan in execplans/active/*.md; do
    [ -e "$plan" ] || continue
    case "$plan" in
      */README.md) continue ;;
    esac
    grep -q '^## Progress$' "$plan" || fail "$plan missing Progress section"
    grep -q '^## Validation and Acceptance$' "$plan" || fail "$plan missing Validation and Acceptance section"
  done
fi

git diff --check
./scripts/check-boundaries
./scripts/check-docs
./scripts/check-debug-contract
./scripts/test-build-app-bundle-identifier
# Regenerate the /debug discovery doc from the shared catalogs and gate it:
# fails on a drifted committed doc, a route referencing a missing schema, or an
# ill-formed IntentCatalog (duplicate ids, fixture op gui-available, route-aware
# input/output schema gaps).
$memo controlgen -i Sources -i schemas -i Package.swift -i Package.resolved -- swift run LabanControlGen --check
./scripts/check-fd-hygiene
# Verify the labpty formal layer is fully anchored and wired before running
# it: dangling spec/proof anchors and unwired checks fail here.
./scripts/check-anchors

# TLA+ model-checker run. Skipped when tla2tools.jar is absent so the
# script stays usable on dev machines without the TLA+ Toolbox; CI sets
# TLA_JAR explicitly, so a missing jar there is a hard failure.
if [ -f "${TLA_JAR:-/Applications/TLA+ Toolbox.app/Contents/Eclipse/tla2tools.jar}" ]; then
  # shellcheck disable=SC2086
  $memo specs $labpty_inputs -i scripts/check-specs -i scripts/gen-control-tla.py -i scripts/gen-reuse-tla.py -i scripts/gen-trace-tla.py -- ./scripts/check-specs
else
  printf 'check: skipping check-specs (tla2tools.jar not found; install TLA+ Toolbox)\n'
fi

# CBMC bounded model checking of the labpty wire-format decoders. Runs
# the proofs when cbmc is installed; otherwise degrades to a compile-only
# drift smoke (see scripts/check-cbmc), so it is safe to call always.
$memo cbmc $labpty_inputs -i scripts/check-cbmc -- ./scripts/check-cbmc

# CBMC contract proofs (DFCC): prove the loop-free decoders memory-safe
# UNBOUNDED — for every input length, not just up to the check-cbmc bound.
# Self-skips when cbmc/goto-cc are absent.
$memo cbmc-contracts $labpty_inputs -i scripts/check-cbmc-contracts -- ./scripts/check-cbmc-contracts

# Runtime trace conformance: drive the daemon's real attachment code, capture
# the transitions it emits, and replay them through LabptyAttachment.tla with
# TLC — binding "// Modelled by" to a checked fact. Self-skips to a compile-only
# drift smoke when the TLA+ jar is absent (CI sets TLA_JAR).
$memo trace $labpty_inputs -i scripts/check-trace -- ./scripts/check-trace

# Model coverage — the inverse of check-trace: assert the fuzzed seeds actually
# exercise every model action, so a binding can't pass vacuously on a transition
# nobody reaches. Fast (C runs + counting, no solver); no TLA+ jar needed.
$memo model-coverage $labpty_inputs -i scripts/check-model-coverage -- ./scripts/check-model-coverage

# Replay the labpty fuzz seed corpus through the decoders under
# ASan/UBSan — the deterministic, engine-independent form of
# scripts/fuzz-labpty. A real fuzzing campaign is a manual/CI step:
# `scripts/fuzz-labpty [seconds]`.
$memo fuzz $labpty_inputs -i scripts/fuzz-labpty -- ./scripts/fuzz-labpty --check
# Same replay under MemorySanitizer (uninitialized reads). MSan is
# Linux-only, so this self-skips on macOS and runs in Linux CI.
$memo fuzz-msan $labpty_inputs -i scripts/fuzz-labpty -- ./scripts/fuzz-labpty --check-msan

if [ -f Package.swift ]; then
  $memo lint $swift_inputs -i .swift-format -i scripts/lint -- ./scripts/lint
  ./scripts/fetch-libghostty-vt
  ./scripts/check-dependencies
  swift build
  $memo test-split $swift_inputs -i fixtures -i schemas -i scripts/test-split -- ./scripts/test-split

  # Each heavy stage now builds in its own SwiftPM scratch directory
  # (.build-coverage, .build-asan, .build-smoke, .build-e2e), so they no
  # longer contend on the shared .build graph or contaminate each other's
  # instrumentation/debug flags. They remain sequential here because running
  # all four concurrently overloaded the execution machine and produced
  # timing flakes in unrelated tests; see the Decision Log in
  # execplans/active/parallel-test-safety-and-overlapped-check-stages.md.
  if [ -f "$(cc -print-resource-dir)/lib/darwin/libclang_rt.profile_osx.a" ]; then
    $memo coverage-labpty $swift_inputs -i proofs -i scripts/coverage-labpty -- ./scripts/coverage-labpty --check 45
  else
    printf 'check: skipping coverage-labpty (darwin profile runtime not found)\n'
  fi
  $memo sanitize $swift_inputs -i scripts/check-sanitize -- ./scripts/check-sanitize
  $memo smoke-runtime $swift_inputs -i fixtures -i schemas -i scripts -- ./scripts/smoke-runtime
  $memo test-e2e $swift_inputs -i fixtures -i schemas -i scripts -- ./scripts/test-e2e
fi

printf 'check passed\n'
