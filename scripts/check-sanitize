#!/usr/bin/env sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"
./scripts/fetch-libghostty-vt
# One sanitizer build and test-run invocation covers both suites. Separate
# invocations rebuild sanitizer artifacts and re-launch the test runner even
# though the targets share the same package graph.
swift test --sanitize address --filter 'LabanTerminalCoreTests|LabptyTests'
