#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

mode="both"
if [ "${1:-}" = "--mode" ]; then
  mode="${2:-both}"
  shift 2
elif [ "${1:-}" != "" ] && [ "${1#--mode=}" != "$1" ]; then
  mode="${1#--mode=}"
  shift
fi

[ "${1:-}" != "" ] || {
  printf 'usage: ./scripts/replay-capture [--mode=terminal|renderer|both] <capture-dir>\n' >&2
  exit 2
}

capture="$1"
swift build --product laban-agent >/dev/null
.build/debug/laban-agent --replay-capture="$capture" --replay-mode="$mode"
