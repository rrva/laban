#!/usr/bin/env sh
# Split the full XCTest suite into a parallel-safe group (no UserDefaults.standard
# or NSApplication.shared mutation) and a sequential group (the rest).
# See execplans/active/faster-check-heavy-stages.md Milestone 4.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

# Targets that only touch per-test mutable state (UUID/pid-scoped temp dirs and
# UserDefaults suites, env vars in separate worker processes). Safe to run
# concurrently as separate worker processes under `swift test --parallel`.
#
# LabanRendererTests joined this group on 2026-07-26: its suites no longer
# persist anything to the shared preferences domain. Settings the renderer reads
# from `UserDefaults.standard` are now supplied through the per-process
# registration domain, which never reaches disk, and every private suite name is
# pid-scoped. Verified by 3 consecutive `--parallel` runs plus a clean
# `com.apple.dt.xctest.tool` domain afterwards. See
# `execplans/active/test-userdefaults-isolation.md`.
parallel_safe='LabandTests|LabptyTests|LabanAgentTests|LabanCLITests|LabanTerminalCoreTests'
parallel_safe="${parallel_safe}|LabanRendererTests"

# Held out of the parallel shard for a reason unrelated to shared state:
# these first-frame settling tests fail with "settling frame N failed", i.e.
# `render()` returning false, when many test processes drive Metal at once. It
# is GPU resource contention, not contamination, so isolating defaults cannot
# fix it. Runs serially in its own shard instead.
gpu_serial='VectorGlyphParityTests'

# Targets that either write overlapping UserDefaults.standard keys, touch
# NSApplication.shared, or bind a fixed control socket path. Keep them in one
# sequential, non-parallel invocation so cross-test contamination stays
# reproducible and debuggable.
sequential='LabanCoreTests|LabanDebugTests|LabanAppTests|LabanControlTests'

run_shard() {
  label=$1
  shift
  if swift test "$@"; then
    printf 'test-split: %s shard passed\n' "$label"
  else
    status=$?
    printf 'test-split: %s shard failed (exit %s): swift test' "$label" "$status" >&2
    for argument in "$@"; do
      printf ' %s' "$argument" >&2
    done
    printf '\n' >&2
    return "$status"
  fi
}

run_shard parallel-safe --parallel --filter "$parallel_safe" --skip "$gpu_serial"
run_shard sequential --filter "$sequential"
run_shard gpu-serial --filter "$gpu_serial"
