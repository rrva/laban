#!/usr/bin/env bash
set -euo pipefail

FIXTURE="${1:-fixtures/colored-boxes.fixture.json}"
RUN_ID="${LABAN_RUN_ID:-manual-headless-$(date +%Y%m%d-%H%M%S)-$$}"
ARTIFACTS="${LABAN_ARTIFACTS:-.artifacts/runs/$RUN_ID}"
TMP="${LABAN_TMP:-.tmp/$RUN_ID}"

swift run laban-agent -- \
  --headless \
  --fixture="$FIXTURE" \
  --artifacts="$ARTIFACTS" \
  --temp-dir="$TMP" \
  --deterministic

echo ""
echo "Artifacts: $ARTIFACTS"
echo "Screenshot: $ARTIFACTS/screenshot.png"
echo "Result:    $ARTIFACTS/result.json"
