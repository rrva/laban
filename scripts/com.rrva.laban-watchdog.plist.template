<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent template for the external sampler watchdog.

  This file contains a `__LABAN_REPO__` placeholder for the absolute path to
  this checkout. LaunchAgents require absolute paths, so the template must be
  expanded before installation.

  Install (from the repository root):
    sed "s|__LABAN_REPO__|$(pwd)|g" scripts/com.rrva.laban-watchdog.plist.template \
      > ~/Library/LaunchAgents/com.rrva.laban-watchdog.plist
    launchctl load -w ~/Library/LaunchAgents/com.rrva.laban-watchdog.plist

  Stop:
    launchctl unload -w ~/Library/LaunchAgents/com.rrva.laban-watchdog.plist

  Logs land at /tmp/laban-watchdog.{out,err}; samples at ~/laban-watchdog/.
  When Laban isn't running, the script idles cheaply (one pgrep per interval).
  By default only the Laban app process is sampled. Set
  LABAN_WATCHDOG_DESCENDANTS=1 for targeted child-process sweeps.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rrva.laban-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>__LABAN_REPO__/scripts/laban-watchdog</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/laban-watchdog.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/laban-watchdog.err</string>
</dict>
</plist>
