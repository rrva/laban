#!/usr/bin/env sh
# Runtime smoke checks: agent output, plist validity, binary permissions, AppKit startup.
# Builds its own artifacts so it is safe to run standalone from a clean state.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

fail() {
  printf 'smoke-runtime failed: %s\n' "$1" >&2
  exit 1
}

swift build --product LabanApp --product laban-agent
./scripts/build-app

AGENT_BIN=".build/debug/laban-agent"
APP_BIN=".build/laban/Laban.app/Contents/MacOS/LabanApp"
PLIST=".build/laban/Laban.app/Contents/Info.plist"
EXPECTED_APP="laban-app: smoke ok"
AGENT_ARTIFACTS=".artifacts/runs/smoke-runtime"
AGENT_TMP=".tmp/smoke-runtime"

# 1. Headless fixture run: exits 0, produces screenshot, finds expected text.
rm -rf "$AGENT_ARTIFACTS" "$AGENT_TMP"
"$AGENT_BIN" --headless \
  --fixture=fixtures/colored-boxes.fixture.json \
  --artifacts="$AGENT_ARTIFACTS" \
  --temp-dir="$AGENT_TMP" \
  --deterministic || fail "laban-agent exited non-zero"
[ -f "$AGENT_ARTIFACTS/screenshot.png" ] || fail "laban-agent did not produce screenshot.png"
[ -s "$AGENT_ARTIFACTS/screenshot.png" ] || fail "laban-agent screenshot.png is empty"
found=$(jq -r '.foundExpectedText // "missing"' "$AGENT_ARTIFACTS/result.json" 2>/dev/null)
[ "$found" = "true" ] || fail "laban-agent foundExpectedText is not true (got: $found)"
rm -rf "$AGENT_ARTIFACTS" "$AGENT_TMP"

# 2. Info.plist validity
plutil -lint "$PLIST" || fail "Info.plist lint failed"

# 3. Binary executable bit (belt-and-suspenders)
[ -x "$APP_BIN" ] || fail "$APP_BIN is not executable"

# 4. AppKit smoke startup: print stable line and exit 0 without entering run loop.
# Background watchdog kills the process after 10s to guard against hang regression.
_tmp=$(mktemp)
LABAN_SMOKE=1 "$APP_BIN" >"$_tmp" &
_pid=$!
( sleep 10 && kill "$_pid" 2>/dev/null ) &
_watchdog=$!
wait "$_pid" && _status=0 || _status=$?
kill "$_watchdog" 2>/dev/null || true
wait "$_watchdog" 2>/dev/null || true
actual_app=$(cat "$_tmp")
rm -f "$_tmp"
[ "$_status" -eq 0 ] || fail "LabanApp smoke startup failed (exit $_status)"
[ "$actual_app" = "$EXPECTED_APP" ] || fail "LabanApp smoke output mismatch
  expected: ${EXPECTED_APP}
  got:      ${actual_app}"

printf 'smoke-runtime passed\n'
