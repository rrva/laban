#!/usr/bin/env sh
# MC/DC (Modified Condition/Decision Coverage) of the labpty DAEMON as
# exercised by the real LabptyTests integration suite. MC/DC is the exacting
# metric — it asks whether each boolean condition was shown to independently
# flip a decision — and it stays low even when line coverage looks healthy.
# CBMC already proves the decoders exhaustively, so the number that matters
# here is the UN-PROVEN daemon code (main.c handlers, registry, dispatch).
#
# Usage:
#   scripts/coverage-labpty            build instrumented, run tests, print
#                                      the MC/DC report
#   scripts/coverage-labpty --check N  same, but exit non-zero if the daemon
#                                      MC/DC%% has regressed below N (a ratchet:
#                                      coverage may only go up). CI floor.
#
# Apple clang 21 + xcrun llvm-cov both do MC/DC natively, so this is a single
# matched toolchain. The daemon is SIGKILLed at test teardown, which skips the
# normal profile flush, so it is built with -fprofile-continuous (counters are
# page-aligned and synced live, surviving the kill).
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

floor=""
case "${1:-}" in
  --check) floor=${2:?"--check needs a floor percentage"} ;;
  "") : ;;
  *) printf 'coverage-labpty: unknown argument %s\n' "$1" >&2; exit 2 ;;
esac

prof="$(cc -print-resource-dir)/lib/darwin/libclang_rt.profile_osx.a"
if [ ! -f "$prof" ]; then
  printf 'coverage-labpty: profile runtime not found at %s\n' "$prof" >&2
  exit 1
fi

covdir=$(mktemp -d)
trap 'rm -rf "$covdir"' EXIT

printf 'coverage-labpty: building test binary + MC/DC-instrumented daemon\n'
swift build --build-tests >/dev/null 2>&1
# Instrument the daemon LAST so --skip-build runs the tests against it. The
# next ordinary build restores an un-instrumented binary, so the normal build
# is never contaminated.
swift build --product labpty \
  -Xcc -fprofile-instr-generate -Xcc -fcoverage-mapping -Xcc -fcoverage-mcdc \
  -Xcc -fprofile-continuous -Xlinker "$prof" >/dev/null 2>&1

printf 'coverage-labpty: running LabptyTests against the instrumented daemon\n'
LLVM_PROFILE_FILE="$covdir/labpty-%p.profraw" \
  swift test --skip-build --filter LabptyTests >/dev/null 2>&1 || true
n=$(ls "$covdir"/labpty-*.profraw 2>/dev/null | wc -l | tr -d ' ')
if [ "$n" = 0 ]; then
  printf 'coverage-labpty: no profile data collected (daemon not instrumented?)\n' >&2
  exit 1
fi

# Deterministic decision-function harnesses (proofs/labpty/coverage) drive the
# MC/DC condition vectors the timing-dependent integration suite cannot reach
# — NULL ids, dead-child states, buffer overflow. They #include the daemon .c
# under test, so their profile merges with the integration profile and the
# reported number is the UNION of integration + unit coverage.
printf 'coverage-labpty: running deterministic decision-function harnesses\n'
cov_inc="-I Sources/Labpty -I Sources/Labpty/include -I Sources/LabanTerminalCore/include"
# shellcheck disable=SC2086
cc -O0 -fprofile-instr-generate -fcoverage-mapping -fcoverage-mcdc $cov_inc \
   proofs/labpty/coverage/registry_cov.c Sources/Labpty/labpty_byte_ring.c \
   -o "$covdir/registry_cov"
# shellcheck disable=SC2086
cc -O0 -fprofile-instr-generate -fcoverage-mapping -fcoverage-mcdc $cov_inc \
   proofs/labpty/coverage/main_cov.c Sources/Labpty/labpty_frame.c \
   Sources/Labpty/labpty_protocol.c Sources/Labpty/labpty_registry.c \
   Sources/Labpty/labpty_byte_ring.c -o "$covdir/main_cov"
# signal_cov asserts handle_signal's client-controlled signal validation (L9):
# an out-of-range signo never reaches killpg/kill. It macro-stubs the syscalls,
# so its assertions are a regression gate as well as MC/DC for handle_signal.
# shellcheck disable=SC2086
cc -O0 -fprofile-instr-generate -fcoverage-mapping -fcoverage-mcdc $cov_inc \
   proofs/labpty/coverage/signal_cov.c Sources/Labpty/labpty_frame.c \
   Sources/Labpty/labpty_protocol.c Sources/Labpty/labpty_registry.c \
   Sources/Labpty/labpty_byte_ring.c -o "$covdir/signal_cov"
# poll_cov asserts the event loop's poll-multiplexing invariant: build_poll_set
# emits a poll set whose every slot's (fd, kind, index) is consistent, and
# service_poll_watch routes a slot to the handler at THAT index — a regression
# gate as well as MC/DC for build_poll_set/service_poll_watch.
# shellcheck disable=SC2086
cc -O0 -fprofile-instr-generate -fcoverage-mapping -fcoverage-mcdc $cov_inc \
   proofs/labpty/coverage/poll_cov.c Sources/Labpty/labpty_frame.c \
   Sources/Labpty/labpty_protocol.c Sources/Labpty/labpty_registry.c \
   Sources/Labpty/labpty_byte_ring.c -o "$covdir/poll_cov"
LLVM_PROFILE_FILE="$covdir/registry_cov.profraw" "$covdir/registry_cov"
LLVM_PROFILE_FILE="$covdir/main_cov.profraw" "$covdir/main_cov" 2>/dev/null
LLVM_PROFILE_FILE="$covdir/signal_cov.profraw" "$covdir/signal_cov"
LLVM_PROFILE_FILE="$covdir/poll_cov.profraw" "$covdir/poll_cov"

xcrun llvm-profdata merge -sparse "$covdir"/labpty-*.profraw \
  "$covdir/registry_cov.profraw" "$covdir/main_cov.profraw" \
  "$covdir/signal_cov.profraw" "$covdir/poll_cov.profraw" -o "$covdir/labpty.profdata"

daemon="Sources/Labpty/main.c Sources/Labpty/labpty_registry.c"
objects="-object $covdir/registry_cov -object $covdir/main_cov -object $covdir/signal_cov -object $covdir/poll_cov"
printf 'coverage-labpty: MC/DC over the un-proven daemon code (%s integration profiles + harnesses)\n' "$n"
# shellcheck disable=SC2086
xcrun llvm-cov report .build/debug/labpty $objects -instr-profile="$covdir/labpty.profdata" \
  --show-mcdc-summary $daemon

# The last column of the TOTAL row is the MC/DC percentage.
# shellcheck disable=SC2086
mcdc=$(xcrun llvm-cov report .build/debug/labpty $objects -instr-profile="$covdir/labpty.profdata" \
  --show-mcdc-summary $daemon | awk '/^TOTAL/ {gsub(/%/,"",$NF); print $NF}')
printf 'coverage-labpty: daemon MC/DC = %s%%\n' "$mcdc"

if [ -n "$floor" ]; then
  # Ratchet: coverage may only go up. Regression if mcdc < floor.
  if awk "BEGIN{exit !($mcdc < $floor)}"; then
    printf 'coverage-labpty: REGRESSION — daemon MC/DC %s%% is below the %s%% floor\n' "$mcdc" "$floor" >&2
    exit 1
  fi
  printf 'coverage-labpty: daemon MC/DC %s%% holds the %s%% floor\n' "$mcdc" "$floor"
fi
