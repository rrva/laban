{
  "name": "debug-script-split-pane",
  "description": "Two real shells render independently; closing a pane keeps the survivor alive.",
  "deterministic": false,
  "steps": [
    {
      "op": "action",
      "label": "left",
      "body": {
        "action": "newTab"
      }
    },
    {
      "op": "action",
      "label": "right",
      "body": {
        "action": "pane.split"
      }
    },
    {
      "op": "action",
      "body": {
        "action": "pane.focus",
        "direction": "previous"
      },
      "expectJson": [
        {
          "path": "activeSessionId",
          "equals": "$steps.left.activeSessionId"
        }
      ]
    },
    {
      "op": "action",
      "body": {
        "action": "typeText",
        "text": "printf '\\114\\105\\106\\124\\n'\n"
      }
    },
    {
      "op": "wait",
      "condition": {
        "kind": "textVisible",
        "sessionId": "$steps.left.activeSessionId",
        "text": "LEFT"
      }
    },
    {
      "op": "action",
      "body": {
        "action": "pane.focus",
        "direction": "next"
      },
      "expectJson": [
        {
          "path": "activeSessionId",
          "equals": "$steps.right.activeSessionId"
        }
      ]
    },
    {
      "op": "action",
      "body": {
        "action": "typeText",
        "text": "printf '\\122\\111\\107\\110\\124\\n'\n"
      }
    },
    {
      "op": "wait",
      "condition": {
        "kind": "textVisible",
        "sessionId": "$steps.right.activeSessionId",
        "text": "RIGHT"
      }
    },
    {
      "op": "screenshot",
      "label": "two-live-panes"
    },
    {
      "op": "get",
      "path": "/debug/state",
      "expectJson": [
        {
          "path": "tabs[1].panes.split.axis",
          "equals": "vertical"
        }
      ]
    },
    {
      "op": "action",
      "body": {
        "action": "pane.close",
        "sessionId": "$steps.left.activeSessionId"
      }
    },
    {
      "op": "get",
      "path": "/debug/state",
      "saveAs": "survivor-state.json",
      "expectJson": [
        {
          "path": "tabs[1].focusedSessionId",
          "equals": "$steps.right.activeSessionId"
        },
        {
          "path": "tabs[1].panes.leaf.sessionId",
          "equalsPath": "tabs[1].focusedSessionId"
        },
        {
          "path": "tabs[1].focusedSessionId",
          "notEqualsPath": "tabs[1].id"
        }
      ]
    },
    {
      "op": "action",
      "body": {
        "action": "typeText",
        "text": "printf '\\123\\125\\122\\126\\111\\126\\117\\122\\n'\n"
      }
    },
    {
      "op": "wait",
      "condition": {
        "kind": "textVisible",
        "sessionId": "$steps.right.activeSessionId",
        "text": "SURVIVOR"
      }
    }
  ]
}
