{
  "name": "spinner-motion-wave",
  "description": "Traveling-wave super-sampling end-to-end: a gray band shifting one cell per ~75 ms engages the wave estimator (waveActive, ~13.3 cells/s), a mid-interval frame renders a cell color strictly between adjacent source step levels (sub-cell sampling), and after the steps stop the wave disengages, settles pixel-identical to a static reference row, and the effect channel re-parks. Requires slugGlyph and --deterministic.",
  "fixture": "fixtures/spinner-motion-wave.fixture.json",
  "renderer": "slugGlyph",
  "deterministic": true,
  "steps": [
    {
      "op": "discover",
      "expectEndpoints": [
        "POST /debug/actions",
        "POST /debug/pixel-probe",
        "GET /debug/spinner-motion"
      ],
      "expectActions": [
        "feedOutput",
        "advanceTime",
        "advanceFrames",
        "setGlyphEffectsEnabled",
        "setSpinnerMotionSmoothingEnabled"
      ]
    },
    {
      "op": "action",
      "label": "enable spinner motion smoothing",
      "body": {
        "action": "setSpinnerMotionSmoothingEnabled",
        "enabled": true
      }
    },
    {
      "op": "action",
      "label": "disable glyph effects so ink-bloom decay cannot leak into settle telemetry",
      "body": {
        "action": "setGlyphEffectsEnabled",
        "enabled": false
      }
    },
    {
      "op": "get",
      "label": "enabled, no wave yet",
      "path": "/debug/spinner-motion",
      "expectJson": [
        {
          "path": "configured",
          "equals": true
        },
        {
          "path": "effectiveEnabled",
          "equals": true
        },
        {
          "path": "waveActive",
          "equals": false
        }
      ]
    },
    {
      "op": "action",
      "label": "wave step 1 (pos 3)",
      "body": {
        "action": "feedOutput",
        "text": "\u001b[1;3H\u001b[38;2;231;231;231m\u25cf\u001b[38;2;242;242;242m\u25cf\u001b[38;2;231;231;231m\u25cf\u001b[38;2;203;203;203m\u25cf\u001b[38;2;167;167;167m\u25cf\u001b[38;2;139;139;139m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf\u001b[38;2;128;128;128m\u25cf"
