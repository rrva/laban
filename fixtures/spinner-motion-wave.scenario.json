      "path": "/debug/spinner-motion",
      "expectJson": [
        {
          "path": "waveActive",
          "equals": false
        },
        {
          "path": "activeTransitions",
          "equals": 0
        },
        {
          "path": "remainingSeconds",
          "equals": 0
        }
      ]
    },
