    },
    {
      "op": "post",
      "label": "mid-interval: wave cell renders strictly between adjacent source levels",
      "path": "/debug/pixel-probe",
      "body": {
        "regions": [
          {
            "name": "wave",
            "x": 319,
            "y": 439,
            "width": 4,
            "height": 15
          },
          {
            "name": "ref-low",
            "x": 310,
            "y": 420,
            "width": 4,
            "height": 15
          },
          {
            "name": "ref-high",
            "x": 319,
            "y": 420,
            "width": 4,
            "height": 15
          }
        ]
      },
      "expectJson": [
        {
          "path": "regions[0].nonBackgroundPixels",
          "greaterThan": 0
        },
        {
          "path": "regions[0].averageRgba[0]",
          "greaterThanPath": "regions[1].averageRgba[0]"
        },
        {
          "path": "regions[0].averageRgba[0]",
          "lessThanPath": "regions[2].averageRgba[0]"
        }
      ],
      "saveAs": "probe-mid-interval.json"
    },
    {
      "op": "action",
      "label": "idle past detector timeout and teardown duration",
      "body": {
        "action": "advanceTime",
        "ms": 800
      }
    },
    {
      "op": "action",
      "label": "settle repaints",
      "body": {
        "action": "advanceFrames",
        "count": 3
      }
    },
    {
      "op": "post",
      "label": "settled: wave row is pixel-identical to the static reference row",
      "path": "/debug/pixel-probe",
      "body": {
        "regions": [
          {
            "name": "wave",
            "x": 319,
            "y": 439,
            "width": 4,
            "height": 15
          },
          {
            "name": "reference",
            "x": 319,
            "y": 420,
            "width": 4,
            "height": 15
          }
        ]
      },
      "expectJson": [
        {
          "path": "regions[0].averageRgba",
          "equalsPath": "regions[1].averageRgba"
        },
        {
          "path": "regions[0].nonBackgroundPixels",
          "equalsPath": "regions[1].nonBackgroundPixels"
        }
      ],
      "saveAs": "probe-settled.json"
    },
    {
      "op": "get",
      "label": "parked after settlement",
      "path": "/debug/spinner-motion",
      "expectJson": [
        {
          "path": "waveActive",
          "equals": false
        },
        {
          "path": "activeTransitions",
          "equals": 0
        },
        {
          "path": "analyticMotionInstances",
          "equals": 0
        },
        {
          "path": "remainingSeconds",
          "equals": 0
        },
        {
          "path": "liveEffectFrames",
          "greaterThan": 0
        }
      ],
      "saveAs": "state-settled.json"
    },
    {
      "op": "action",
      "label": "idle re-renders stay parked",
      "body": {
        "action": "advanceFrames",
        "count": 3
      }
    },
    {
      "op": "get",
