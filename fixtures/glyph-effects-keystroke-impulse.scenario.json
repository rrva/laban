{
  "name": "glyph-effects-keystroke-impulse",
  "description": "Keystroke-impulse type-in (pivot from ink-bloom): a freshly output glyph arrives horizontally compressed, slightly tall and tilted, then springs into place over 130 ms of virtual time (easeOutBack, one overshoot). First-frame assertions are pose-agnostic bounded inequalities (no age-0 pose assumptions): the transformed row must cover fewer pixels than the settled control but still render. Settled frames must be pixel-identical to the never-restamped control row — including the gap rows around it, so residual transform spill (scaleY 1.10, 4° tilt, 4.5% width overshoot) cannot leave trails. Requires slugGlyph (the effect is evaluated in the Slug vertex shader) and --deterministic (virtual clock).",
  "fixture": "fixtures/glyph-effects-keystroke-impulse.fixture.json",
  "renderer": "slugGlyph",
  "deterministic": true,
  "steps": [
    {
      "op": "discover",
      "expectEndpoints": [
        "POST /debug/actions",
        "POST /debug/pixel-probe",
        "GET /debug/state"
      ],
      "expectActions": ["feedOutput", "advanceFrames", "advanceTime", "setGlyphEffectsEnabled"]
    },
    {
      "op": "action",
      "label": "enable glyph effects",
      "body": {"action": "setGlyphEffectsEnabled", "enabled": true}
    },
    {
      "op": "action",
      "label": "settle initial fixture rows past the stamping window",
      "body": {"action": "advanceTime", "ms": 300}
    },
    {
      "op": "post",
      "label": "baseline probe: control settled, fresh row + gaps empty",
      "path": "/debug/pixel-probe",
      "body": {
        "regions": [
          {"name": "control", "x": 201, "y": 439, "width": 198, "height": 15},
          {"name": "fresh", "x": 201, "y": 420, "width": 198, "height": 15},
          {"name": "gapAbove", "x": 201, "y": 435, "width": 198, "height": 4},
          {"name": "belowFresh", "x": 201, "y": 401, "width": 198, "height": 19}
        ]
      },
      "expectJson": [
        {"path": "regions[0].nonBackgroundPixels", "greaterThan": 0},
        {"path": "regions[1].nonBackgroundPixels", "equals": 0},
        {"path": "regions[2].nonBackgroundPixels", "equals": 0},
        {"path": "regions[3].nonBackgroundPixels", "equals": 0}
      ],
      "saveAs": "probe-baseline.json"
    },
    {
      "op": "action",
      "label": "fresh output on the next row",
      "body": {"action": "feedOutput", "text": "elastic arrival text\r\n"}
    },
    {
      "op": "action",
      "label": "render the first-frame impulse pose",
      "body": {"action": "advanceFrames", "count": 1}
    },
    {
      "op": "post",
      "label": "first frame: transformed row renders but covers less than settled",
      "path": "/debug/pixel-probe",
      "body": {
        "regions": [
          {"name": "control", "x": 201, "y": 439, "width": 198, "height": 15},
          {"name": "fresh", "x": 201, "y": 420, "width": 198, "height": 15}
        ]
      },
      "expectJson": [
        {"path": "regions[1].nonBackgroundPixels", "greaterThan": 0},
        {"path": "regions[1].nonBackgroundPixels", "lessThanPath": "regions[0].nonBackgroundPixels"}
      ],
      "saveAs": "probe-first-frame.json"
    },
    {
      "op": "get",
      "label": "state: impulse live on the first frame",
      "path": "/debug/state",
      "expectJson": [
        {"path": "glyphEffects.active", "equals": true},
        {"path": "glyphEffects.lastKind", "equals": 1},
        {"path": "glyphEffects.liveCount", "greaterThan": 0},
        {"path": "glyphEffects.wakeCount", "greaterThan": 0}
      ],
      "saveAs": "state-first-frame.json"
    },
    {
      "op": "action",
      "label": "advance into mid-impulse (age 40 ms)",
      "body": {"action": "advanceTime", "ms": 40}
    },
    {
      "op": "post",
      "label": "mid-impulse: row still covers less than settled control",
      "path": "/debug/pixel-probe",
      "body": {
        "regions": [
          {"name": "control", "x": 201, "y": 439, "width": 198, "height": 15},
          {"name": "fresh", "x": 201, "y": 420, "width": 198, "height": 15}
        ]
      },
      "expectJson": [
        {"path": "regions[1].nonBackgroundPixels", "lessThanPath": "regions[0].nonBackgroundPixels"}
      ],
      "saveAs": "probe-mid.json"
    },
    {
      "op": "get",
      "label": "state: impulse still live mid-flight",
      "path": "/debug/state",
      "expectJson": [
        {"path": "glyphEffects.active", "equals": true}
      ]
    },
    {
      "op": "action",
      "label": "advance past the 130 ms decay plus settle repaint (age 290 ms)",
      "body": {"action": "advanceTime", "ms": 250}
    },
    {
      "op": "post",
      "label": "settled: fresh row pixel-identical to control, no spill trails in gaps",
      "path": "/debug/pixel-probe",
      "body": {
        "regions": [
          {"name": "control", "x": 201, "y": 439, "width": 198, "height": 15},
          {"name": "fresh", "x": 201, "y": 420, "width": 198, "height": 15},
          {"name": "gapAbove", "x": 201, "y": 435, "width": 198, "height": 4},
          {"name": "belowFresh", "x": 201, "y": 401, "width": 198, "height": 19}
        ]
      },
      "expectJson": [
        {"path": "regions[1].averageRgba", "equalsPath": "regions[0].averageRgba"},
        {"path": "regions[1].nonBackgroundPixels", "equalsPath": "regions[0].nonBackgroundPixels"},
        {"path": "regions[2].nonBackgroundPixels", "equals": 0},
        {"path": "regions[3].nonBackgroundPixels", "equals": 0}
      ],
      "saveAs": "probe-settled.json"
    },
    {
      "op": "get",
      "label": "state: parked after decay",
      "path": "/debug/state",
      "expectJson": [
        {"path": "glyphEffects.active", "equals": false},
        {"path": "glyphEffects.liveCount", "equals": 0}
      ],
      "saveAs": "state-settled.json"
    },
    {
      "op": "action",
      "label": "idle re-renders do not restart the effect",
      "body": {"action": "advanceFrames", "count": 3}
    },
    {
      "op": "post",
      "label": "post-idle: still pixel-identical to control, gaps still clean",
      "path": "/debug/pixel-probe",
      "body": {
        "regions": [
          {"name": "control", "x": 201, "y": 439, "width": 198, "height": 15},
          {"name": "fresh", "x": 201, "y": 420, "width": 198, "height": 15},
          {"name": "gapAbove", "x": 201, "y": 435, "width": 198, "height": 4},
          {"name": "belowFresh", "x": 201, "y": 401, "width": 198, "height": 19}
        ]
      },
      "expectJson": [
        {"path": "regions[1].averageRgba", "equalsPath": "regions[0].averageRgba"},
        {"path": "regions[1].nonBackgroundPixels", "equalsPath": "regions[0].nonBackgroundPixels"},
        {"path": "regions[2].nonBackgroundPixels", "equals": 0},
        {"path": "regions[3].nonBackgroundPixels", "equals": 0}
      ]
    },
    {
      "op": "get",
      "label": "state: still parked after idle re-renders",
      "path": "/debug/state",
      "expectJson": [
        {"path": "glyphEffects.active", "equals": false},
        {"path": "glyphEffects.liveCount", "equals": 0}
      ]
    },
    {
      "op": "screenshot",
      "label": "settled"
    }
  ]
}
